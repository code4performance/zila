(* ===========================================================
   Brasa - formal grammar (EBNF)
   Notation: | alternative   [ ] optional   { } zero or more
             ( ) grouping    'x' literal    (* *) comment
   Blocks end with 'end'. A newline terminates a statement (no ';').
   Newlines are ignored inside ( ), [ ], { } lists and after binary
   operators and '='. A line starting with '.' or '?.' continues the
   previous expression (method chains). Comparisons do not chain.
   A multi-line match arm body runs until the next arm or 'end'.
   Method/field names after '.' may be keywords (app.use(...), the middleware call of 'use web').
   =========================================================== *)


(* ---------- Lexical ---------- *)

letter     = 'a'..'z' | 'A'..'Z' | '_' ;
digit      = '0'..'9' ;
hex        = digit | 'a'..'f' | 'A'..'F' ;
bin        = '0' | '1' ;
ident      = letter { letter | digit } ;

int_lit    = digit { digit | '_' }
           | '0x' hex { hex | '_' }
           | '0b' bin { bin | '_' } ;
float_lit  = digit { digit } '.' digit { digit } [ exp ] ;
exp        = ( 'e' | 'E' ) [ '+' | '-' ] digit { digit } ;
char_lit   = "'" ( char | escape ) "'" ;
text_lit   = '"' { char | escape | '{' expr '}' } '"' ;
bool_lit   = 'true' | 'false' ;
nil_lit    = 'nil' ;
literal    = int_lit | float_lit | char_lit | text_lit | bool_lit | nil_lit ;

comment    = '//' { any } EOL | '/*' { any } '*/' ;

(* Reserved words:
   package use type record enum func return var let
   if else match for in while break continue defer spawn asm end async await
   unsafe extern embed new try and or not true false nil
   bitand bitor bitxor bitnot interface ref self shared spawn_thread pub *)


(* ---------- Program and declarations ---------- *)

file         = package_decl { use_decl } { top_decl } ;
package_decl = 'package' ident ;
use_decl     = 'use' qname { ',' qname } ;
qname        = ident { '.' ident } ;

top_decl      = [ attrs ] ( [ 'pub' ] ( func_decl | type_decl | const_decl
                                  | var_decl | extern_decl )
                          | embed_decl ) ;      (* 'pub' goes before async/comptime/func, type, let/var, extern *)

attrs         = { '#[' ident [ '(' [ args ] ')' ] ']' } ;
const_decl    = 'let' ident [ ':' type ] '=' expr ;
var_decl      = 'var' ident [ ':' type ] [ '=' expr ] ;
embed_decl    = 'embed' text_lit ;
extern_decl   = 'extern' [ text_lit ] 'func' ident '(' [ extern_params ] ')' [ '->' type ] ;
extern_params = param { ',' param } [ ',' '...' ] | '...' ;


(* ---------- Types ---------- *)

type_decl  = 'type' ident [ generics ] '=' type_body ;
type_body  = 'record' { field } 'end'
           | 'enum' { variant } 'end'          (* with or without data *)
           | 'interface' { method_sig } 'end'   (* structural, Go-style *)
           | type ;
method_sig = 'func' ident '(' 'self' [ ',' params ] ')' [ '->' result ] ;
field      = [ 'pub' ] ident ':' type ;
variant    = ident [ '(' type { ',' type } ')' ] [ ',' ] ;   (* Red, Green  or  Circle(int) *)
generics   = '<' tparam { ',' tparam } '>' ;
tparam     = ident [ ':' qname ] ;              (* T: Printable *)

type       = base_type [ '?' ] ;                (* T? = optional value *)
base_type  = qname [ '<' type { ',' type } '>' ]   (* 'Type': a type at compile time, only in comptime code *)
           | 'shared' type                      (* atomic counts, immutable content; see Semantic rules *)
           | '*' type                           (* raw pointer *)
           | '[' ']' type                       (* slice *)
           | '[' int_lit ']' type               (* fixed array *)
           | [ 'extern' [ text_lit ] ] 'func' '(' [ types ] ')' [ '->' result ] ;
types      = type { ',' type } ;
result     = type [ 'or' 'error' ] | 'error' ;  (* T or error = value or failure *)


(* ---------- Functions ---------- *)

func_decl  = [ 'async' | 'comptime' ] 'func' [ receiver ] ident [ generics ] '(' [ params ] ')'
             [ '->' result ] body ;     (* 'async': runs as a task, returns Future<T>;
                                           'comptime': runs at build time and returns source text;
                                           a function with #[generated(gen)] has no body *)
receiver   = '(' [ 'ref' ] ident ':' type ')' ;  (* method; no inheritance; 'ref' receiver is a borrow *)
params     = param { ',' param } ;
param      = [ 'comptime' | 'ref' ] ident ':' [ '...' ] type [ '=' expr ] ;   (* '...' = variadic;
                                           'comptime t: Type' = a type given at compile time *)
lambda_param = [ 'ref' ] ident [ ':' [ '...' ] type ] [ '=' expr ] ;  (* type may be inferred *)
                                                (* ref = passing mode: a temporary borrow of
                                                   the caller's value; it cannot be stored,
                                                   returned, captured or sent to a task.
                                                   Without it, records are copied. *)
body       = { stmt } 'end' ;


(* ---------- Statements ---------- *)

stmt        = var_decl | const_decl | assign | if_stmt | match_stmt
            | for_stmt | while_stmt | return_stmt | defer_stmt
            | spawn_stmt | unsafe_stmt | asm_stmt | block_expr
            | 'break' | 'continue' | expr ;

assign      = place assign_op expr ;
assign_op   = '=' | '+=' | '-=' | '*=' | '/=' | '%=' ;
place       = ident { '.' ident | '[' expr ']' | '^' } ;

if_stmt     = 'if' expr { stmt }
              { 'else' 'if' expr { stmt } }
              [ 'else' { stmt } ] 'end' ;
while_stmt  = 'while' expr { stmt } 'end' ;
for_stmt    = 'for' ident [ ',' ident ] 'in' expr { stmt } 'end' ;
match_stmt  = 'match' expr { pattern '->' ( expr | { stmt } ) } 'end' ;
pattern     = pat_atom { '|' pat_atom } ;       (* '|' only here *)
pat_atom    = '_' | literal | ident [ '(' ident { ',' ident } ')' ] ;
return_stmt = 'return' [ expr ] ;
defer_stmt  = 'defer' expr ;
spawn_stmt  = 'spawn' call ;
unsafe_stmt = 'unsafe' { stmt } 'end' ;
asm_stmt    = 'asm' { text_lit } { asm_operand } [ asm_clobber ] 'end' ;
asm_operand = ( 'in' | 'out' | 'inout' ) ident '=' expr ;
asm_clobber = 'clobber' text_lit { ',' text_lit } ;
call        = postfix ;                         (* must end in call_args *)


(* ---------- Expressions (lowest to highest precedence) ---------- *)

expr       = coalesce ;
coalesce   = or_expr { '??' or_expr } ;
or_expr    = and_expr { 'or' and_expr } ;
and_expr   = cmp_expr { 'and' cmp_expr } ;
cmp_expr   = range_expr [ cmp_op range_expr ] ;
cmp_op     = '==' | '!=' | '<' | '<=' | '>' | '>=' ;
range_expr = add_expr [ '..' add_expr ] ;
add_expr   = mul_expr { ( '+' | '-' | 'bitor' | 'bitxor' ) mul_expr } ;
mul_expr   = unary { ( '*' | '/' | '%' | '<<' | '>>' | 'bitand' ) unary } ;
unary      = ( 'not' | 'bitnot' | '-' | '&' | '*' | 'try' | 'await' | 'shared' ) unary | postfix ;
                                                (* 'await' = wait for a Future<T> and yield T
                                                   (only in an async func or in main) *)
                                                (* 'try' = propagate a failure to the caller
                                                   (only in func -> T or error) *)
                                                (* '&' = address-of only *)
postfix    = primary { '.' ident | '?.' ident | '[' expr ']'
                     | call_args | '^' } ;
                                                (* '^'  = dereference
                                                   '?.' = safe access on T? *)
call_args  = '(' [ args ] ')' ;
args       = arg { ',' arg } ;
arg        = [ '...' ] [ 'ref' ] [ ident ':' ] expr ;   (* '...' = spread a list *)     (* 'ref' repeated at call
                                                   site for visibility; the borrow cannot escape *)

primary    = literal | ident | '(' expr ')' | list_lit | map_lit | record_lit
           | lambda | if_expr | match_expr | new_expr | spawn_thread_expr | block_expr ;
block_expr = ident NEWLINE { raw_line } 'end' ;   (* ident must be a #[block] comptime func of an
                                                     imported package (or of this file); the raw lines
                                                     are handed to it unchanged *)
list_lit   = '[' [ expr { ',' expr } ] ']' ;
map_lit    = '{' [ expr ':' expr { ',' expr ':' expr } ] '}' ;
record_lit = qname '{' [ field_init { ',' field_init } ] '}' ;
field_init = ident ':' expr ;
lambda     = 'func' '(' [ lambda_params ] ')' { stmt } 'end' ;   (* no '->' *)
lambda_params = lambda_param { ',' lambda_param } ;
if_expr    = if_stmt ;                          (* value of last expr *)
match_expr = match_stmt ;
new_expr   = 'new' record_lit ;                 (* the result has type Rc<T>; see Semantic rules *)
spawn_thread_expr = 'spawn_thread' call ;      (* statement or expression; the result is a Thread *)


(* ---------- Semantic rules (not expressible in EBNF) ---------- *)

(* Types
   - Type inference is local: signatures are explicit, bodies are inferred.
   - Names: int = i32 and long = i64 are aliases (the same types, not new ones); float = f64.
     Errors print i32 as int, i64 as long and f64 as float.
   - Literals: an integer literal defaults to int (= i32), a float literal to float (= f64);
     both adapt to the type the context expects, and a literal outside the range of its
     type is an error (a literal above 2147483647 needs a long context).
   - No implicit lossy coercion: only a widening that keeps every value is implicit (int to
     long, u32 to i64, ..., in assignment, arguments, returns, fields and binary operands,
     where the result takes the wider type). Narrowing, signed/unsigned of the same width and
     integer/float are explicit: int(x), long(x), i16(x), float(x). Generic inference,
     interface methods and function values need the exact types.
   - Arithmetic is computed in the operand type and wraps there: int * int wraps at 32 bits
     even when stored in a long; write long(a) * long(b) for the exact product.
   - len, element counts and list indices are int; a list, map or text holds at most
     2147483647 elements (bytes for text) and the program stops past that. Sizes and offsets
     of files, memory and time are long.
   - 'nil' only exists in T?; flow typing narrows T? to T after a nil check
     or an early return.
   - 'try' (propagate) is only allowed in functions returning 'T or error' or 'error'.
   - match over an enum (or a 'T or error' result: ok(v) / err(e)) must be
     exhaustive unless it contains '_'.
   - async func f() -> T returns Future<T>; `await` yields T, waits without blocking other
     tasks, and may be used once per future. `await` is allowed in any function, method,
     lambda or deferred call (it suspends only the current task); it is an error inside a
     `drop` method and in a function used as a C callback (`#[export]` or an `extern` function
     type). async functions take no `ref` parameters.
   - An 'error' has a kind (ErrorKind), a message (text) and a cause (error?, nil for a
     root error). error("message") has kind errors.Other; error(kind, "message") and
     error(kind, "message", cause) say more; e.kind, e.message and e.cause read the parts;
     e.context("message") wraps e in a new error with the same kind; e.is(kind) looks at e
     and its causes; e.full_message joins the messages. 'try' passes the error on
     unchanged. call() ?? x gives a default when the call fails. ErrorKind values are
     open, namespaced names (package.Name), made with errors.kind(...) and compared with
     == and !=; a text is not a kind. A function that returns an error as a value is
     written '-> error?' ('-> error' means "fails or not").
   - Generics are monomorphized at compile time.
   - Interfaces are structural: a type satisfies an interface if it has
     the methods with matching signatures.
   Values
   - `new T{ ... }` makes a shared, reference-counted object of type Rc<T> (copying an Rc shares it);
     Weak<T> holds one without keeping it alive: weak(x) makes it, w.upgrade() returns Rc<T>? (nil once
     the object is gone); a cycle made only of Rc references is not freed.
   - `shared e` / `shared T`: a value of a record, list, map or text type whose reference counts are atomic;
     its content is immutable (assigning through it or calling a mutating method is an error that
     suggests Mutex<T>). `spawn_thread f(args)` runs f on a new OS thread and yields a Thread;
     every argument and captured variable must be transferable: numbers, bool, text, enums, closures,
     and records, lists, maps, channels of transferable types; Rc<T>, Weak<T>, raw pointers and futures
     are not. A mutable global var used by the spawned function must be a Mutex or an Atomic.
   - record/array values are copied on assignment and call;
     'ref' = temporary borrow of a value that lives elsewhere; it cannot be stored, returned,
     captured or sent to a task (use `new T{ ... }`, an Rc<T>, for a value that must live longer).
   - Integer arithmetic wraps at the width of the type.
   - 'text' is immutable UTF-8 (pointer + length); []u8 for raw bytes.
   Visibility
   - A top-level func, method, type, let/var and record field is private to its package unless
     written 'pub'. Every file of the same package sees all its names; another package sees only
     the 'pub' ones, as pkg.name. A 'pub' enum exports its variants; 'pub' is not allowed on
     variants, interface method signatures, parameters, 'embed', 'package' or 'use'.
   - A record literal or `new` of another package's type needs every field to be 'pub'; otherwise
     the package offers a constructor function. Copying or passing a whole value is always allowed.
   - A 'pub' declaration may not name a private type of its own package in its signature.
   - A generic keeps the access rights of the package that wrote it. An interface of another
     package is satisfied only by 'pub' methods. main, test_ functions, #[export] functions and
     compiler-inserted calls need no 'pub'.
   FFI & Assembly
   - Calling C requires declaring `extern [abi] func ...` (abi defaults to "C").
   - Calling extern functions, dereferencing raw pointers (`*T`), and inline `asm`
     require an enclosing `unsafe` block.
   - `...` at the end of an `extern` parameter list denotes C variadic functions.
   - `extern [abi] func(...) -> T` is a function pointer type compatible with C callbacks.
   - `#[export("name")]` exports a Brasa function with C ABI and unmangled symbol name.
   - `#[c_layout]` on a record enforces standard C ABI struct alignment and padding.
   - `#[link("lib")]` links external libraries; `#[link_src("path.c")]` compiles C files.
   - `asm` blocks use plain string instruction templates with `@name` operand substitutions.
   - Operands declare `in`, `out`, or `inout`. Register names (e.g. `eax`, `r`) bind hardware registers.
   - Clobbers declare registers, flags ("cc"), or memory barriers ("memory") modified by the block.
   - `#[naked]` omits function prologue/epilogue for custom low-level routines. *)


(* ---------- Compile-time attributes ---------- *)

(* The attributes the compiler recognises for comptime: #[derive(name, ...)] on a type runs the
   #[derive] comptime funcs of those names; #[generated(gen)] on a body-less func with a
   'comptime t: Type' parameter makes gen write its body for each type; #[block] marks a
   comptime func that gives a package its own block syntax (block_expr). *)
