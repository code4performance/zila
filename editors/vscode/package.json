{
  "name": "zila-lang",
  "displayName": "Zila Lang Programming Language",
  "description": "A small, readable language that compiles straight to machine code.",
  "icon": "icon.png",
  "version": "0.5.0",
  "publisher": "zila",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/code4performance/zila"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onDebugResolve:zila"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The language server is an executable named by a setting; it is not started from an untrusted workspace's settings.",
      "restrictedConfigurations": [
        "zila.server.path"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "zila",
        "aliases": [
          "Zila Lang",
          "zila"
        ],
        "extensions": [
          ".zila"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zila",
        "scopeName": "source.zila",
        "path": "./syntaxes/zila.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Zila Lang",
      "properties": {
        "zila.server.path": {
          "type": "string",
          "default": "zila",
          "scope": "machine-overridable",
          "markdownDescription": "The `zila` executable that runs the language server (`zila --lsp`). A name is looked up on `PATH`."
        },
        "zila.server.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run the language server for syntax errors and formatting. Highlighting works without it."
        },
        "zila.trace": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Write the messages exchanged with the language server to the **Zila Lang Language Server** output channel."
        }
      }
    },
    "commands": [
      {
        "command": "zila.restartServer",
        "title": "Restart Language Server",
        "category": "Zila Lang"
      },
      {
        "command": "zila.debugFile",
        "title": "Debug Current File",
        "category": "Zila Lang"
      }
    ],
    "breakpoints": [
      {
        "language": "zila"
      }
    ],
    "debuggers": [
      {
        "type": "zila",
        "label": "Zila Lang",
        "languages": [
          "zila"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .zila program to build with --debug and run under the debugger.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "The directory the program runs in (default: the directory of the program).",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first statement of main.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "zila",
            "request": "launch",
            "name": "Debug current file",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Zila Lang: Launch a program",
            "description": "Build a .zila file with --debug and run it under the debugger.",
            "body": {
              "type": "zila",
              "request": "launch",
              "name": "${1:Debug program}",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ]
  }
}
