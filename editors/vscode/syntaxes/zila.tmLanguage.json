{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zila Lang",
  "scopeName": "source.zila",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#sql-blocks" },
    { "include": "#asm-blocks" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zila",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zila",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.allocation.zila",
          "begin": "(#\\[)\\s*(no_alloc|allocates|allocator)\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.attribute.zila" },
            "2": { "name": "entity.name.tag.attribute.allocation.zila" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.attribute.zila" }
          },
          "patterns": [
            {
              "name": "constant.language.allocator-role.zila",
              "match": "\\b(alloc|free|realloc)\\b"
            }
          ]
        },
        {
          "name": "meta.attribute.zila",
          "begin": "(#\\[)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.attribute.zila" },
            "2": { "name": "entity.name.tag.attribute.zila" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.attribute.zila" }
          },
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "name": "variable.parameter.attribute.zila",
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zila",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.zila" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.zila" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.zila",
              "match": "\\\\[nrt\\\\\"0{]"
            },
            {
              "name": "meta.interpolation.zila",
              "begin": "(?<!\\\\)\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.zila" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.zila" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.zila",
          "match": "'(\\\\.|[^'\\\\])'"
        }
      ]
    },
    "sql-blocks": {
      "patterns": [
        {
          "name": "meta.embedded.block.sql.zila",
          "begin": "\\b(sql)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=$|//)",
          "beginCaptures": {
            "1": { "name": "keyword.control.sql.zila" },
            "2": { "name": "entity.name.type.dialect.zila" }
          },
          "end": "^\\s*(end)\\s*(?=$|//)",
          "endCaptures": {
            "1": { "name": "keyword.control.end.zila" }
          },
          "patterns": [
            { "match": "\\{\\{|\\}\\}", "name": "constant.character.escape.brace.zila" },
            {
              "name": "meta.embedded.expression.zila",
              "begin": "\\{",
              "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.zila" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.section.embedded.end.zila" } },
              "patterns": [{ "include": "source.zila" }]
            },
            { "include": "source.sql" }
          ]
        }
      ]
    },
    "asm-blocks": {
      "patterns": [
        {
          "name": "meta.asm.zila",
          "begin": "\\b(asm)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.asm.zila" }
          },
          "end": "^\\s*(end)\\b(?!:)",
          "endCaptures": {
            "1": { "name": "keyword.control.end.zila" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "name": "comment.line.semicolon.asm.zila",
              "match": ";.*$"
            },
            {
              "match": "^\\s*([A-Za-z_.][A-Za-z0-9_.]*):",
              "captures": { "1": { "name": "entity.name.label.asm.zila" } }
            },
            {
              "name": "variable.parameter.asm.zila",
              "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
            },
            {
              "match": "^\\s*(?!(?:inout|in|out|clobber)\\s+\\w+\\s*=)([a-z][a-z0-9]*)\\b",
              "captures": { "1": { "name": "support.function.mnemonic.asm.zila" } }
            },
            {
              "name": "string.quoted.double.asm.zila",
              "begin": "\"",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.string.begin.zila" }
              },
              "end": "\"",
              "endCaptures": {
                "0": { "name": "punctuation.definition.string.end.zila" }
              },
              "patterns": [
                {
                  "name": "variable.parameter.asm.zila",
                  "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
                },
                {
                  "name": "constant.character.escape.zila",
                  "match": "\\\\[nrt\\\\\"0]"
                }
              ]
            },
            {
              "name": "keyword.other.asm.zila",
              "match": "\\b(inout|in|out|clobber)\\b"
            },
            {
              "name": "variable.language.register.zila",
              "match": "\\b(rax|rbx|rcx|rdx|rsi|rdi|rbp|rsp|r8|r9|r10|r11|r12|r13|r14|r15|eax|ebx|ecx|edx|esi|edi|ebp|esp|ax|bx|cx|dx|al|bl|cl|dl|ah|bh|ch|dh|cc|memory)\\b"
            },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#operators" },
            { "include": "#punctuation" },
            { "include": "$self" }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(func)\\s*(\\()\\s*(ref\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\s*:\\s*([a-zA-Z_][a-zA-Z0-9_<>*?]*)\\s*(\\))\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.func.zila" },
            "2": { "name": "punctuation.bracket.zila" },
            "3": { "name": "storage.modifier.ref.zila" },
            "4": { "name": "variable.parameter.receiver.zila" },
            "5": { "name": "entity.name.type.zila" },
            "6": { "name": "punctuation.bracket.zila" },
            "7": { "name": "entity.name.function.zila" }
          }
        },
        {
          "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.func.zila" },
            "2": { "name": "entity.name.function.zila" }
          }
        },
        {
          "match": "\\b(type)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.zila" },
            "2": { "name": "entity.name.type.zila" }
          }
        },
        {
          "match": "\\b(package|use)\\s+([a-zA-Z_][a-zA-Z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.import.zila" },
            "2": { "name": "entity.name.namespace.zila" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.zila",
          "match": "\\b(package|use)\\b"
        },
        {
          "name": "storage.type.zila",
          "match": "\\b(record|enum|interface)\\b"
        },
        {
          "name": "keyword.declaration.zila",
          "match": "\\b(let|var|embed|extern|pub)\\b"
        },
        {
          "name": "keyword.control.zila",
          "match": "\\b(if|else|match|for|in|while|break|continue|return|defer|spawn|spawn_thread|shared|try|async|await)\\b"
        },
        {
          "name": "keyword.control.end.zila",
          "match": "\\b(end)\\b"
        },
        {
          "name": "storage.modifier.zila",
          "match": "\\b(unsafe|ref|self|comptime)\\b"
        },
        {
          "name": "keyword.operator.logical.zila",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.bitwise.zila",
          "match": "\\b(bitand|bitor|bitxor|bitnot)\\b"
        },
        {
          "name": "keyword.operator.new.zila",
          "match": "\\b(new)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.zila",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.zila",
          "match": "\\b(nil)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.zila",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.zila",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.float.zila",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.float.zila",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9_]+\\b"
        },
        {
          "name": "constant.numeric.integer.zila",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.zila",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|isize|usize|f32|f64|bool|char|text|void)\\b"
        },
        {
          "name": "support.type.c.zila",
          "match": "\\bc\\.(char|schar|uchar|short|ushort|int|uint|long|ulong|longlong|ulonglong|size_t|ssize_t|float|double|void)\\b"
        },
        {
          "name": "support.type.zila",
          "match": "\\b(List|Map|Set|Option|Result|String)\\b"
        },
        {
          "name": "entity.name.type.zila",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.call.zila",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.optional-chaining.zila",
          "match": "\\?\\.(?=[a-zA-Z_])"
        },
        {
          "name": "keyword.operator.null-coalescing.zila",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.optional.zila",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.error.zila",
          "match": "!"
        },
        {
          "name": "keyword.operator.dereference.zila",
          "match": "\\^"
        },
        {
          "name": "punctuation.separator.arrow.zila",
          "match": "->"
        },
        {
          "name": "keyword.operator.spread.zila",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.zila",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.zila",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.zila",
          "match": "(=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.arithmetic.zila",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.bitwise.shift.zila",
          "match": "(<<|>>)"
        },
        {
          "name": "keyword.operator.address.zila",
          "match": "&"
        },
        {
          "name": "punctuation.separator.pipe.zila",
          "match": "\\|"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.zila",
          "match": "[\\(\\)\\[\\]\\{\\}]"
        },
        {
          "name": "punctuation.separator.zila",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.dot.zila",
          "match": "\\."
        }
      ]
    }
  }
}

