package main

// Reads standard input line by line and prints each line in upper case.
//
//   printf 'one\ntwo\n' | zila run examples/stdin_lines.zila
//
// Reading standard input waits for the whole program: other tasks do not run until data arrives.

use fs
use text

func main() -> error
    print("Type something, then press ENTER:\n\n")

    let r = fs.stdin()
    var n = 0
    while not try await r.at_end()
        let line = try await r.read_line()
        if text.upper(line) == "EXIT"
            break
        end
        n += 1
        print("{n}: {text.upper(line)}")
    end
    print("Exiting, {n} lines read.")
    return
end
