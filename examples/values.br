// Formatting values of any type: numbers go straight into the template.
//
//   brasa-parse examples/values.br -o values.exe
//
// `format.fmt(template, a, b, ...)` takes up to eight values (integers, floats, booleans, text)
// and the placeholder says how to show each one: `%(08x)` is hexadecimal padded with zeros to
// 8 characters, `%(>10,)` an integer with thousands separators, `%(.2f)` a float with two
// decimals. Your own types join in with a `to_value` method. Native compiler only.
package main

use format

type Point = record
    x: int
    y: int
end

func (p: Point) to_value() -> format.Value
    return format.Text("({p.x}, {p.y})")
end

func main()
    let names = ["Apples", "Figs", "Kiwi", "Ação"]
    let quantities = [1200, 35, 98000, 7]
    let prices = [1.5, 12.25, 0.333, 100.0]

    print(format.fmt("%(<8)|%(>8)|%(>10)", "item", "qty", "price") ?? "")
    print(format.repeat("-", 28))
    var i = 0
    while i < names.len
        print(format.fmt("%(<8)|%(>8,)|%(>10.2f)", names[i], quantities[i], prices[i]) ?? "")
        i += 1
    end
    print(format.repeat("=", 28))

    print(format.fmt("hex %(08x), binary %(b), upper %(X)", 255, 10, 48879) ?? "")
    print(format.fmt("ready: %, ratio: %(.1f), at %", true, 0.25, Point { x: 3, y: 4 }) ?? "")
end
