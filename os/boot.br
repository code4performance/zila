// =====================================================================
// Brasa OS boot sector (512 bytes), written in Brasa.
//
// The BIOS loads this sector at 0x7C00 in 16-bit real mode. It then:
//   1. prints a banner and enables the A20 line,
//   2. reads the kernel from the disk (BIOS int 13h, LBA mode) to 0x10000,
//   3. enters 32-bit protected mode with a flat GDT,
//   4. builds identity-mapped page tables (first 1 GiB, 2 MiB pages),
//   5. turns on PAE, long mode and paging,
//   6. far-jumps into 64-bit code and from there into the kernel.
//
// Build:  brasa-parse --os os/boot.br os/kernel.br -o brasa-os.img
//
// The compiler assembles the `asm` lines below itself (no NASM). The builder
// stores the kernel size, in sectors, in `kernel_sectors`.
// =====================================================================

package boot

#[naked]
func boot()
    asm
        bits 16
        org 0x7C00
        start:
            cli
            xor ax, ax
            mov ds, ax
            mov es, ax
            mov ss, ax
            mov sp, 0x7C00
            mov [boot_drive], dl
            sti
            mov si, msg_boot
            call print16
        // fast A20 gate
            in al, 0x92
            or al, 2
            out 0x92, al
        // read the kernel: LBA 1.., at most 64 sectors per BIOS call
            mov ax, [kernel_sectors]
            mov [remaining], ax
        read_loop:
            mov ax, [remaining]
            test ax, ax
            jz loaded
            cmp ax, 64
            jbe chunk_ok
            mov ax, 64
        chunk_ok:
            mov [dap_count], ax
            mov si, dap
            mov dl, [boot_drive]
            mov ah, 0x42
            int 0x13
            jc disk_error
            mov ax, [dap_count]
            add [dap_lba], ax
            adc word ptr [dap_lba + 2], 0
            mov cx, ax
            shl cx, 5
            add [dap_seg], cx
            sub [remaining], ax
            jmp read_loop
        loaded:
            mov si, msg_ok
            call print16
        // protected mode
            cli
            lgdt [gdt_desc]
            mov eax, cr0
            or eax, 1
            mov cr0, eax
            jmp 0x08:pmode
        disk_error:
            mov si, msg_disk
            call print16
        hang16:
            hlt
            jmp hang16
        // print the NUL-terminated string at ds:si
        print16:
            lodsb
            test al, al
            jz print16_done
            mov ah, 0x0E
            mov bx, 7
            int 0x10
            jmp print16
        print16_done:
            ret
        bits 32
        pmode:
            mov ax, 0x10
            mov ds, ax
            mov es, ax
            mov fs, ax
            mov gs, ax
            mov ss, ax
            mov esp, 0x7C00
        // zero the three page-table pages at 0x1000..0x3FFF
            mov edi, 0x1000
            xor eax, eax
            mov ecx, 0xC00
            rep stosd
            mov dword ptr [0x1000], 0x2003
            mov dword ptr [0x2000], 0x3003
        // 512 page-directory entries: 2 MiB pages, present + writable + big
            xor ecx, ecx
        fill_pd:
            mov eax, ecx
            shl eax, 21
            or eax, 0x83
            mov [0x3000 + ecx * 8], eax
            inc ecx
            cmp ecx, 512
            jb fill_pd
            mov eax, 0x1000
            mov cr3, eax
            mov eax, cr4
            or eax, 0x20
            mov cr4, eax
            mov ecx, 0xC0000080
            rdmsr
            or eax, 0x100
            wrmsr
            mov eax, cr0
            or eax, 0x80000000
            mov cr0, eax
            jmp 0x18:lmode
        bits 64
        lmode:
            mov ax, 0x10
            mov ds, ax
            mov es, ax
            mov ss, ax
            xor ax, ax
            mov fs, ax
            mov gs, ax
            mov rax, 0x10000
            jmp rax
        // data
        boot_drive: db 0
        remaining: dw 0
        kernel_sectors: dw 0
        dap:
            db 16, 0
        dap_count: dw 0
        dap_off: dw 0
        dap_seg: dw 0x1000
        dap_lba: dd 1
            dd 0
        msg_boot: db "Brasa OS: loading kernel...", 13, 10, 0
        msg_ok: db "Kernel loaded. Entering long mode.", 13, 10, 0
        msg_disk: db "Disk read error.", 13, 10, 0
        // flat GDT: null, 32-bit code, 32-bit data, 64-bit code
        gdt:
            dq 0
            dq 0x00CF9A000000FFFF
            dq 0x00CF92000000FFFF
            dq 0x00AF9A000000FFFF
        gdt_end:
        gdt_desc:
            dw gdt_end - gdt - 1
            dd gdt
            times 510 - ($ - $$) db 0
            dw 0xAA55
    end
end
