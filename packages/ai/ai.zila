// =====================================================================
// Zila Lang standard library: language models (`use ai`)
//
//     use ai
//     use json                       // the generated code of `ask` and `tool` names it
//
//     let key = try ai.key_from_env("ANTHROPIC_API_KEY")
//     let client = ai.anthropic(key)
//     let req = ai.request("claude-sonnet-5-5", [ai.user("Hello")], 200)
//     let reply = try client.chat(req)
//     print(reply.text)
//
//     // a value of your own type, with a JSON Schema made from the type
//     let invoice = try ai.ask(Invoice, client, req)
//
//     // tools: a record is the input, a function is the tool; the model decides when to call it
//     let weather = ai.tool(WeatherInput, "get_weather", "The weather in a city", handler)
//     let run = try client.run(req, [weather])
//
// A client for the Anthropic Messages API (`ai.anthropic`) and for OpenAI-compatible servers,
// including local ones over plain http such as Ollama (`ai.openai_compatible`). Written in Zila Lang
// on `web` (HTTP client and streaming) and `json`; nothing in the compiler knows about models.
//
//   * The key travels only in a request header. No error message, and nothing else the library
//     returns, contains it. `https` is checked by `tls` with no way to turn that off.
//   * The model is always named by the caller; there is no default model.
//   * `chat`, `stream`, `ask`, `run` and `embed` wait without blocking other tasks, retry
//     connection errors and 429, 500, 502, 503, 504 and 529 with back-off (`max_retries`, 2 by
//     default; never after streamed output reached the caller), and give an error of kind
//     Timeout after `timeout` milliseconds.
//   * Errors have a kind from the status: 401 Unauthenticated, 403 PermissionDenied, 400 and
//     422 InvalidInput, 404 NotFound, 429 and 5xx Unavailable.
//   * Tool output and any text a model sees is untrusted input: register only the tools you are
//     willing to have called, and give them the least privilege that works.
// =====================================================================

package ai

use web
use json
use errors
use text
use sys
use crypto
use reflect

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

pub type Role = enum
    User
    Assistant
end

// A tool the model asked for: the id the provider gave, the tool's name and the arguments as JSON.
pub type ToolCall = record
    pub id: text
    pub name: text
    pub args: text
end

// What a tool returned (or the error text, with `is_error`) for the call `id`.
pub type ToolResult = record
    pub id: text
    pub output: text
    pub is_error: bool
end

// One turn of a conversation. An assistant turn may carry the tool calls it made; a user turn
// may carry the results of tools.
pub type Message = record
    pub role: Role
    pub content: text
    pub calls: []ToolCall
    pub results: []ToolResult
end

// A user message.
pub func user(content: text) -> Message
    return Message { role: User, content: content, calls: [], results: [] }
end

// An assistant message (for conversations that already have earlier answers).
pub func assistant(content: text) -> Message
    return Message { role: Assistant, content: content, calls: [], results: [] }
end

pub type Request = record
    pub model: text
    pub system: text
    pub messages: []Message
    pub max_tokens: int
    pub temperature: float
    pub stop: []text
end

// A request with the usual defaults: no system text, the provider's own temperature (a
// `temperature` below zero means "not set") and no stop sequences.
pub func request(model: text, messages: []Message, max_tokens: int) -> Request
    return Request { model: model, system: "", messages: messages, max_tokens: max_tokens, temperature: -1.0, stop: [] }
end

pub type Usage = record
    pub input: int
    pub output: int
end

pub type StopReason = enum
    End
    MaxTokens
    ToolUse
    Other(text)
end

pub type Reply = record
    pub text: text
    pub stop: StopReason
    pub usage: Usage
    pub calls: []ToolCall
end

// A tool for the agent loop: a name, what it does, the JSON Schema of its arguments, and the
// function that runs it on the arguments as JSON text. Made by `ai.tool(InputType, ...)`.
pub type Tool = record
    pub name: text
    pub description: text
    pub schema: text
    pub call: func(text) -> text or error
end

// What `run` returns: the final reply, the whole conversation (with the tool calls and results),
// the number of model calls and the tokens used over all of them.
pub type Run = record
    pub reply: Reply
    pub messages: []Message
    pub steps: int
    pub usage: Usage
end

type Wire = enum
    Anthropic
    OpenAi
end

// A connection to a model API. Make one with `anthropic` or `openai_compatible`.
pub type Client = record
    pub base_url: text
    key: text
    wire: Wire
    pub timeout: long
    pub max_retries: int
    pub batch_size: int
    pub max_steps: int
    pub version: text
end

// ---------------------------------------------------------------------------
// Clients and keys
// ---------------------------------------------------------------------------

// A client for the Anthropic Messages API.
pub func anthropic(key: text) -> Client
    return Client { base_url: "https://api.anthropic.com", key: key, wire: Anthropic, timeout: 120000, max_retries: 2, batch_size: 64, max_steps: 10, version: "2023-06-01" }
end

// A client for an OpenAI-compatible server: `base_url` is the part before `/chat/completions`
// (`https://api.openai.com/v1`, or `http://localhost:11434/v1` for Ollama). `key` may be empty for
// a local server.
pub func openai_compatible(base_url: text, key: text) -> Client
    return Client { base_url: base_url, key: key, wire: OpenAi, timeout: 120000, max_retries: 2, batch_size: 64, max_steps: 10, version: "" }
end

// The key stored in the environment variable `name`. The error names the variable, never a value.
pub func key_from_env(name: text) -> text or error
    let v = sys.env(name) ?? ""
    if v == ""
        return error(errors.InvalidInput, "the environment variable {name} is not set or is empty")
    end
    return v
end

// ---------------------------------------------------------------------------
// JSON helpers
// ---------------------------------------------------------------------------

func jtext(s: text) -> json.Value
    return json.Text(s)
end

func jnum(n: long) -> json.Value
    return json.Number(float(n), "")
end

func jget(v: json.Value, key: text) -> json.Value
    match v
        Object(m) ->
            if m.has(key)
                return m[key]
            end
            return json.Null
        _ -> return json.Null
    end
    return json.Null
end

func jstr(v: json.Value) -> text
    match v
        Text(s) -> return s
        _ -> return ""
    end
    return ""
end

func jint(v: json.Value) -> int
    match v
        Number(x, lit) -> return int(x)
        _ -> return 0
    end
    return 0
end

func jlist(v: json.Value) -> []json.Value
    match v
        List(xs) -> return xs
        _ -> return []
    end
    return []
end

func is_null(v: json.Value) -> bool
    match v
        Null -> return true
        _ -> return false
    end
    return false
end

func parse_json(s: text) -> json.Value
    match json.parse_value(s)
        ok(v) -> return v
        err(e) -> return json.Null
    end
    return json.Null
end

func dump(v: json.Value) -> text or error
    return json.stringify(v)
end

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

func anthropic_message(m: Message) -> json.Value or error
    var o: Map<text, json.Value> = {}
    if m.role == Assistant
        o["role"] = jtext("assistant")
    else
        o["role"] = jtext("user")
    end
    if m.calls.len > 0 or m.results.len > 0
        var blocks: []json.Value = []
        if m.content != ""
            var b: Map<text, json.Value> = {}
            b["type"] = jtext("text")
            b["text"] = jtext(m.content)
            blocks.add(json.Object(b))
        end
        for c in m.calls
            var b: Map<text, json.Value> = {}
            b["type"] = jtext("tool_use")
            b["id"] = jtext(c.id)
            b["name"] = jtext(c.name)
            b["input"] = parse_json(c.args)
            blocks.add(json.Object(b))
        end
        for r in m.results
            var b: Map<text, json.Value> = {}
            b["type"] = jtext("tool_result")
            b["tool_use_id"] = jtext(r.id)
            b["content"] = jtext(r.output)
            if r.is_error
                b["is_error"] = json.Bool(true)
            end
            blocks.add(json.Object(b))
        end
        o["content"] = json.List(blocks)
    else
        o["content"] = jtext(m.content)
    end
    return json.Object(o)
end

func openai_messages(req: Request) -> []json.Value
    var out: []json.Value = []
    if req.system != ""
        var s: Map<text, json.Value> = {}
        s["role"] = jtext("system")
        s["content"] = jtext(req.system)
        out.add(json.Object(s))
    end
    for m in req.messages
        if m.results.len > 0
            for r in m.results
                var t: Map<text, json.Value> = {}
                t["role"] = jtext("tool")
                t["tool_call_id"] = jtext(r.id)
                t["content"] = jtext(r.output)
                out.add(json.Object(t))
            end
            continue
        end
        var o: Map<text, json.Value> = {}
        if m.role == Assistant
            o["role"] = jtext("assistant")
        else
            o["role"] = jtext("user")
        end
        o["content"] = jtext(m.content)
        if m.calls.len > 0
            var cs: []json.Value = []
            for c in m.calls
                var f: Map<text, json.Value> = {}
                f["name"] = jtext(c.name)
                f["arguments"] = jtext(c.args)
                var one: Map<text, json.Value> = {}
                one["id"] = jtext(c.id)
                one["type"] = jtext("function")
                one["function"] = json.Object(f)
                cs.add(json.Object(one))
            end
            o["tool_calls"] = json.List(cs)
        end
        out.add(json.Object(o))
    end
    return out
end

func request_body(c: Client, req: Request, tools: []Tool, stream: bool) -> text or error
    var m: Map<text, json.Value> = {}
    m["model"] = jtext(req.model)
    m["max_tokens"] = jnum(long(req.max_tokens))
    if req.temperature >= 0.0
        m["temperature"] = json.Number(req.temperature, "")
    end
    if c.wire == Anthropic
        if req.system != ""
            m["system"] = jtext(req.system)
        end
        var msgs: []json.Value = []
        for x in req.messages
            msgs.add(try anthropic_message(x))
        end
        m["messages"] = json.List(msgs)
        if req.stop.len > 0
            var st: []json.Value = []
            for s in req.stop
                st.add(jtext(s))
            end
            m["stop_sequences"] = json.List(st)
        end
        if tools.len > 0
            var ts: []json.Value = []
            for t in tools
                var d: Map<text, json.Value> = {}
                d["name"] = jtext(t.name)
                d["description"] = jtext(t.description)
                d["input_schema"] = parse_json(t.schema)
                ts.add(json.Object(d))
            end
            m["tools"] = json.List(ts)
        end
    else
        m["messages"] = json.List(openai_messages(req))
        if req.stop.len > 0
            var st: []json.Value = []
            for s in req.stop
                st.add(jtext(s))
            end
            m["stop"] = json.List(st)
        end
        if tools.len > 0
            var ts: []json.Value = []
            for t in tools
                var f: Map<text, json.Value> = {}
                f["name"] = jtext(t.name)
                f["description"] = jtext(t.description)
                f["parameters"] = parse_json(t.schema)
                var d: Map<text, json.Value> = {}
                d["type"] = jtext("function")
                d["function"] = json.Object(f)
                ts.add(json.Object(d))
            end
            m["tools"] = json.List(ts)
        end
        if stream
            var so: Map<text, json.Value> = {}
            so["include_usage"] = json.Bool(true)
            m["stream_options"] = json.Object(so)
        end
    end
    if stream
        m["stream"] = json.Bool(true)
    end
    return json.stringify(json.Object(m))
end

func endpoint(c: Client, what: text) -> text
    if c.wire == Anthropic
        return c.base_url + "/v1/messages"
    end
    return c.base_url + what
end

func headers(c: Client) -> Map<text, text>
    var h: Map<text, text> = {}
    h["Content-Type"] = "application/json"
    if c.wire == Anthropic
        h["x-api-key"] = c.key
        h["anthropic-version"] = c.version
    else if c.key != ""
        h["Authorization"] = "Bearer " + c.key
    end
    return h
end

// ---------------------------------------------------------------------------
// Errors and retries
// ---------------------------------------------------------------------------

func kind_for(status: int) -> ErrorKind
    if status == 401
        return errors.Unauthenticated
    end
    if status == 403
        return errors.PermissionDenied
    end
    if status == 400 or status == 422
        return errors.InvalidInput
    end
    if status == 404
        return errors.NotFound
    end
    if status == 408
        return errors.Timeout
    end
    if status == 429 or status >= 500
        return errors.Unavailable
    end
    return errors.Other
end

// The provider's message in an error body, or the start of the body.
func provider_message(body: text) -> text
    let v = parse_json(body)
    let e = jget(v, "error")
    var m = jstr(jget(e, "message"))
    if m == ""
        m = jstr(e)
    end
    if m == ""
        m = jstr(jget(v, "message"))
    end
    if m == ""
        m = body
        if m.len > 300
            m = m.slice(0, 300)
        end
    end
    return m
end

func status_error(status: int, body: text) -> error?
    return error(kind_for(status), "model API error {status}: {provider_message(body)}")
end

func retryable(status: int) -> bool
    return status == 429 or status == 500 or status == 502 or status == 503 or status == 504 or status == 529
end

// How long to wait before attempt `attempt + 1`: `retry-after` when the server sent it, else an
// exponential back-off with jitter.
func backoff(retry_after: text, attempt: int) -> long
    match text.parse_long(text.trim(retry_after))
        ok(n) ->
            if n >= 0 and n <= 60
                return n * 1000
            end
        err(e) -> attempt = attempt
    end
    var ms: long = 500
    for k in 0..attempt
        ms = ms * 2
    end
    if ms > 8000
        ms = 8000
    end
    let r = crypto.random(1) ?? "a"
    return ms + long(r.byte(0)) * 2
end

func client_options(c: Client) -> web.ClientOptions
    return web.ClientOptions { max_response: 33554432, timeout: c.timeout, max_redirects: 0 }
end

// POSTs `body`, retrying what is worth retrying, and returns a successful response.
func post(c: Client, url: text, body: text) -> web.ClientResponse or error
    var attempt = 0
    while true
        match web.request_with(client_options(c), web.Post, url, headers(c), body)
            ok(res) ->
                if res.status >= 200 and res.status < 300
                    return res
                end
                if retryable(res.status) and attempt < c.max_retries
                    await sleep(backoff(res.header("retry-after") ?? "", attempt))
                    attempt += 1
                    continue
                end
                return status_error(res.status, res.body)
            err(e) ->
                if e.kind != errors.Timeout and attempt < c.max_retries
                    await sleep(backoff("", attempt))
                    attempt += 1
                    continue
                end
                return e
        end
    end
    return error(errors.Other, "unreachable")
end

// ---------------------------------------------------------------------------
// Replies
// ---------------------------------------------------------------------------

func stop_of(raw: text) -> StopReason
    if raw == "end_turn" or raw == "stop" or raw == "stop_sequence"
        return End
    end
    if raw == "max_tokens" or raw == "length"
        return MaxTokens
    end
    if raw == "tool_use" or raw == "tool_calls"
        return ToolUse
    end
    return Other(raw)
end

func parse_reply(c: Client, body: text) -> Reply or error
    let v = parse_json(body)
    if is_null(v)
        return error(errors.Io, "the model API sent an answer that is not JSON")
    end
    var r = Reply { text: "", stop: End, usage: Usage { input: 0, output: 0 }, calls: [] }
    if c.wire == Anthropic
        for b in jlist(jget(v, "content"))
            let kind = jstr(jget(b, "type"))
            if kind == "text"
                r.text = r.text + jstr(jget(b, "text"))
            else if kind == "tool_use"
                let args = try dump(jget(b, "input"))
                r.calls.add(ToolCall { id: jstr(jget(b, "id")), name: jstr(jget(b, "name")), args: args })
            end
        end
        r.stop = stop_of(jstr(jget(v, "stop_reason")))
        r.usage = Usage { input: jint(jget(jget(v, "usage"), "input_tokens")), output: jint(jget(jget(v, "usage"), "output_tokens")) }
    else
        let choices = jlist(jget(v, "choices"))
        if choices.len == 0
            return error(errors.Io, "the model API answered without a choice")
        end
        let msg = jget(choices[0], "message")
        r.text = jstr(jget(msg, "content"))
        for t in jlist(jget(msg, "tool_calls"))
            let f = jget(t, "function")
            r.calls.add(ToolCall { id: jstr(jget(t, "id")), name: jstr(jget(f, "name")), args: jstr(jget(f, "arguments")) })
        end
        r.stop = stop_of(jstr(jget(choices[0], "finish_reason")))
        if r.calls.len > 0 and r.stop == End
            r.stop = ToolUse
        end
        r.usage = Usage { input: jint(jget(jget(v, "usage"), "prompt_tokens")), output: jint(jget(jget(v, "usage"), "completion_tokens")) }
    end
    return r
end

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

func send(c: Client, req: Request, tools: []Tool) -> Reply or error
    let body = try request_body(c, req, tools, false)
    let res = try post(c, endpoint(c, "/chat/completions"), body)
    return parse_reply(c, res.body)
end

// Sends the conversation and returns the model's reply.
pub func (c: Client) chat(req: Request) -> Reply or error
    return send(c, req, [])
end

// ---------------------------------------------------------------------------
// Streaming
// ---------------------------------------------------------------------------

#[shared]
type Acc = record
    wire: Wire
    pending: text
    text: text
    stop: StopReason
    usage: Usage
    calls: []ToolCall
    sent: bool
    on_text: func(text) -> error
end

func add_text(a: Acc, piece: text) -> error
    if piece == ""
        return
    end
    a.text = a.text + piece
    a.sent = true
    return a.on_text(piece)
end

func last_call_args(a: Acc, piece: text)
    if a.calls.len > 0
        let i = a.calls.len - 1
        var c = a.calls[i]
        c.args = c.args + piece
        a.calls[i] = c
    end
end

// One server-sent event (the JSON of a `data:` line).
func handle_event(a: Acc, payload: text) -> error
    if payload == "[DONE]" or payload == ""
        return
    end
    let v = parse_json(payload)
    if is_null(v)
        return
    end
    if a.wire == Anthropic
        let kind = jstr(jget(v, "type"))
        if kind == "message_start"
            a.usage.input = jint(jget(jget(jget(v, "message"), "usage"), "input_tokens"))
        else if kind == "content_block_start"
            let b = jget(v, "content_block")
            if jstr(jget(b, "type")) == "tool_use"
                a.calls.add(ToolCall { id: jstr(jget(b, "id")), name: jstr(jget(b, "name")), args: "" })
            end
        else if kind == "content_block_delta"
            let d = jget(v, "delta")
            let dk = jstr(jget(d, "type"))
            if dk == "text_delta"
                try add_text(a, jstr(jget(d, "text")))
            else if dk == "input_json_delta"
                last_call_args(a, jstr(jget(d, "partial_json")))
            end
        else if kind == "message_delta"
            let sr = jstr(jget(jget(v, "delta"), "stop_reason"))
            if sr != ""
                a.stop = stop_of(sr)
            end
            let out = jint(jget(jget(v, "usage"), "output_tokens"))
            if out > 0
                a.usage.output = out
            end
        else if kind == "error"
            return error(errors.Unavailable, "model API error: {provider_message(payload)}")
        end
        return
    end
    let choices = jlist(jget(v, "choices"))
    if choices.len > 0
        let d = jget(choices[0], "delta")
        try add_text(a, jstr(jget(d, "content")))
        for t in jlist(jget(d, "tool_calls"))
            let idx = jint(jget(t, "index"))
            while a.calls.len <= idx
                a.calls.add(ToolCall { id: "", name: "", args: "" })
            end
            var c = a.calls[idx]
            let id = jstr(jget(t, "id"))
            if id != ""
                c.id = id
            end
            let f = jget(t, "function")
            let nm = jstr(jget(f, "name"))
            if nm != ""
                c.name = nm
            end
            c.args = c.args + jstr(jget(f, "arguments"))
            a.calls[idx] = c
        end
        let fr = jstr(jget(choices[0], "finish_reason"))
        if fr != ""
            a.stop = stop_of(fr)
        end
    end
    let u = jget(v, "usage")
    if not is_null(u)
        let pi = jint(jget(u, "prompt_tokens"))
        if pi > 0
            a.usage.input = pi
            a.usage.output = jint(jget(u, "completion_tokens"))
        end
    end
    return
end

// Takes the complete lines out of what has arrived and handles the `data:` ones.
func feed(a: Acc, chunk: text) -> error
    a.pending = a.pending + chunk
    while true
        let nl = text.index_of(a.pending, "\n")
        if nl < 0
            break
        end
        var line = a.pending.slice(0, nl)
        a.pending = a.pending.slice(nl + 1, a.pending.len)
        if line.len > 0 and line.byte(line.len - 1) == 13
            line = line.slice(0, line.len - 1)
        end
        if text.starts_with(line, "data:")
            try handle_event(a, text.trim(line.slice(5, line.len)))
        end
    end
    return
end

// Like `chat`, but calls `on_text(piece)` with each fragment of the answer as it arrives and
// returns the same `Reply` at the end. `on_text` may return an error to stop the stream: the
// connection is closed and that error is returned.
pub func (c: Client) stream(req: Request, on_text: func(text) -> error) -> Reply or error
    return stream_with(c, req, [], on_text)
end

func stream_with(c: Client, req: Request, tools: []Tool, on_text: func(text) -> error) -> Reply or error
    let body = try request_body(c, req, tools, true)
    var attempt = 0
    while true
        let a = Acc { wire: c.wire, pending: "", text: "", stop: End, usage: Usage { input: 0, output: 0 }, calls: [], sent: false, on_text: on_text }
        let url = endpoint(c, "/chat/completions")
        var failure: error? = nil
        var status = 0
        var retry_after = ""
        var err_body = ""
        match web.stream(client_options(c), web.Post, url, headers(c), body, func(p) return feed(a, p) end)
            ok(res) ->
                status = res.status
                retry_after = res.header("retry-after") ?? ""
                err_body = res.body
            err(e) -> failure = e
        end
        if failure == nil and status >= 200 and status < 300
            if a.pending != ""
                try feed(a, "\n")
            end
            var calls = a.calls
            for i in 0..calls.len
                if calls[i].args == ""
                    var cc = calls[i]
                    cc.args = "\{\}"
                    calls[i] = cc
                end
            end
            return Reply { text: a.text, stop: a.stop, usage: a.usage, calls: calls }
        end
        if failure == nil
            if retryable(status) and attempt < c.max_retries
                await sleep(backoff(retry_after, attempt))
                attempt += 1
                continue
            end
            return status_error(status, err_body)
        end
        let e = failure ?? error(errors.Other, "unreachable")
        if not a.sent and e.kind != errors.Timeout and e.kind != errors.Cancelled and attempt < c.max_retries and is_transport(e)
            await sleep(backoff("", attempt))
            attempt += 1
            continue
        end
        return e
    end
    return error(errors.Other, "unreachable")
end

// An error from the connection, as opposed to one the caller's callback returned.
func is_transport(e: error) -> bool
    return e.kind == errors.ConnectionReset or e.kind == errors.ConnectionRefused or e.kind == errors.Unavailable or e.kind == errors.Io or e.kind == errors.UnexpectedEof
end

// ---------------------------------------------------------------------------
// Tools and the agent loop
// ---------------------------------------------------------------------------

async func run_tool(t: Tool, call: ToolCall) -> ToolResult
    match t.call(call.args)
        ok(out) -> return ToolResult { id: call.id, output: out, is_error: false }
        err(e) -> return ToolResult { id: call.id, output: e.message, is_error: true }
    end
    return ToolResult { id: call.id, output: "", is_error: true }
end

func find_tool(tools: []Tool, name: text) -> int
    for i in 0..tools.len
        if tools[i].name == name
            return i
        end
    end
    return -1
end

// Runs the agent loop: sends the conversation, and while the model asks for tools, runs them
// (the calls of one turn run at the same time) and sends the results back, until the model
// answers without asking. A tool that fails, bad arguments and an unknown tool name are reported
// to the model as error results; they do not end the loop. After `max_steps` model calls the loop
// stops with an error.
pub func (c: Client) run(req: Request, tools: []Tool) -> Run or error
    var messages = req.messages
    var total = Usage { input: 0, output: 0 }
    var steps = 0
    while true
        if steps >= c.max_steps
            return error(errors.Other, "the agent loop stopped after {c.max_steps} model calls (max_steps)")
        end
        var turn = req
        turn.messages = messages
        let reply = try send(c, turn, tools)
        steps += 1
        total.input += reply.usage.input
        total.output += reply.usage.output
        if reply.calls.len == 0
            return Run { reply: reply, messages: messages, steps: steps, usage: total }
        end
        var asked = assistant(reply.text)
        asked.calls = reply.calls
        messages.add(asked)
        // start every call, then collect the results in the order of the calls
        var futures: []Future<ToolResult> = []
        var results: []ToolResult = []
        for call in reply.calls
            let i = find_tool(tools, call.name)
            if i < 0
                futures.add(unknown_tool(call))
            else
                futures.add(run_tool(tools[i], call))
            end
        end
        for f in futures
            results.add(await f)
        end
        var back = user("")
        back.results = results
        messages.add(back)
    end
    return error(errors.Other, "unreachable")
end

async func unknown_tool(call: ToolCall) -> ToolResult
    return ToolResult { id: call.id, output: "there is no tool named {call.name}", is_error: true }
end

pub func __bad_args(message: text) -> error?
    return error(errors.InvalidInput, "the arguments do not match the tool's input: {message}")
end

// ---------------------------------------------------------------------------
// Typed output
// ---------------------------------------------------------------------------

// The JSON Schema of a type (`ai.schema(Invoice)`), made at build time from its fields and
// attributes: `#[desc("...")]` describes a field, `#[json("name")]` and `#[json(skip)]` rename
// and leave out, as in `json`.
#[generated(schema_gen)]
pub func schema(comptime t: Type) -> text

// A value of type `T` from the model: the answer must be JSON that matches the schema of `T`.
// When it does not parse, the model is shown the error once and asked again; a second failure
// is an error of kind InvalidInput that carries the answer. The program that calls `ask` also
// writes `use json`.
#[generated(ask_gen)]
pub func ask(comptime t: Type, c: Client, req: Request) -> t or error

// A tool whose input is the record type `I`: `ai.tool(Weather, "get_weather", "...", handler)`.
#[generated(tool_gen)]
pub func tool(comptime t: Type, name: text, description: text, handler: func(t) -> text or error) -> Tool

// The JSON in an answer: a Markdown fence around it is removed.
func strip_fence(s: text) -> text
    var t = text.trim(s)
    if text.starts_with(t, "```")
        let nl = text.index_of(t, "\n")
        if nl >= 0
            t = t.slice(nl + 1, t.len)
        end
        if text.ends_with(t, "```")
            t = t.slice(0, t.len - 3)
        end
        t = text.trim(t)
    end
    return t
end

func with_schema(req: Request, schema: text) -> Request
    var r = req
    var note = "Answer with one JSON value only, no other text, that matches this JSON Schema:\n" + schema
    if r.system != ""
        note = r.system + "\n\n" + note
    end
    r.system = note
    return r
end

pub func __ask_text(c: Client, req: Request, schema: text) -> text or error
    let reply = try send(c, with_schema(req, schema), [])
    return strip_fence(reply.text)
end

pub func __repair(c: Client, req: Request, schema: text, answer: text, problem: text) -> text or error
    var r = with_schema(req, schema)
    var ms = r.messages
    ms.add(assistant(answer))
    ms.add(user("That answer was not valid: {problem}\nAnswer again with only the corrected JSON."))
    r.messages = ms
    let reply = try send(c, r, [])
    return strip_fence(reply.text)
end

pub func __ask_failed(answer: text, problem: text) -> error?
    return error(errors.InvalidInput, "the model's answer does not match the type: {problem}\nanswer: {answer}")
end

// ---- the generators ----

comptime func quote(s: text) -> text
    var out = "\""
    for c in s
        if c == '"'
            out = out + "\\\""
        else if c == '\\'
            out = out + "\\\\"
        else if c == '{'
            out = out + "\\\{"
        else if c == '}'
            out = out + "\\\}"
        else if c == '\n'
            out = out + "\\n"
        else
            out = out + c.to_text()
        end
    end
    return out + "\""
end

// A JSON string literal (the text of the schema, not Zila Lang source).
comptime func js(s: text) -> text
    var out = "\""
    for c in s
        if c == '"'
            out = out + "\\\""
        else if c == '\\'
            out = out + "\\\\"
        else if c == '\n'
            out = out + "\\n"
        else
            out = out + c.to_text()
        end
    end
    return out + "\""
end

comptime func field_key(f: reflect.Field) -> text
    var key = f.name
    for a in f.attrs
        if a.name == "json"
            if a.args.len == 1
                if not a.quoted[0] and a.args[0] == "skip"
                    return ""
                end
                if a.quoted[0] and a.args[0] != ""
                    key = a.args[0]
                end
            end
        end
    end
    return key
end

comptime func field_desc(f: reflect.Field) -> text
    for a in f.attrs
        if a.name == "desc"
            if a.args.len == 1 and a.quoted[0]
                return a.args[0]
            end
            reflect.fail("the desc attribute of field {f.name} takes one quoted text", f)
        end
    end
    return ""
end

// `{` and `}` around `s` (a brace in a text literal would start an interpolation).
comptime func o(s: text) -> text
    return "\{" + s + "\}"
end

comptime func with_desc(body: text, d: text) -> text
    if d == ""
        return body
    end
    // body is a JSON object: add the description before its closing brace
    return body.slice(0, body.len - 1) + ",\"description\":" + js(d) + "\}"
end

comptime func schema_of(t: Type, depth: int) -> text
    if depth > 8
        reflect.fail("ai cannot make a schema for {t.name()}: it nests too deeply (recursive types are not supported)", t)
    end
    let k = t.kind()
    let n = t.name()
    if k == "bool"
        return o("\"type\":\"boolean\"")
    else if k == "text"
        return o("\"type\":\"string\"")
    else if k == "int"
        return o("\"type\":\"integer\"")
    else if k == "float"
        return o("\"type\":\"number\"")
    else if k == "alias"
        return schema_of(t.inner(), depth + 1)
    else if k == "optional"
        return schema_of(t.inner(), depth + 1)
    else if k == "list"
        return o("\"type\":\"array\",\"items\":" + schema_of(t.element(), depth + 1))
    else if k == "map"
        if t.key().kind() != "text"
            reflect.fail("ai cannot make a schema for {n}: JSON objects have text keys", t)
        end
        return o("\"type\":\"object\",\"additionalProperties\":" + schema_of(t.value(), depth + 1))
    else if k == "record"
        if n == "Value" or n == "json.Value"
            return o("")
        end
        var props = ""
        var req = ""
        for f in t.fields()
            let key = field_key(f)
            if key != ""
                if props != ""
                    props = props + ","
                end
                props = props + js(key) + ":" + with_desc(schema_of(f.ty, depth + 1), field_desc(f))
                if f.ty.kind() != "optional"
                    if req != ""
                        req = req + ","
                    end
                    req = req + js(key)
                end
            end
        end
        return o("\"type\":\"object\",\"properties\":" + o(props) + ",\"required\":[" + req + "]")
    else if k == "enum"
        if n == "Value" or n == "json.Value"
            return o("")
        end
        var plain = true
        for v in t.variants()
            if v.fields.len > 0
                plain = false
            end
        end
        if plain
            var names = ""
            for v in t.variants()
                if names != ""
                    names = names + ","
                end
                names = names + js(v.name)
            end
            return o("\"enum\":[" + names + "]")
        end
        var alts = ""
        for v in t.variants()
            if alts != ""
                alts = alts + ","
            end
            if v.fields.len == 0
                alts = alts + o("\"enum\":[" + js(v.name) + "]")
            else
                var payload = ""
                if v.fields.len == 1
                    payload = schema_of(v.fields[0].ty, depth + 1)
                else
                    var items = ""
                    for g in v.fields
                        if items != ""
                            items = items + ","
                        end
                        items = items + schema_of(g.ty, depth + 1)
                    end
                    payload = o("\"type\":\"array\",\"prefixItems\":[" + items + "]")
                end
                alts = alts + o("\"type\":\"object\",\"properties\":" + o(js(v.name) + ":" + payload) + ",\"required\":[" + js(v.name) + "]")
            end
        end
        return o("\"oneOf\":[" + alts + "]")
    end
    reflect.fail("ai cannot make a schema for a value of type {n} (kind {k})", t)
    return ""
end

comptime func schema_gen(t: Type) -> text
    return "return {quote(schema_of(t, 0))}\n"
end

comptime func ask_gen(t: Type) -> text
    let n = t.name()
    var out = "let schema = ai.schema<{n}>()\n"
    out = out + "var raw = try ai.__ask_text(c, req, schema)\n"
    out = out + "match json.parse<{n}>(raw)\n    ok(v) -> return v\n    err(e) ->\n        raw = try ai.__repair(c, req, schema, raw, e.message)\n        match json.parse<{n}>(raw)\n            ok(v2) -> return v2\n            err(e2) -> return ai.__ask_failed(raw, e2.message)\n        end\nend\n"
    out = out + "return ai.__ask_failed(raw, \"unreachable\")\n"
    return out
end

comptime func tool_gen(t: Type) -> text
    let n = t.name()
    var out = "return ai.Tool \{ name: name, description: description, schema: ai.schema<{n}>(), call: func(args)\n"
    out = out + "    match json.parse<{n}>(args)\n        ok(v) -> return handler(v)\n        err(e) -> return ai.__bad_args(e.message)\n    end\n    return \"\"\nend \}\n"
    return out
end

// ---------------------------------------------------------------------------
// Embeddings
// ---------------------------------------------------------------------------

// An embedding model on a client: `client.embedder("text-embedding-3-small")`. It has the method
// `embed(inputs)`, which is what `rag` asks of an embedder.
pub type Embedder = record
    pub client: Client
    pub model: text
end

pub func (c: Client) embedder(model: text) -> Embedder
    return Embedder { client: c, model: model }
end

pub func (e: Embedder) embed(inputs: []text) -> [][]float or error
    return e.client.embed(e.model, inputs)
end

// One vector per input, in order. For providers with an embeddings endpoint (OpenAI-compatible
// servers); `anthropic` has none and gives an error of kind InvalidInput. Inputs are sent
// `batch_size` at a time.
pub func (c: Client) embed(model: text, inputs: []text) -> [][]float or error
    var out: [][]float = []
    if inputs.len == 0
        return out
    end
    if c.wire == Anthropic
        return error(errors.InvalidInput, "the Anthropic API has no embeddings endpoint: use an OpenAI-compatible server or another embedding provider")
    end
    var at = 0
    while at < inputs.len
        var to = at + c.batch_size
        if to > inputs.len
            to = inputs.len
        end
        var list: []json.Value = []
        for i in at..to
            list.add(jtext(inputs[i]))
        end
        var m: Map<text, json.Value> = {}
        m["model"] = jtext(model)
        m["input"] = json.List(list)
        let body = try dump(json.Object(m))
        let res = try post(c, endpoint(c, "/embeddings"), body)
        let v = parse_json(res.body)
        let data = jlist(jget(v, "data"))
        if data.len != to - at
            return error(errors.Io, "the embeddings endpoint returned {data.len} vectors for {to - at} inputs")
        end
        // each item says which input it is for
        var slots: [][]float = []
        for k in 0..data.len
            slots.add([])
        end
        for d in data
            var vec: []float = []
            for x in jlist(jget(d, "embedding"))
                match x
                    Number(f, lit) -> vec.add(f)
                    _ -> vec.add(0.0)
                end
            end
            var idx = jint(jget(d, "index"))
            if idx < 0 or idx >= data.len
                idx = 0
            end
            slots[idx] = vec
        end
        for s in slots
            out.add(s)
        end
        at = to
    end
    return out
end
