// =====================================================================
// Brasa standard library: hashes, message authentication, encodings and random bytes
// (`use crypto`)
//
//   use crypto
//   let d = crypto.sha256("abc")
//   print(crypto.hex(d))                        // ba7816bf...
//   let mac = crypto.hmac_sha256("key", "data")
//   let key = try crypto.pbkdf2_sha256("passwd", "salt", 4096, 32)
//   print(crypto.base64_encode(d))
//   let nonce = try crypto.random(16)
//
// Binary values (digests, keys, random bytes) are carried in a `text` whose bytes are the
// binary data, like the data a socket returns: it is not necessarily UTF-8, so print it through
// `hex` or `base64_encode`. Plain Brasa, written from FIPS 180-4 (SHA-256), RFC 1321 (MD5),
// RFC 2104 and RFC 4231 (HMAC), RFC 8018 and RFC 7914 (PBKDF2) and RFC 4648 (base64).
//
// This library is for protocol use (logins, tokens, checksums): it offers no ciphers or
// signatures, and `md5` exists for old protocols only, not for security.
// =====================================================================

package crypto

use c
use sys
use errors
use text

let M32: long = 4294967295

let SHA_K: []long = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

let MD5_K: []long = [
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
]

let MD5_S: []long = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
]

let HEX_DIGITS = "0123456789abcdef"
let B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
let B64URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// ---------------------------------------------------------------------------
// Bytes in and out of text
// ---------------------------------------------------------------------------

// The bytes of `data`, each as a number from 0 to 255.
pub func to_bytes(data: text) -> []long
    var out: []long = []
    for i in 0..data.len
        out.add(long(data.byte(i)))
    end
    return out
end

// A text whose bytes are the numbers in `bs` (each taken modulo 256).
pub func from_bytes(bs: []long) -> text
    let n = bs.len
    if n == 0
        return ""
    end
    let buf = sys.buffer(long(n))
    unsafe
        for i in 0..n
            buf.ptr[i] = u8(bs[i] bitand 255)
        end
    end
    var out = ""
    unsafe
        out = c.from_bytes(buf.ptr, long(n))
    end
    return out
end

func rotr(x: long, n: long) -> long
    return ((x >> n) bitor (x << (32 - n))) bitand M32
end

func rotl(x: long, n: long) -> long
    return ((x << n) bitor (x >> (32 - n))) bitand M32
end

func be32(s: text, at: int) -> long
    return (long(s.byte(at)) << 24) bitor (long(s.byte(at + 1)) << 16) bitor (long(s.byte(at + 2)) << 8) bitor long(s.byte(at + 3))
end

func le32(s: text, at: int) -> long
    return (long(s.byte(at + 3)) << 24) bitor (long(s.byte(at + 2)) << 16) bitor (long(s.byte(at + 1)) << 8) bitor long(s.byte(at))
end

func push_be32(ref out: []long, v: long)
    out.add((v >> 24) bitand 255)
    out.add((v >> 16) bitand 255)
    out.add((v >> 8) bitand 255)
    out.add(v bitand 255)
end

func push_le32(ref out: []long, v: long)
    out.add(v bitand 255)
    out.add((v >> 8) bitand 255)
    out.add((v >> 16) bitand 255)
    out.add((v >> 24) bitand 255)
end

// ---------------------------------------------------------------------------
// SHA-256
// ---------------------------------------------------------------------------

// A SHA-256 computation in progress: `add` data in pieces, then `finish`.
pub type Sha256 = record
    h: []long
    w: []long
    pending: text
    total: long
end

// A new SHA-256 computation.
pub func sha256_new() -> Sha256
    var w: []long = []
    for i in 0..64
        w.add(0)
    end
    return Sha256 { h: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19], w: w, pending: "", total: 0 }
end

func sha_block(ref st: Sha256, s: text, off: int)
    for i in 0..16
        st.w[i] = be32(s, off + i * 4)
    end
    for i in 16..64
        let w15 = st.w[i - 15]
        let w2 = st.w[i - 2]
        let s0 = rotr(w15, 7) bitxor rotr(w15, 18) bitxor (w15 >> 3)
        let s1 = rotr(w2, 17) bitxor rotr(w2, 19) bitxor (w2 >> 10)
        st.w[i] = (st.w[i - 16] + s0 + st.w[i - 7] + s1) bitand M32
    end
    var a = st.h[0]
    var b = st.h[1]
    var c2 = st.h[2]
    var d = st.h[3]
    var e = st.h[4]
    var f = st.h[5]
    var g = st.h[6]
    var h = st.h[7]
    for i in 0..64
        let big1 = rotr(e, 6) bitxor rotr(e, 11) bitxor rotr(e, 25)
        let ch = (e bitand f) bitxor ((bitnot e) bitand g)
        let t1 = (h + big1 + ch + SHA_K[i] + st.w[i]) bitand M32
        let big0 = rotr(a, 2) bitxor rotr(a, 13) bitxor rotr(a, 22)
        let maj = (a bitand b) bitxor (a bitand c2) bitxor (b bitand c2)
        let t2 = (big0 + maj) bitand M32
        h = g
        g = f
        f = e
        e = (d + t1) bitand M32
        d = c2
        c2 = b
        b = a
        a = (t1 + t2) bitand M32
    end
    st.h[0] = (st.h[0] + a) bitand M32
    st.h[1] = (st.h[1] + b) bitand M32
    st.h[2] = (st.h[2] + c2) bitand M32
    st.h[3] = (st.h[3] + d) bitand M32
    st.h[4] = (st.h[4] + e) bitand M32
    st.h[5] = (st.h[5] + f) bitand M32
    st.h[6] = (st.h[6] + g) bitand M32
    st.h[7] = (st.h[7] + h) bitand M32
end

// Feeds more data (any length, including empty).
pub func (ref st: Sha256) add(data: text)
    st.total += long(data.len)
    var pos = 0
    if st.pending.len > 0
        let need = 64 - st.pending.len
        if data.len < need
            st.pending = st.pending + data
            return
        end
        let block = st.pending + data.__raw_slice(0, need)
        sha_block(ref st, block, 0)
        st.pending = ""
        pos = need
    end
    while data.len - pos >= 64
        sha_block(ref st, data, pos)
        pos += 64
    end
    if pos < data.len
        st.pending = data.__raw_slice(pos, data.len)
    end
end

// The 32-byte digest of everything added. The computation cannot be used afterwards.
pub func (ref st: Sha256) finish() -> text
    let bits = st.total * 8
    var tail = to_bytes(st.pending)
    tail.add(128)
    while tail.len % 64 != 56
        tail.add(0)
    end
    push_be32(ref tail, (bits >> 32) bitand M32)
    push_be32(ref tail, bits bitand M32)
    let t = from_bytes(tail)
    var i = 0
    while i < t.len
        sha_block(ref st, t, i)
        i += 64
    end
    st.pending = ""
    var out: []long = []
    for k in 0..8
        push_be32(ref out, st.h[k])
    end
    return from_bytes(out)
end

// The SHA-256 digest of `data`: 32 bytes.
pub func sha256(data: text) -> text
    var st = sha256_new()
    st.add(data)
    return st.finish()
end

// ---------------------------------------------------------------------------
// HMAC-SHA-256 and PBKDF2
// ---------------------------------------------------------------------------

func hmac_pads(key: text) -> []text
    var k = key
    if k.len > 64
        k = sha256(k)
    end
    let kb = to_bytes(k)
    var ipad: []long = []
    var opad: []long = []
    for i in 0..64
        var v: long = 0
        if i < kb.len
            v = kb[i]
        end
        ipad.add(v bitxor 54)
        opad.add(v bitxor 92)
    end
    return [from_bytes(ipad), from_bytes(opad)]
end

// HMAC-SHA-256 of `data` under `key`: 32 bytes.
pub func hmac_sha256(key: text, data: text) -> text
    let pads = hmac_pads(key)
    var inner = sha256_new()
    inner.add(pads[0])
    inner.add(data)
    let ih = inner.finish()
    var outer = sha256_new()
    outer.add(pads[1])
    outer.add(ih)
    return outer.finish()
end

// PBKDF2 with HMAC-SHA-256: `length` bytes derived from `password` and `salt` with `iterations`
// rounds. An error when `iterations` or `length` is not positive.
pub func pbkdf2_sha256(password: text, salt: text, iterations: int, length: int) -> text or error
    if iterations < 1 or length < 1
        return error(errors.InvalidInput, "pbkdf2: iterations and length must be positive")
    end
    let pads = hmac_pads(password)
    var istate = sha256_new()
    istate.add(pads[0])
    var ostate = sha256_new()
    ostate.add(pads[1])
    var out: []long = []
    var block = 1
    while out.len < length
        var inner = istate
        inner.add(salt)
        var cnt: []long = []
        push_be32(ref cnt, long(block))
        inner.add(from_bytes(cnt))
        var outer = ostate
        outer.add(inner.finish())
        var u = outer.finish()
        var acc = to_bytes(u)
        for it in 1..iterations
            var i2 = istate
            i2.add(u)
            var o2 = ostate
            o2.add(i2.finish())
            u = o2.finish()
            for k in 0..32
                acc[k] = acc[k] bitxor long(u.byte(k))
            end
        end
        for k in 0..32
            out.add(acc[k])
        end
        block += 1
    end
    var cut: []long = []
    for k in 0..length
        cut.add(out[k])
    end
    return from_bytes(cut)
end

// ---------------------------------------------------------------------------
// MD5 (legacy protocols only)
// ---------------------------------------------------------------------------

// The MD5 digest of `data`: 16 bytes. Broken for security; only for protocols that require it.
pub func md5(data: text) -> text
    let bits = long(data.len) * 8
    var tail = to_bytes(data)
    tail.add(128)
    while tail.len % 64 != 56
        tail.add(0)
    end
    push_le32(ref tail, bits bitand M32)
    push_le32(ref tail, (bits >> 32) bitand M32)
    let t = from_bytes(tail)
    var a0: long = 0x67452301
    var b0: long = 0xefcdab89
    var c0: long = 0x98badcfe
    var d0: long = 0x10325476
    var pos = 0
    var m: []long = []
    for i in 0..16
        m.add(0)
    end
    while pos < t.len
        for i in 0..16
            m[i] = le32(t, pos + i * 4)
        end
        var a = a0
        var b = b0
        var c2 = c0
        var d = d0
        for i in 0..64
            var f: long = 0
            var g = 0
            if i < 16
                f = (b bitand c2) bitor ((bitnot b) bitand d)
                g = i
            else if i < 32
                f = (d bitand b) bitor ((bitnot d) bitand c2)
                g = (5 * i + 1) % 16
            else if i < 48
                f = b bitxor c2 bitxor d
                g = (3 * i + 5) % 16
            else
                f = c2 bitxor (b bitor ((bitnot d) bitand M32))
                g = (7 * i) % 16
            end
            f = (f + a + MD5_K[i] + m[g]) bitand M32
            a = d
            d = c2
            c2 = b
            b = (b + rotl(f, MD5_S[i])) bitand M32
        end
        a0 = (a0 + a) bitand M32
        b0 = (b0 + b) bitand M32
        c0 = (c0 + c2) bitand M32
        d0 = (d0 + d) bitand M32
        pos += 64
    end
    var out: []long = []
    push_le32(ref out, a0)
    push_le32(ref out, b0)
    push_le32(ref out, c0)
    push_le32(ref out, d0)
    return from_bytes(out)
end

// ---------------------------------------------------------------------------
// Hex and base64
// ---------------------------------------------------------------------------

// Lower-case hexadecimal of the bytes of `data`.
pub func hex(data: text) -> text
    var parts: []text = []
    for i in 0..data.len
        let b = int(data.byte(i))
        parts.add(HEX_DIGITS.slice(b / 16, b / 16 + 1) + HEX_DIGITS.slice(b % 16, b % 16 + 1))
    end
    return text.join(parts, "")
end

func hex_value(b: int) -> int
    if b >= 48 and b <= 57
        return b - 48
    end
    if b >= 97 and b <= 102
        return b - 87
    end
    if b >= 65 and b <= 70
        return b - 55
    end
    return -1
end

// The bytes written as hexadecimal (either case). An error for an odd length or a bad digit.
pub func unhex(s: text) -> text or error
    if s.len % 2 != 0
        return error(errors.InvalidInput, "hex: odd number of digits")
    end
    var out: []long = []
    var i = 0
    while i < s.len
        let hi = hex_value(int(s.byte(i)))
        let lo = hex_value(int(s.byte(i + 1)))
        if hi < 0 or lo < 0
            return error(errors.InvalidInput, "hex: bad digit at byte {i}")
        end
        out.add(long(hi * 16 + lo))
        i += 2
    end
    return from_bytes(out)
end

func b64_encode(data: text, alphabet: text, pad: bool) -> text
    var parts: []text = []
    var i = 0
    let n = data.len
    while i < n
        let b0 = int(data.byte(i))
        var b1 = 0
        var b2 = 0
        if i + 1 < n
            b1 = int(data.byte(i + 1))
        end
        if i + 2 < n
            b2 = int(data.byte(i + 2))
        end
        let v = b0 * 65536 + b1 * 256 + b2
        parts.add(alphabet.slice((v / 262144) % 64, (v / 262144) % 64 + 1))
        parts.add(alphabet.slice((v / 4096) % 64, (v / 4096) % 64 + 1))
        if i + 1 < n
            parts.add(alphabet.slice((v / 64) % 64, (v / 64) % 64 + 1))
        else if pad
            parts.add("=")
        end
        if i + 2 < n
            parts.add(alphabet.slice(v % 64, v % 64 + 1))
        else if pad
            parts.add("=")
        end
        i += 3
    end
    return text.join(parts, "")
end

func b64_value(b: int, url: bool) -> int
    if b >= 65 and b <= 90
        return b - 65
    end
    if b >= 97 and b <= 122
        return b - 71
    end
    if b >= 48 and b <= 57
        return b + 4
    end
    if url
        if b == 45
            return 62
        end
        if b == 95
            return 63
        end
    else
        if b == 43
            return 62
        end
        if b == 47
            return 63
        end
    end
    return -1
end

func b64_decode(s: text, url: bool, pad: bool) -> text or error
    var n = s.len
    var padding = 0
    if pad
        if n % 4 != 0
            return error(errors.InvalidInput, "base64: length is not a multiple of 4")
        end
        if n > 0 and s.byte(n - 1) == 61
            padding = 1
            if s.byte(n - 2) == 61
                padding = 2
            end
        end
        n -= padding
    else
        if n % 4 == 1
            return error(errors.InvalidInput, "base64: bad length")
        end
    end
    var out: []long = []
    var acc = 0
    var bits = 0
    for i in 0..n
        let v = b64_value(int(s.byte(i)), url)
        if v < 0
            return error(errors.InvalidInput, "base64: bad character at byte {i}")
        end
        acc = (acc * 64 + v) % 16777216
        bits += 6
        if bits >= 8
            bits -= 8
            out.add(long((acc / (1 << bits)) % 256))
        end
    end
    // leftover bits of the last group must be zero (canonical encoding)
    if bits > 0 and (acc % (1 << bits)) != 0
        return error(errors.InvalidInput, "base64: bad trailing bits")
    end
    return from_bytes(out)
end

// Base64 (RFC 4648, standard alphabet, with `=` padding) of the bytes of `data`.
pub func base64_encode(data: text) -> text
    return b64_encode(data, B64, true)
end

// The bytes of standard base64 text. An error for a bad character, length or padding.
pub func base64_decode(s: text) -> text or error
    return b64_decode(s, false, true)
end

// URL-safe base64 (`-` and `_`) without padding.
pub func base64url_encode(data: text) -> text
    return b64_encode(data, B64URL, false)
end

// The bytes of URL-safe base64 text without padding. An error for a bad character or length.
pub func base64url_decode(s: text) -> text or error
    return b64_decode(s, true, false)
end

// ---------------------------------------------------------------------------
// Comparison and randomness
// ---------------------------------------------------------------------------

// True when `a` and `b` have the same bytes. The time depends on the lengths only, not on where
// the first difference is: use it to compare secrets, tokens and MACs.
pub func equal(a: text, b: text) -> bool
    if a.len != b.len
        return false
    end
    var diff = 0
    for i in 0..a.len
        diff = diff bitor (int(a.byte(i)) bitxor int(b.byte(i)))
    end
    return diff == 0
end

// `n` random bytes from the operating system's secure generator (BCryptGenRandom on Windows,
// getrandom on Linux). An error if it is unavailable; there is no fallback to a weaker source.
pub func random(n: int) -> text or error
    if n < 0
        return error(errors.InvalidInput, "random: negative length")
    end
    if n == 0
        return ""
    end
    let buf = sys.buffer(long(n))
    var ok = false
    unsafe
        ok = sys.random_fill(buf.ptr, long(n))
    end
    if not ok
        return error(errors.Unavailable, "random: the operating system could not provide random bytes")
    end
    var out = ""
    unsafe
        out = c.from_bytes(buf.ptr, long(n))
    end
    return out
end
