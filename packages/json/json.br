// =====================================================================
// Zila Lang standard library: json
//
//     use json
//
//     type Config = record
//         port: int
//         #[json("host_name")] host: text
//         #[json(skip)] cache: text
//         proxy: text?
//     end
//
//     let cfg = json.parse(Config, "{\"port\": 8080, \"host_name\": \"example.org\"}")
//     let out = json.encode(Config, cfg)               // or json.encode<Config>(cfg)
//     let tree = json.parse_value("[1, {\"a\": null}]")  // a dynamic json.Value
//     print(json.stringify_with(tree, json.Options { indent: 2 }))
//
// JSON as a library: there is no JSON code in the compiler. `parse` and `encode` are #[generated]
// functions: for each type they are called with, the comptime functions at the end of this file
// read the type through `reflect` (fields, attributes, enum cases, element types) and write the
// decoder or encoder for it. Everything else is ordinary Zila Lang: the scanner, the string and
// number rules, the writer.
//
// The public surface is `Value`, `Options`, `parse_value`, `stringify`, `stringify_with`, `parse`,
// `encode` and `encode_with`. The functions and types whose names start with `__` are what the
// generated code calls; they are public only because that code is compiled in the program that
// asked for it. Do not call them.
//
// Rules: strict RFC 8259 (no comments, trailing commas, leading zeros, NaN); text is UTF-8 and
// invalid UTF-8 is an error; integers never wrap or round; nesting deeper than 128 levels is an
// error; typed decoding rejects duplicate keys, `Value` keeps the last; errors have the kind
// InvalidInput and say where: `at line L, column C` for syntax, `at $.users[2].email` for types.
// =====================================================================

package json

use errors
use reflect
use text

// A JSON document as a tree. `Number` holds the value and the literal it was read from, so a
// number that is not changed prints exactly as it was written (even beyond 2^53). A number built
// by hand uses the empty text as its literal, and prints as the shortest text of its float.
pub type Value = enum
    Null
    Bool(bool)
    Number(float, text)
    Text(text)
    List([]Value)
    Object(Map<text, Value>)
end

// How to print: `indent` is the number of spaces per level, 0 meaning compact.
pub type Options = record
    pub indent: int
end

// The reader: the text, the position, the nesting depth and the path to the value being decoded
// (a key or an index per level, only turned into text when an error needs it).
pub type State = record
    s: text
    pos: int
    depth: int
    keys: []text
    idx: []int
    top: int
end

// The writer: the pieces written so far, and where we are in the nesting.
pub type Out = record
    parts: []text
    depth: int
    indent: int
    counts: []int
end

let max_depth = 128

// ---- the public surface ----

// Reads one JSON document into a tree.
pub func parse_value(s: text) -> Value or error
    var st = __scan(s)
    let v = try __value(ref st)
    try __finish(ref st)
    return v
end

// The compact text of a tree.
pub func stringify(v: Value) -> text or error
    return try stringify_with(v, Options { indent: 0 })
end

// The text of a tree, indented by `opts.indent` spaces per level (0 is compact).
pub func stringify_with(v: Value, opts: Options) -> text or error
    var o = __out(opts.indent)
    try __w_value(ref o, v)
    return __done(ref o)
end

// Reads `s` as a value of type `T`: `json.parse(Config, s)`.
#[generated(parse_gen)]
pub func parse(comptime t: Type, s: text) -> t or error

// The compact JSON text of `x`: `json.encode(Config, x)` or `json.encode<Config>(x)`.
#[generated(encode_gen)]
pub func encode(comptime t: Type, x: t) -> text or error

// Like `encode`, indented by `opts.indent` spaces per level.
#[generated(encode_with_gen)]
pub func encode_with(comptime t: Type, x: t, opts: Options) -> text or error

// What the generated code decodes and encodes one type with.
#[generated(dec_gen)]
pub func __dec(comptime t: Type, ref st: State) -> t or error

#[generated(enc_gen)]
pub func __enc(comptime t: Type, x: t, ref o: Out) -> bool or error

// ---- errors ----

// `line L, column C` of byte position `pos` (the column counts characters).
func place(s: text, pos: int) -> text
    var line = 1
    var col = 1
    let n = if pos < s.len pos else s.len end
    var i = 0
    while i < n
        let b = int(s.byte(i))
        if b == 10
            line += 1
            col = 1
        else if (b bitand 192) != 128
            col += 1
        end
        i += 1
    end
    return "line {line}, column {col}"
end

func syntax(ref st: State, what: text, pos: int) -> text
    return "{what} at {place(st.s, pos)}"
end

func path_text(ref st: State) -> text
    let parts: []text = ["$"]
    for i in 0..st.top
        if st.idx[i] >= 0
            parts.add("[{st.idx[i]}]")
        else
            parts.add("." + st.keys[i])
        end
    end
    return concat_all(parts)
end

// ---- reading ----

pub func __scan(s: text) -> State
    return State { s: s, pos: 0, depth: 0, keys: [], idx: [], top: 0 }
end

func at(ref st: State) -> int
    if st.pos >= st.s.len
        return -1
    end
    return int(st.s.byte(st.pos))
end

func ws(ref st: State)
    let n = st.s.len
    var i = st.pos
    while i < n
        let b = int(st.s.byte(i))
        if b == 32 or b == 10 or b == 13 or b == 9
            i += 1
        else
            break
        end
    end
    st.pos = i
end

// The length of the UTF-8 sequence that starts at `i` (1 to 4), or 0 when it is not valid: a bad
// lead byte, a missing or wrong continuation byte, an overlong form, a surrogate or a value above
// U+10FFFF.
func utf8_len(s: text, i: int) -> int
    let n = s.len
    let lead = int(s.byte(i))
    if lead < 128
        return 1
    end
    var more = 0
    var cp = lead
    var least = 0
    if lead >= 194 and lead <= 223
        more = 1
        cp = lead - 192
        least = 128
    else if lead >= 224 and lead <= 239
        more = 2
        cp = lead - 224
        least = 2048
    else if lead >= 240 and lead <= 244
        more = 3
        cp = lead - 240
        least = 65536
    else
        return 0
    end
    if i + more >= n
        return 0
    end
    for k in 1..more + 1
        let d = int(s.byte(i + k))
        if d < 128 or d > 191
            return 0
        end
        cp = cp * 64 + (d - 128)
    end
    if cp < least or cp > 1114111 or (cp >= 55296 and cp <= 57343)
        return 0
    end
    return more + 1
end

// What the next value is called in messages, or "" when no value can start here.
func class_of(c: int) -> text
    if c == 34
        return "text"
    else if c == 123
        return "object"
    else if c == 91
        return "list"
    else if c == 116 or c == 102
        return "bool"
    else if c == 110
        return "null"
    else if c == 45 or (c >= 48 and c <= 57)
        return "number"
    end
    return ""
end

// The message for a value that is not what the target type wants (or is not JSON at all).
pub func __mismatch(ref st: State, want: text) -> text
    ws(ref st)
    let c = at(ref st)
    if c == -1
        return syntax(ref st, "unexpected end of input", st.pos)
    end
    let found = class_of(c)
    if found == ""
        return syntax(ref st, "unexpected {shown(st.s, st.pos)}", st.pos)
    end
    return "expected {want}, found {found} at {path_text(ref st)}"
end

func shown(s: text, pos: int) -> text
    let k = utf8_len(s, pos)
    if k == 0
        return "byte {int(s.byte(pos))}"
    end
    if k == 1 and int(s.byte(pos)) < 32
        return "control character {int(s.byte(pos))}"
    end
    return "'{s.slice(pos, pos + k)}'"
end

// Every helper below that can only fail (it exists to give the generated code an error to
// `try`) returns `bool or error` and never the value.
pub func __type_error(ref st: State, want: text) -> bool or error
    return error(errors.InvalidInput, __mismatch(ref st, want))
end

pub func __missing(ref st: State, name: text) -> bool or error
    return error(errors.InvalidInput, "missing field \"{name}\" at {path_text(ref st)}")
end

pub func __dup(ref st: State, name: text) -> bool or error
    return error(errors.InvalidInput, "duplicate key \"{name}\" at {path_text(ref st)}")
end

pub func __unknown_case(ref st: State, name: text, ty: text) -> bool or error
    return error(errors.InvalidInput, "unknown case \"{name}\" of {ty} at {path_text(ref st)}")
end

pub func __one_key(ref st: State) -> bool or error
    return error(errors.InvalidInput, "expected an object with exactly one key at {path_text(ref st)}")
end

pub func __arity(ref st: State, n: int) -> bool or error
    return error(errors.InvalidInput, "expected a list of {n} values at {path_text(ref st)}")
end

// ---- the path ----

// The path is a stack in two lists with a height: popping only lowers the height.
func push(ref st: State, k: text, i: int)
    if st.top == st.keys.len
        st.keys.add(k)
        st.idx.add(i)
    else
        st.keys[st.top] = k
        st.idx[st.top] = i
    end
    st.top += 1
end

pub func __push_key(ref st: State, k: text)
    push(ref st, k, -1)
end

pub func __push_idx(ref st: State, i: int)
    push(ref st, "", i)
end

pub func __pop(ref st: State)
    st.top -= 1
end

pub func __skip_space(ref st: State)
    ws(ref st)
end

// The byte at the cursor, or -1 at the end.
pub func __peek(ref st: State) -> int
    return at(ref st)
end

// ---- structure ----

// Starts a list (`[`) or an object (`{`); the byte code of the opener is `open`.
pub func __open(ref st: State, open: int, want: text) -> bool or error
    ws(ref st)
    if at(ref st) != open
        return error(errors.InvalidInput, __mismatch(ref st, want))
    end
    if st.depth >= max_depth
        return error(errors.InvalidInput, syntax(ref st, "nesting is deeper than the limit of {max_depth} levels", st.pos))
    end
    st.pos += 1
    st.depth += 1
    return true
end

// Is there another item? `n` is how many were read; `close` is the byte code of `]` or `}`.
// Takes the comma before the item, or the closer after the last one.
pub func __more(ref st: State, close: int, n: int) -> bool or error
    ws(ref st)
    let c = at(ref st)
    if c == close
        st.pos += 1
        st.depth -= 1
        return false
    end
    if n == 0
        return true
    end
    if c == 44
        st.pos += 1
        ws(ref st)
        return true
    end
    if c == -1
        return error(errors.InvalidInput, syntax(ref st, "unexpected end of input", st.pos))
    end
    var closer = "']'"
    if close == 125
        closer = "'}'"
    end
    return error(errors.InvalidInput, syntax(ref st, "expected ',' or {closer}, found {shown(st.s, st.pos)}", st.pos))
end

// The key of the next member, with the colon after it.
pub func __key(ref st: State) -> text or error
    ws(ref st)
    if at(ref st) != 34
        if at(ref st) == -1
            return error(errors.InvalidInput, syntax(ref st, "unexpected end of input", st.pos))
        end
        return error(errors.InvalidInput, syntax(ref st, "expected a text key, found {shown(st.s, st.pos)}", st.pos))
    end
    let k = try __text(ref st)
    ws(ref st)
    if at(ref st) != 58
        if at(ref st) == -1
            return error(errors.InvalidInput, syntax(ref st, "unexpected end of input", st.pos))
        end
        return error(errors.InvalidInput, syntax(ref st, "expected ':', found {shown(st.s, st.pos)}", st.pos))
    end
    st.pos += 1
    return k
end

// The document has ended: only white space is left.
pub func __finish(ref st: State) -> bool or error
    ws(ref st)
    if st.pos < st.s.len
        return error(errors.InvalidInput, syntax(ref st, "unexpected {shown(st.s, st.pos)} after the end of the value", st.pos))
    end
    return true
end

// ---- literals ----

func literal(ref st: State, word: text) -> bool or error
    let n = word.len
    if st.pos + n <= st.s.len and st.s.slice(st.pos, st.pos + n) == word
        st.pos += n
        return true
    end
    return error(errors.InvalidInput, syntax(ref st, "invalid literal, expected {word}", st.pos))
end

// Is the next value `null`? Takes it when it is.
pub func __null(ref st: State) -> bool or error
    ws(ref st)
    if at(ref st) == 110
        try literal(ref st, "null")
        return true
    end
    return false
end

pub func __bool(ref st: State) -> bool or error
    ws(ref st)
    let c = at(ref st)
    if c == 116
        try literal(ref st, "true")
        return true
    end
    if c == 102
        try literal(ref st, "false")
        return false
    end
    return error(errors.InvalidInput, __mismatch(ref st, "bool"))
end

// ---- text ----

func hex4(ref st: State, i: int) -> int or error
    if i + 4 > st.s.len
        return error(errors.InvalidInput, syntax(ref st, "unexpected end of input in a \\u escape", st.s.len))
    end
    var v = 0
    for k in 0..4
        let c = int(st.s.byte(i + k))
        var d = -1
        if c >= 48 and c <= 57
            d = c - 48
        else if c >= 97 and c <= 102
            d = c - 87
        else if c >= 65 and c <= 70
            d = c - 55
        end
        if d < 0
            return error(errors.InvalidInput, syntax(ref st, "invalid \\u escape", i + k))
        end
        v = v * 16 + d
    end
    return v
end

// A string (the next byte must be the opening quote), unescaped and checked as UTF-8.
pub func __text(ref st: State) -> text or error
    ws(ref st)
    if at(ref st) != 34
        return error(errors.InvalidInput, __mismatch(ref st, "text"))
    end
    let s = st.s
    let n = s.len
    var i = st.pos + 1
    var start = i
    let parts: []text = []
    while true
        if i >= n
            return error(errors.InvalidInput, syntax(ref st, "unterminated string", n))
        end
        let c = int(s.byte(i))
        if c == 34
            break
        end
        if c < 32
            return error(errors.InvalidInput, syntax(ref st, "unescaped control character in a string", i))
        end
        if c == 92
            if i > start
                parts.add(s.slice(start, i))
            end
            if i + 1 >= n
                return error(errors.InvalidInput, syntax(ref st, "unterminated string", n))
            end
            let e = int(s.byte(i + 1))
            i += 2
            if e == 34
                parts.add("\"")
            else if e == 92
                parts.add("\\")
            else if e == 47
                parts.add("/")
            else if e == 98
                parts.add(char(8).to_text())
            else if e == 102
                parts.add(char(12).to_text())
            else if e == 110
                parts.add("\n")
            else if e == 114
                parts.add("\r")
            else if e == 116
                parts.add("\t")
            else if e == 117
                var cp = try hex4(ref st, i)
                let at_escape = i - 2
                i += 4
                if cp >= 55296 and cp <= 56319
                    if i + 6 <= n and int(s.byte(i)) == 92 and int(s.byte(i + 1)) == 117
                        let low = try hex4(ref st, i + 2)
                        if low >= 56320 and low <= 57343
                            cp = 65536 + (cp - 55296) * 1024 + (low - 56320)
                            i += 6
                        else
                            return error(errors.InvalidInput, syntax(ref st, "unpaired surrogate in a \\u escape", at_escape))
                        end
                    else
                        return error(errors.InvalidInput, syntax(ref st, "unpaired surrogate in a \\u escape", at_escape))
                    end
                else if cp >= 56320 and cp <= 57343
                    return error(errors.InvalidInput, syntax(ref st, "unpaired surrogate in a \\u escape", at_escape))
                end
                parts.add(char(cp).to_text())
            else
                return error(errors.InvalidInput, syntax(ref st, "invalid escape \\{shown(s, i - 1)}", i - 2))
            end
            start = i
        else if c < 128
            i += 1
        else
            let k = utf8_len(s, i)
            if k == 0
                return error(errors.InvalidInput, syntax(ref st, "invalid UTF-8 in a string", i))
            end
            i += k
        end
    end
    st.pos = i + 1
    if parts.len == 0
        return s.slice(start, i)
    end
    if i > start
        parts.add(s.slice(start, i))
    end
    return concat_all(parts)
end

// ---- numbers ----

func is_digit(c: int) -> bool
    return c >= 48 and c <= 57
end

// Scans the number at the cursor by the RFC 8259 grammar and returns its literal.
func scan_number(ref st: State) -> text or error
    let s = st.s
    let n = s.len
    let start = st.pos
    var i = start
    if i < n and int(s.byte(i)) == 45
        i += 1
    end
    if i >= n or not is_digit(int(s.byte(i)))
        return error(errors.InvalidInput, syntax(ref st, "invalid number", i))
    end
    if int(s.byte(i)) == 48
        i += 1
        if i < n and is_digit(int(s.byte(i)))
            return error(errors.InvalidInput, syntax(ref st, "leading zeros are not allowed in numbers", i))
        end
    else
        while i < n and is_digit(int(s.byte(i)))
            i += 1
        end
    end
    if i < n and int(s.byte(i)) == 46
        i += 1
        if i >= n or not is_digit(int(s.byte(i)))
            return error(errors.InvalidInput, syntax(ref st, "invalid number: digits expected after the point", i))
        end
        while i < n and is_digit(int(s.byte(i)))
            i += 1
        end
    end
    if i < n and (int(s.byte(i)) == 101 or int(s.byte(i)) == 69)
        i += 1
        if i < n and (int(s.byte(i)) == 43 or int(s.byte(i)) == 45)
            i += 1
        end
        if i >= n or not is_digit(int(s.byte(i)))
            return error(errors.InvalidInput, syntax(ref st, "invalid number: digits expected in the exponent", i))
        end
        while i < n and is_digit(int(s.byte(i)))
            i += 1
        end
    end
    st.pos = i
    return s.slice(start, i)
end

// The digits of the integer value of the literal `lit`, without sign or leading zeros ("0" for
// zero); "" when the value is not an integer. A value with more than 20 digits comes back as 21
// nines, which no integer type holds. Works on the digits, never through a float.
func integral(lit: text) -> text
    let n = lit.len
    var i = 0
    if int(lit.byte(0)) == 45
        i = 1
    end
    var whole = ""
    var frac = ""
    var exp = 0
    var j = i
    while j < n and is_digit(int(lit.byte(j)))
        j += 1
    end
    whole = lit.slice(i, j)
    if j < n and int(lit.byte(j)) == 46
        let from = j + 1
        j = from
        while j < n and is_digit(int(lit.byte(j)))
            j += 1
        end
        frac = lit.slice(from, j)
    end
    if j < n
        j += 1
        var eneg = false
        if int(lit.byte(j)) == 45
            eneg = true
            j += 1
        else if int(lit.byte(j)) == 43
            j += 1
        end
        while j < n
            if exp < 100000
                exp = exp * 10 + (int(lit.byte(j)) - 48)
            end
            j += 1
        end
        if eneg
            exp = 0 - exp
        end
    end
    var digits = whole + frac
    var e10 = exp - frac.len
    // drop the leading zeros
    var lead = 0
    while lead < digits.len and int(digits.byte(lead)) == 48
        lead += 1
    end
    digits = digits.slice(lead, digits.len)
    if digits.len == 0
        return "0"
    end
    if e10 < 0
        let drop = 0 - e10
        if drop > digits.len
            return ""
        end
        var k = digits.len - drop
        while k < digits.len
            if int(digits.byte(k)) != 48
                return ""
            end
            k += 1
        end
        return digits.slice(0, digits.len - drop)
    end
    if digits.len + e10 > 20
        return "999999999999999999999"
    end
    return digits + text.repeat("0", e10)
end

// The integer in the next number, of `bits` bits, signed or not. An unsigned 64-bit value comes
// back as its bit pattern in a `long`.
pub func __int(ref st: State, bits: int, signed: bool, name: text) -> long or error
    ws(ref st)
    let c = at(ref st)
    if c != 45 and not is_digit(c)
        return error(errors.InvalidInput, __mismatch(ref st, name))
    end
    let lit = try scan_number(ref st)
    let digits = integral(lit)
    if digits == ""
        return error(errors.InvalidInput, "expected {name}, found the number {lit} at {path_text(ref st)}")
    end
    let neg = int(lit.byte(0)) == 45 and digits != "0"
    let big = "{lit} does not fit {name} at {path_text(ref st)}"
    if digits.len > 20
        return error(errors.InvalidInput, big)
    end
    if not signed and bits == 64
        if neg or (digits.len == 20 and digits > "18446744073709551615")
            return error(errors.InvalidInput, big)
        end
        var u: long = 0
        for k in 0..digits.len
            u = u * 10 + long(int(digits.byte(k)) - 48)
        end
        return u
    end
    var lo: long = 0
    var hi: long = 0
    if signed
        if bits == 64
            hi = 9223372036854775807
            lo = 0 - hi - 1
        else
            hi = (long(1) << (bits - 1)) - 1
            lo = 0 - hi - 1
        end
    else
        hi = (long(1) << bits) - 1
    end
    if neg and lo == 0
        return error(errors.InvalidInput, big)
    end
    let bound = if neg lo else 0 - hi end
    var acc: long = 0
    for k in 0..digits.len
        let d = long(int(digits.byte(k)) - 48)
        if acc < (bound + d) / 10
            return error(errors.InvalidInput, big)
        end
        acc = acc * 10 - d
    end
    if neg
        return acc
    end
    return 0 - acc
end

pub func __float(ref st: State) -> float or error
    ws(ref st)
    let c = at(ref st)
    if c != 45 and not is_digit(c)
        return error(errors.InvalidInput, __mismatch(ref st, "number"))
    end
    let lit = try scan_number(ref st)
    return try text.parse_float(lit)
end

// ---- skipping and trees ----

// Reads past one value, checking its syntax and depth.
pub func __skip(ref st: State) -> bool or error
    ws(ref st)
    let c = at(ref st)
    if c == 123
        try __open(ref st, 123, "object")
        var n = 0
        while true
            let go = try __more(ref st, 125, n)
            if not go
                break
            end
            n += 1
            try __key(ref st)
            try __skip(ref st)
        end
        return true
    else if c == 91
        try __open(ref st, 91, "list")
        var n = 0
        while true
            let go = try __more(ref st, 93, n)
            if not go
                break
            end
            n += 1
            try __skip(ref st)
        end
        return true
    else if c == 34
        try __text(ref st)
        return true
    else if c == 116 or c == 102
        try __bool(ref st)
        return true
    else if c == 110
        try literal(ref st, "null")
        return true
    else if c == 45 or is_digit(c)
        try scan_number(ref st)
        return true
    end
    return error(errors.InvalidInput, __mismatch(ref st, "a value"))
end

pub func __null_value() -> Value
    return Null
end

// The next value as a tree. A key that appears twice keeps the last value, at the place of the
// first.
pub func __value(ref st: State) -> Value or error
    ws(ref st)
    let c = at(ref st)
    if c == 123
        try __open(ref st, 123, "object")
        let m: Map<text, Value> = {}
        var n = 0
        while true
            let go = try __more(ref st, 125, n)
            if not go
                break
            end
            n += 1
            let k = try __key(ref st)
            m[k] = try __value(ref st)
        end
        return Object(m)
    else if c == 91
        try __open(ref st, 91, "list")
        let xs: []Value = []
        var n = 0
        while true
            let go = try __more(ref st, 93, n)
            if not go
                break
            end
            n += 1
            xs.add(try __value(ref st))
        end
        return List(xs)
    else if c == 34
        let t = try __text(ref st)
        return Text(t)
    else if c == 116
        try literal(ref st, "true")
        return Bool(true)
    else if c == 102
        try literal(ref st, "false")
        return Bool(false)
    else if c == 110
        try literal(ref st, "null")
        return Null
    else if c == 45 or is_digit(c)
        let lit = try scan_number(ref st)
        let f = try text.parse_float(lit)
        return Number(f, lit)
    end
    return error(errors.InvalidInput, __mismatch(ref st, "a value"))
end

// ---- writing ----

// All the parts one after another, joined in pairs so the cost stays proportional to
// (total bytes) * log(parts).
func concat_all(parts: []text) -> text
    if parts.len == 0
        return ""
    end
    var cur = parts
    while cur.len > 1
        let next: []text = []
        var i = 0
        while i + 1 < cur.len
            next.add(cur[i] + cur[i + 1])
            i += 2
        end
        if i < cur.len
            next.add(cur[i])
        end
        cur = next
    end
    return cur[0]
end

pub func __out(indent: int) -> Out
    return Out { parts: [], depth: 0, indent: indent, counts: [] }
end

pub func __done(ref o: Out) -> text
    return concat_all(o.parts)
end

func newline(ref o: Out, levels: int)
    o.parts.add("\n")
    if o.indent > 0 and levels > 0
        o.parts.add(text.repeat(" ", levels * o.indent))
    end
end

// Opens a list or an object (`opener` is `[` or `{`).
pub func __open_c(ref o: Out, opener: text) -> bool or error
    if o.depth >= max_depth
        return error(errors.InvalidInput, "nesting is deeper than the limit of {max_depth} levels")
    end
    if o.counts.len <= o.depth
        o.counts.add(0)
    else
        o.counts[o.depth] = 0
    end
    o.depth += 1
    o.parts.add(opener)
    return true
end

pub func __open_obj(ref o: Out) -> bool or error
    return __open_c(ref o, "\{")
end

pub func __open_list(ref o: Out) -> bool or error
    return __open_c(ref o, "[")
end

pub func __close_obj(ref o: Out)
    __close_c(ref o, "\}")
end

pub func __close_list(ref o: Out)
    __close_c(ref o, "]")
end

// Before an item or member: the comma, and the new line when indenting.
pub func __sep(ref o: Out)
    let k = o.depth - 1
    o.counts[k] = o.counts[k] + 1
    if o.counts[k] > 1
        o.parts.add(",")
    end
    if o.indent > 0
        newline(ref o, o.depth)
    end
end

pub func __close_c(ref o: Out, closer: text)
    let n = o.counts[o.depth - 1]
    o.depth -= 1
    if n > 0 and o.indent > 0
        newline(ref o, o.depth)
    end
    o.parts.add(closer)
end

func control_escape(c: int) -> text
    if c == 8
        return "\\b"
    else if c == 12
        return "\\f"
    else if c == 10
        return "\\n"
    else if c == 13
        return "\\r"
    else if c == 9
        return "\\t"
    end
    let hex = "0123456789abcdef"
    return "\\u00" + hex.slice(c / 16, c / 16 + 1) + hex.slice(c % 16, c % 16 + 1)
end

// A string with its quotes: runs that need no escape are copied whole.
pub func __w_str(ref o: Out, s: text)
    o.parts.add("\"")
    let n = s.len
    var start = 0
    var i = 0
    while i < n
        let c = int(s.byte(i))
        if c < 32 or c == 34 or c == 92
            if i > start
                o.parts.add(s.slice(start, i))
            end
            if c == 34
                o.parts.add("\\\"")
            else if c == 92
                o.parts.add("\\\\")
            else
                o.parts.add(control_escape(c))
            end
            start = i + 1
        end
        i += 1
    end
    if n > start
        o.parts.add(s.slice(start, n))
    end
    o.parts.add("\"")
end

// A member name and the colon after it.
pub func __key_w(ref o: Out, k: text)
    __w_str(ref o, k)
    if o.indent > 0
        o.parts.add(": ")
    else
        o.parts.add(":")
    end
end

pub func __w_null(ref o: Out)
    o.parts.add("null")
end

pub func __w_bool(ref o: Out, b: bool)
    if b
        o.parts.add("true")
    else
        o.parts.add("false")
    end
end

pub func __w_int(ref o: Out, n: long)
    o.parts.add("{n}")
end

// An unsigned 64-bit integer given as its bit pattern.
pub func __w_u64(ref o: Out, bits: long)
    if bits >= 0
        o.parts.add("{bits}")
        return
    end
    // 2^64 + bits = (bits bitand max) + 2^63, written in two halves of base 10^10
    let low = (bits >> 1) bitand 9223372036854775807
    let q = low / 5
    let rest = (bits bitand 1) + (low % 5) * 2
    // value = q * 10 + rest, with low = value / 2 rounded down: value = low * 2 + (bits bitand 1)
    let tens = q * 2 + rest / 10
    let unit = rest % 10
    o.parts.add("{tens}{unit}")
end

func finite(x: float) -> bool
    return x - x == 0.0
end

pub func __w_float(ref o: Out, x: float) -> bool or error
    if not finite(x)
        return error(errors.InvalidInput, "cannot encode a number that is not finite")
    end
    o.parts.add("{x}")
    return true
end

pub func __w_f32(ref o: Out, x: f32) -> bool or error
    let wide = float(x)
    if not finite(wide)
        return error(errors.InvalidInput, "cannot encode a number that is not finite")
    end
    o.parts.add("{x}")
    return true
end

// Does `lit` read as one JSON number?
func is_number(lit: text) -> bool
    if lit.len == 0
        return false
    end
    var st = __scan(lit)
    match scan_number(ref st)
        ok(l) -> return st.pos == lit.len
        err(e) -> return false
    end
end

pub func __w_value(ref o: Out, v: Value) -> bool or error
    match v
        Null -> __w_null(ref o)
        Bool(b) -> __w_bool(ref o, b)
        Number(f, lit) ->
            if is_number(lit)
                o.parts.add(lit)
            else
                try __w_float(ref o, f)
            end
        Text(t) -> __w_str(ref o, t)
        List(xs) ->
            try __open_c(ref o, "[")
            for x in xs
                __sep(ref o)
                try __w_value(ref o, x)
            end
            __close_c(ref o, "]")
        Object(m) ->
            try __open_c(ref o, "\{")
            for k, x in m
                __sep(ref o)
                __key_w(ref o, k)
                try __w_value(ref o, x)
            end
            __close_c(ref o, "\}")
    end
    return true
end

// ---- the generators ----
//
// Comptime code: it sees types, not values, and returns the Zila Lang source of a function body.

// What the generated code writes for the kind of `t`; the leaf kinds have an expression that
// decodes them, the others have a function (a specialization of `__dec`).
comptime func is_value(t: Type) -> bool
    let n = t.name()
    return n == "Value" or n == "json.Value"
end

comptime func int_name(name: text) -> text
    if name == "byte"
        return "u8"
    end
    return name
end

comptime func int_args(name: text) -> text
    if name == "i8"
        return "8, true"
    else if name == "i16"
        return "16, true"
    else if name == "i32" or name == "int"
        return "32, true"
    else if name == "i64" or name == "long" or name == "isize"
        return "64, true"
    else if name == "u8" or name == "byte"
        return "8, false"
    else if name == "u16"
        return "16, false"
    else if name == "u32"
        return "32, false"
    end
    return "64, false"
end

// The expression that decodes a leaf type, or "" when `t` is not one.
comptime func dec_leaf(t: Type) -> text
    let k = t.kind()
    let n = t.name()
    if k == "bool"
        return "try json.__bool(ref st)"
    else if k == "text"
        return "try json.__text(ref st)"
    else if k == "int"
        return "{int_name(n)}(try json.__int(ref st, {int_args(n)}, \"{n}\"))"
    else if k == "float"
        if n == "f32"
            return "f32(try json.__float(ref st))"
        end
        return "try json.__float(ref st)"
    else if is_value(t)
        return "try json.__value(ref st)"
    else if k == "alias"
        return dec_leaf(t.inner())
    end
    return ""
end

comptime func dec_expr(t: Type) -> text
    let leaf = dec_leaf(t)
    if leaf != ""
        return leaf
    end
    return "try json.__dec<{t.name()}>(ref st)"
end

comptime func enc_leaf(t: Type, v: text) -> text
    let k = t.kind()
    let n = t.name()
    if k == "bool"
        return "json.__w_bool(ref o, {v})"
    else if k == "text"
        return "json.__w_str(ref o, {v})"
    else if k == "int"
        if n == "u64" or n == "usize"
            return "json.__w_u64(ref o, long({v}))"
        end
        return "json.__w_int(ref o, long({v}))"
    else if k == "float"
        if n == "f32"
            return "try json.__w_f32(ref o, {v})"
        end
        return "try json.__w_float(ref o, {v})"
    else if is_value(t)
        return "try json.__w_value(ref o, {v})"
    else if k == "alias"
        return enc_leaf(t.inner(), v)
    end
    return ""
end

comptime func enc_expr(t: Type, v: text) -> text
    let leaf = enc_leaf(t, v)
    if leaf != ""
        return leaf
    end
    return "try json.__enc<{t.name()}>({v}, ref o)"
end

// The type is of a kind JSON has no form for.
comptime func unsupported(t: Type, what: text)
    let k = t.kind()
    let n = t.name()
    if k == "func" or k == "set" or k == "error" or k == "pointer"
        reflect.fail("json cannot {what} a value of type {n} (kind {k})", t)
    end
    if text.starts_with(n, "Rc<") or text.starts_with(n, "Weak<") or text.starts_with(n, "Future<") or text.starts_with(n, "Mutex<")
        reflect.fail("json cannot {what} a value of type {n}", t)
    end
end

// The JSON key of a field, "" when it is skipped. A `json` attribute holds one quoted key or the
// bare word `skip`; anything else is refused.
comptime func field_key(f: reflect.Field) -> text
    var key = f.name
    var seen = false
    for a in f.attrs
        if a.name == "json"
            if seen
                reflect.fail("field {f.name} has more than one json attribute", f)
            end
            seen = true
            if a.args.len != 1
                reflect.fail("the json attribute of field {f.name} takes one argument: a quoted key, or skip", f)
            end
            if not a.quoted[0]
                if a.args[0] == "skip"
                    return ""
                end
                reflect.fail("bad json attribute on field {f.name}: write json(\"key\") to rename it or json(skip) to leave it out", f)
            end
            if a.args[0] == ""
                reflect.fail("the json key of field {f.name} is empty", f)
            end
            key = a.args[0]
        end
    end
    return key
end

// Source text of a text literal holding `s`.
comptime func quote(s: text) -> text
    var out = "\""
    for c in s
        if c == '"'
            out = out + "\\\""
        else if c == '\\'
            out = out + "\\\\"
        else if c == '{'
            out = out + "\\\{"
        else if c == '}'
            out = out + "\\\}"
        else if c == '\n'
            out = out + "\\n"
        else if c == '\t'
            out = out + "\\t"
        else if c == '\r'
            out = out + "\\r"
        else
            out = out + c.to_text()
        end
    end
    return out + "\""
end

// The keys of a record's fields, checked: no two fields may resolve to the same key.
comptime func check_keys(t: Type)
    let seen: Map<text, text> = {}
    for f in t.fields()
        let key = field_key(f)
        if key != ""
            if seen.has(key)
                reflect.fail("the fields {seen[key]} and {f.name} of {t.name()} both use the json key \"{key}\"", f)
            end
            seen[key] = f.name
        end
    end
end

// The value a skipped field gets: the zero of its type.
comptime func zero_of(t: Type, f: reflect.Field, depth: int) -> text
    let k = t.kind()
    if depth > 6
        reflect.fail("json(skip) on field {f.name}: no zero value for {t.name()}", f)
    end
    if k == "int"
        return "0"
    else if k == "float"
        return "0.0"
    else if k == "bool"
        return "false"
    else if k == "text"
        return "\"\""
    else if k == "list"
        return "[]"
    else if k == "map"
        return "\{\}"
    else if k == "optional"
        return "nil"
    else if k == "alias"
        return zero_of(t.inner(), f, depth + 1)
    else if is_value(t)
        return "json.__null_value()"
    else if k == "record"
        var parts = ""
        for g in t.fields()
            if parts != ""
                parts = parts + ", "
            end
            parts = parts + "{g.name}: {zero_of(g.ty, f, depth + 1)}"
        end
        return "{t.name()} \{ {parts} \}"
    else if k == "enum"
        for v in t.variants()
            if v.fields.len == 0
                return v.name
            end
        end
        let v = t.variants()[0]
        var parts = ""
        for g in v.fields
            if parts != ""
                parts = parts + ", "
            end
            parts = parts + zero_of(g.ty, f, depth + 1)
        end
        return "{v.name}({parts})"
    end
    reflect.fail("json(skip) on field {f.name}: no zero value for {t.name()}", f)
    return ""
end

// A record is an object whose keys are its field names (or their json keys).
comptime func dec_record(t: Type) -> text
    check_keys(t)
    var out = "try json.__open(ref st, 123, \"object\")\n"
    var build = ""
    for f in t.fields()
        let key = field_key(f)
        if build != ""
            build = build + ", "
        end
        if key == ""
            build = build + "{f.name}: {zero_of(f.ty, f, 0)}"
        else
            unsupported(f.ty, "decode")
            if f.ty.kind() == "optional"
                out = out + "var v_{f.name}: {f.ty.name()} = nil\nvar s_{f.name} = false\n"
            else
                out = out + "var v_{f.name}: {f.ty.name()} = {zero_of(f.ty, f, 0)}\nvar s_{f.name} = false\n"
            end
            build = build + "{f.name}: v_{f.name}"
        end
    end
    out = out + "var n = 0\nwhile true\n    let go = try json.__more(ref st, 125, n)\n    if not go\n        break\n    end\n    n += 1\n    let k = try json.__key(ref st)\n    match k\n"
    for f in t.fields()
        let key = field_key(f)
        if key != ""
            out = out + "        {quote(key)} ->\n"
            out = out + "            if s_{f.name}\n                try json.__dup(ref st, k)\n            end\n            s_{f.name} = true\n"
            out = out + "            json.__push_key(ref st, k)\n            v_{f.name} = {dec_expr(f.ty)}\n            json.__pop(ref st)\n"
        end
    end
    out = out + "        _ -> try json.__skip(ref st)\n    end\nend\n"
    for f in t.fields()
        let key = field_key(f)
        if key != "" and f.ty.kind() != "optional"
            out = out + "if not s_{f.name}\n    try json.__missing(ref st, {quote(key)})\nend\n"
        end
    end
    out = out + "return t \{ {build} \}\n"
    return out
end

comptime func dec_enum(t: Type) -> text
    var units = ""
    var payloads = ""
    for v in t.variants()
        if v.fields.len == 0
            units = units + "            {quote(v.name)} -> return {v.name}\n"
        else
            payloads = payloads + "            {quote(v.name)} ->\n"
            var args = ""
            if v.fields.len == 1
                unsupported(v.fields[0].ty, "decode")
                payloads = payloads + "                let a0 = {dec_expr(v.fields[0].ty)}\n"
                payloads = payloads + "                json.__pop(ref st)\n"
                payloads = payloads + "                let more = try json.__more(ref st, 125, 1)\n                if more\n                    try json.__one_key(ref st)\n                end\n"
                args = "a0"
            else
                payloads = payloads + "                try json.__open(ref st, 91, \"list\")\n"
                for i in 0..v.fields.len
                    unsupported(v.fields[i].ty, "decode")
                    payloads = payloads + "                let g{i} = try json.__more(ref st, 93, {i})\n                if not g{i}\n                    try json.__arity(ref st, {v.fields.len})\n                end\n"
                    payloads = payloads + "                let a{i} = {dec_expr(v.fields[i].ty)}\n"
                    if args != ""
                        args = args + ", "
                    end
                    args = args + "a{i}"
                end
                payloads = payloads + "                let extra = try json.__more(ref st, 93, {v.fields.len})\n                if extra\n                    try json.__arity(ref st, {v.fields.len})\n                end\n"
                payloads = payloads + "                json.__pop(ref st)\n"
                payloads = payloads + "                let more = try json.__more(ref st, 125, 1)\n                if more\n                    try json.__one_key(ref st)\n                end\n"
            end
            payloads = payloads + "                return {v.name}({args})\n"
        end
    end
    var out = "json.__skip_space(ref st)\nlet c = json.__peek(ref st)\n"
    var want = "text"
    if units != ""
        out = out + "if c == 34\n    let name = try json.__text(ref st)\n    match name\n{units}        _ -> try json.__unknown_case(ref st, name, {quote(t.name())})\n    end\nend\n"
    end
    if payloads != ""
        want = "object"
        if units != ""
            want = "text or object"
        end
        out = out + "if c == 123\n    try json.__open(ref st, 123, \"object\")\n    let first = try json.__more(ref st, 125, 0)\n    if not first\n        try json.__one_key(ref st)\n    end\n    let name = try json.__key(ref st)\n    json.__push_key(ref st, name)\n    match name\n{payloads}        _ -> try json.__unknown_case(ref st, name, {quote(t.name())})\n    end\nend\n"
    end
    out = out + "try json.__type_error(ref st, \"{want}\")\nreturn error(\"unreachable\")\n"
    return out
end

comptime func dec_body(t: Type) -> text
    unsupported(t, "decode")
    let k = t.kind()
    let leaf = dec_leaf(t)
    if leaf != ""
        return "return {leaf}\n"
    else if k == "alias"
        return "return {dec_expr(t.inner())}\n"
    else if k == "optional"
        return "let isnull = try json.__null(ref st)\nif isnull\n    return nil\nend\nreturn {dec_expr(t.inner())}\n"
    else if k == "list"
        let loop = "try json.__open(ref st, 91, \"list\")\nlet out: {t.name()} = []\nvar n = 0\nwhile true\n    let go = try json.__more(ref st, 93, n)\n    if not go\n        break\n    end\n    json.__push_idx(ref st, n)\n    out.add({dec_expr(t.element())})\n    json.__pop(ref st)\n    n += 1\nend\nreturn out\n"
        return loop
    else if k == "map"
        if t.key().kind() != "text"
            reflect.fail("json objects have text keys: cannot decode {t.name()}", t)
        end
        return "try json.__open(ref st, 123, \"object\")\nlet out: {t.name()} = \{\}\nvar n = 0\nwhile true\n    let go = try json.__more(ref st, 125, n)\n    if not go\n        break\n    end\n    n += 1\n    let k = try json.__key(ref st)\n    if out.has(k)\n        try json.__dup(ref st, k)\n    end\n    json.__push_key(ref st, k)\n    out[k] = {dec_expr(t.value())}\n    json.__pop(ref st)\nend\nreturn out\n"
    else if k == "record"
        return dec_record(t)
    else if k == "enum"
        return dec_enum(t)
    end
    reflect.fail("json cannot decode a value of type {t.name()}", t)
    return ""
end

comptime func dec_gen(t: Type) -> text
    return dec_body(t)
end

comptime func parse_gen(t: Type) -> text
    unsupported(t, "decode")
    return "var st = json.__scan(s)\nlet v = {dec_expr(t)}\ntry json.__finish(ref st)\nreturn v\n"
end

comptime func enc_record(t: Type) -> text
    check_keys(t)
    var out = "try json.__open_obj(ref o)\n"
    for f in t.fields()
        let key = field_key(f)
        if key != ""
            unsupported(f.ty, "encode")
            out = out + "json.__sep(ref o)\njson.__key_w(ref o, {quote(key)})\n{enc_expr(f.ty, "x.{f.name}")}\n"
        end
    end
    out = out + "json.__close_obj(ref o)\nreturn true\n"
    return out
end

comptime func enc_enum(t: Type) -> text
    var out = "match x\n"
    for v in t.variants()
        if v.fields.len == 0
            out = out + "    {v.name} -> json.__w_str(ref o, {quote(v.name)})\n"
        else
            var names = ""
            for i in 0..v.fields.len
                if names != ""
                    names = names + ", "
                end
                names = names + "a{i}"
            end
            out = out + "    {v.name}({names}) ->\n"
            out = out + "        try json.__open_obj(ref o)\n        json.__sep(ref o)\n        json.__key_w(ref o, {quote(v.name)})\n"
            if v.fields.len == 1
                unsupported(v.fields[0].ty, "encode")
                out = out + "        {enc_expr(v.fields[0].ty, "a0")}\n"
            else
                out = out + "        try json.__open_list(ref o)\n"
                for i in 0..v.fields.len
                    unsupported(v.fields[i].ty, "encode")
                    out = out + "        json.__sep(ref o)\n        {enc_expr(v.fields[i].ty, "a{i}")}\n"
                end
                out = out + "        json.__close_list(ref o)\n"
            end
            out = out + "        json.__close_obj(ref o)\n"
        end
    end
    out = out + "end\nreturn true\n"
    return out
end

comptime func enc_body(t: Type) -> text
    unsupported(t, "encode")
    let k = t.kind()
    let leaf = enc_leaf(t, "x")
    if leaf != ""
        return "{leaf}\nreturn true\n"
    else if k == "alias"
        return "{enc_expr(t.inner(), "x")}\nreturn true\n"
    else if k == "optional"
        return "if x == nil\n    json.__w_null(ref o)\n    return true\nend\n{enc_expr(t.inner(), "x")}\nreturn true\n"
    else if k == "list"
        return "try json.__open_list(ref o)\nfor e in x\n    json.__sep(ref o)\n    {enc_expr(t.element(), "e")}\nend\njson.__close_list(ref o)\nreturn true\n"
    else if k == "map"
        if t.key().kind() != "text"
            reflect.fail("json objects have text keys: cannot encode {t.name()}", t)
        end
        return "try json.__open_obj(ref o)\nfor k, e in x\n    json.__sep(ref o)\n    json.__key_w(ref o, k)\n    {enc_expr(t.value(), "e")}\nend\njson.__close_obj(ref o)\nreturn true\n"
    else if k == "record"
        return enc_record(t)
    else if k == "enum"
        return enc_enum(t)
    end
    reflect.fail("json cannot encode a value of type {t.name()}", t)
    return ""
end

comptime func enc_gen(t: Type) -> text
    return enc_body(t)
end

comptime func encode_gen(t: Type) -> text
    unsupported(t, "encode")
    return "var o = json.__out(0)\n{enc_expr(t, "x")}\nreturn json.__done(ref o)\n"
end

comptime func encode_with_gen(t: Type) -> text
    unsupported(t, "encode")
    return "var o = json.__out(opts.indent)\n{enc_expr(t, "x")}\nreturn json.__done(ref o)\n"
end
