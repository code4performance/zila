// =====================================================================
// Brasa standard library: TLS client (`use tls`)
//
// Written in Brasa on the Windows SChannel security package (secur32.dll; Linux uses
// std/tls.linux.br on OpenSSL),
// over the TCP connections of `net`. The server certificate is checked
// against the Windows trust store and the host name. No call blocks the
// other tasks (the cryptography itself runs inline and is fast).
//
//   let conn = try await tls.connect("example.com", 443)
//   try await conn.write("GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
//   let reply = try await conn.read(4096)
//
// `read` returns empty text when the server closed the connection.
//
//   tls.connect_with(host, port, tls.Options{ alpn: ["tds/8.0"], require_alpn: false, ca_file: "" })
//   tls.upgrade(conn, host)       // start TLS on a connection that already exchanged plain bytes
//
// `alpn` offers application protocols (`conn.protocol()` is the one the server chose, or empty
// text); `ca_file` is a PEM file of extra certificate authorities trusted for that one connection
// (the system's are still trusted, and the chain and host name are always checked).
// =====================================================================

package tls

use c
use sys
use errors
use net
use text
use crypto
use fs

#[c_layout]
type SchannelCred = record
    pub version: u32
    ccreds: u32
    pacred: *u8
    hroot: *u8
    cmappers: u32
    mappers: *u8
    calgs: u32
    algs: *u8
    protocols: u32
    mincipher: u32
    maxcipher: u32
    lifespan: u32
    pub flags: u32
    credformat: u32
end

// SecBufferDesc followed by room for four SecBuffers (cb, type, pointer each).
#[c_layout]
type Bufs = record
    cb0: u32
    kind0: u32
    p0: *u8
    cb1: u32
    kind1: u32
    p1: *u8
    cb2: u32
    kind2: u32
    p2: *u8
    cb3: u32
    kind3: u32
    p3: *u8
end

#[c_layout]
type Desc = record
    pub version: u32
    pub count: u32
    bufs: *u8
end

#[c_layout]
type Sizes = record
    pub header: u32
    trailer: u32
    max_message: u32
    pub buffers: u32
    pub block: u32
end

#[link("secur32")]
extern "system" func AcquireCredentialsHandleA(principal: *u8, provider: *u8, usage: u32, logon: *u8, auth: *u8, getkey: *u8, getkey_arg: *u8, handle: *u8, expiry: *u8) -> u32
extern "system" func InitializeSecurityContextA(cred: *u8, ctx: *u8, target: *u8, requested: u32, reserved1: u32, rep: u32, input: *u8, reserved2: u32, new_ctx: *u8, output: *u8, attrs: *u8, expiry: *u8) -> u32
extern "system" func QueryContextAttributesA(ctx: *u8, attribute: u32, buffer: *u8) -> u32
extern "system" func EncryptMessage(ctx: *u8, qop: u32, message: *u8, seq: u32) -> u32
extern "system" func DecryptMessage(ctx: *u8, message: *u8, seq: u32, qop: *u8) -> u32
extern "system" func FreeContextBuffer(p: *u8) -> u32
extern "system" func DeleteSecurityContext(ctx: *u8) -> u32
extern "system" func FreeCredentialsHandle(handle: *u8) -> u32

#[link("crypt32")]
extern "system" func CertOpenStore(provider: usize, encoding: u32, prov: usize, flags: u32, para: *u8) -> usize
extern "system" func CertAddEncodedCertificateToStore(store: usize, encoding: u32, cert: *u8, length: u32, disposition: u32, out: *u8) -> i32
extern "system" func CertCloseStore(store: usize, flags: u32) -> i32
extern "system" func CertCreateCertificateChainEngine(config: *u8, engine: *u8) -> i32
extern "system" func CertFreeCertificateChainEngine(engine: usize)
extern "system" func CertGetCertificateChain(engine: usize, cert: usize, time: *u8, store: usize, para: *u8, flags: u32, reserved: *u8, chain: *u8) -> i32
extern "system" func CertFreeCertificateChain(chain: usize)
extern "system" func CertVerifyCertificateChainPolicy(policy: usize, chain: usize, para: *u8, status: *u8) -> i32
extern "system" func CertFreeCertificateContext(cert: usize) -> i32

let SEC_E_OK = 0
let SEC_I_CONTINUE_NEEDED = 0x00090312
let SEC_I_CONTEXT_EXPIRED = 0x00090317
let SEC_I_RENEGOTIATE = 0x00090321
let SEC_E_INCOMPLETE_MESSAGE: long = 0x80090318
let SECBUFFER_EMPTY = 0
let SECBUFFER_DATA = 1
let SECBUFFER_TOKEN = 2
let SECBUFFER_EXTRA = 5
let SECBUFFER_APPLICATION_PROTOCOLS = 18
let SECPKG_ATTR_REMOTE_CERT_CONTEXT = 0x53
let SECPKG_ATTR_APPLICATION_PROTOCOL = 35
// ISC_REQ_MANUAL_CRED_VALIDATION: the program validates the server certificate itself
let ISC_MANUAL_VALIDATION = 0x80000
let CERT_E_UNTRUSTEDROOT: long = 0x800B0109
let CERT_E_CHAINING: long = 0x800B010A
let SECBUFFER_STREAM_TRAILER = 6
let SECBUFFER_STREAM_HEADER = 7
let SECPKG_ATTR_STREAM_SIZES = 4
let SECPKG_CRED_OUTBOUND = 2
// SEQUENCE_DETECT | REPLAY_DETECT | CONFIDENTIALITY | ALLOCATE_MEMORY | STREAM
let ISC_REQUEST = 0x811C
// SCH_USE_STRONG_CRYPTO | SCH_CRED_NO_DEFAULT_CREDS
let CRED_FLAGS = 0x400010
let PACKAGE = "Microsoft Unified Security Protocol Provider"

// An open TLS connection. Releases its security context when the last
// reference goes away.
#[shared]
pub type Conn = record
    pub raw: net.Conn
    cred: sys.Scratch
    ctx: sys.Scratch
    sizes: Sizes
    pub pending: text
    plain: text
    proto: text
    pub ready: bool
    pub open: bool
end

pub func (ref conn: Conn) drop()
    release(ref conn)
end

func release(ref conn: Conn)
    if conn.ready
        unsafe
            DeleteSecurityContext(&conn.ctx)
        end
        conn.ready = false
    end
    if conn.open
        unsafe
            FreeCredentialsHandle(&conn.cred)
        end
        conn.open = false
    end
end

func code_of(rc: u32) -> long
    return long(rc)
end

// Copies `n` bytes of `data` starting at `from` into raw memory at `dest`.
func put_text(dest: *u8, data: text, from: long, n: long)
    unsafe
        for i in 0..n
            dest[i] = data.byte(from + i)
        end
    end
end

// What a connection asks for beyond the defaults.
pub type Options = record
    pub alpn: []text
    pub require_alpn: bool
    pub ca_file: text
end

// Opens a TCP connection and runs the TLS handshake.
pub async func connect(host: text, port: long) -> Conn or error
    return await connect_with(host, port, Options{ alpn: [], require_alpn: false, ca_file: "" })
end

// `connect` with ALPN protocols and a private CA file (see `Options`).
pub async func connect_with(host: text, port: long, opts: Options) -> Conn or error
    let raw = try await net.connect(host, port)
    return await upgrade_with(raw, host, opts)
end

// Starts TLS on a connection that already exchanged plain bytes (PostgreSQL's SSLRequest): read
// exactly the plain answer before calling, because the first bytes after it belong to TLS.
// On failure the connection is closed.
pub async func upgrade(raw: net.Conn, host: text) -> Conn or error
    return await upgrade_with(raw, host, Options{ alpn: [], require_alpn: false, ca_file: "" })
end

// `upgrade` with ALPN protocols and a private CA file (see `Options`).
pub async func upgrade_with(raw: net.Conn, host: text, opts: Options) -> Conn or error
    let r = await handshake(raw, host, opts)
    match r
        ok(conn) -> return conn
        err(e) ->
            await raw.close()
            return error(e.kind, e.message)
    end
    return error(errors.Io, "TLS: unreachable")
end

// The application protocol the server selected through ALPN, or empty text.
pub func (conn: Conn) protocol() -> text
    return conn.proto
end

func wr32(p: *u8, off: long, v: long)
    unsafe
        p[off] = u8(v bitand 255)
        p[off + 1] = u8((v >> 8) bitand 255)
        p[off + 2] = u8((v >> 16) bitand 255)
        p[off + 3] = u8((v >> 24) bitand 255)
    end
end

func rd32(p: *u8, off: long) -> long
    var v: long = 0
    unsafe
        v = long(p[off]) bitor (long(p[off + 1]) << 8) bitor (long(p[off + 2]) << 16) bitor (long(p[off + 3]) << 24)
    end
    return v
end

func wr64(p: *u8, off: long, v: long)
    wr32(p, off, v bitand 4294967295)
    wr32(p, off + 4, (v >> 32) bitand 4294967295)
end

func rd64(p: *u8, off: long) -> long
    return rd32(p, off) bitor (rd32(p, off + 4) << 32)
end

// The certificates of a PEM file, each as DER bytes.
func pem_certs(pem: text) -> []text
    var out: []text = []
    var from = 0
    while true
        let a = text.index_from(pem, "-----BEGIN CERTIFICATE-----", from)
        if a < 0
            break
        end
        let start = a + 27
        let z = text.index_from(pem, "-----END CERTIFICATE-----", start)
        if z < 0
            break
        end
        let body = text.replace(text.replace(text.replace(pem.slice(start, z), "\r", ""), "\n", ""), " ", "")
        match crypto.base64_decode(body)
            ok(der) -> out.add(der)
            err(e) -> from = z
        end
        from = z + 25
    end
    return out
end

// Builds the chain of `cert` with `engine` (0 is the default one) and checks it as a TLS server
// certificate for `wide_host`; the policy error code, 0 when it is good.
func check_chain(engine: usize, cert: usize, store: usize, wide_host: sys.Buf) -> long
    let para = sys.buffer(48)
    wr32(para.ptr, 0, 48)
    let out = sys.buffer(8)
    var ok: long = 0
    unsafe
        ok = long(CertGetCertificateChain(engine, cert, 0, store, para.ptr, u32(0), 0, out.ptr))
    end
    if ok == 0
        return CERT_E_UNTRUSTEDROOT
    end
    let chain = usize(rd64(out.ptr, 0))
    let extra = sys.buffer(24)
    wr32(extra.ptr, 0, 24)
    wr32(extra.ptr, 4, 2)
    wr64(extra.ptr, 16, long(wide_host.ptr))
    let pol = sys.buffer(16)
    wr32(pol.ptr, 0, 16)
    wr64(pol.ptr, 8, long(extra.ptr))
    let status = sys.buffer(32)
    wr32(status.ptr, 0, 24)
    var good: long = 0
    unsafe
        good = long(CertVerifyCertificateChainPolicy(usize(4), chain, pol.ptr, status.ptr))
        CertFreeCertificateChain(chain)
    end
    if good == 0
        return CERT_E_UNTRUSTEDROOT
    end
    return rd32(status.ptr, 4)
end

func chain_message(code: long) -> text
    if code == 0x800B0109 or code == 0x800B010A
        return "the certificate is not trusted"
    end
    if code == 0x800B010F
        return "the certificate does not match the host name"
    end
    if code == 0x800B0101
        return "the certificate has expired"
    end
    return "certificate validation failed ({code})"
end

func memory_store() -> usize
    var store = usize(0)
    unsafe
        store = CertOpenStore(usize(2), u32(0), usize(0), u32(0), 0)
    end
    return store
end

// Validates the server certificate against the system roots and, when that finds no trusted
// root, against the CAs of `pem` alone. The chain and host name are checked either way. Empty
// text when the certificate is good, else the reason.
func verify_remote(ref conn: Conn, host: text, pem: text) -> text
    let certp = sys.buffer(8)
    var rc: long = 0
    unsafe
        rc = code_of(QueryContextAttributesA(&conn.ctx, u32(SECPKG_ATTR_REMOTE_CERT_CONTEXT), certp.ptr))
    end
    if rc != SEC_E_OK
        return "cannot read the server certificate"
    end
    let cert_addr = rd64(certp.ptr, 0)
    let cp: *u8 = cert_addr
    let leaf_store = usize(rd64(cp, 32))
    let cert = usize(cert_addr)
    let wide_host = sys.wide(host)
    var code = check_chain(usize(0), cert, leaf_store, wide_host)
    if code != 0 and (code == CERT_E_UNTRUSTEDROOT or code == CERT_E_CHAINING)
        // the system does not trust it: try the CAs of the file alone
        let store = memory_store()
        var added = 0
        for der in pem_certs(pem)
            let b = sys.buffer(long(der.len))
            put_text(b.ptr, der, 0, long(der.len))
            unsafe
                CertAddEncodedCertificateToStore(store, u32(1), b.ptr, u32(der.len), u32(4), 0)
            end
            added += 1
        end
        if added > 0
            let config = sys.buffer(88)
            wr32(config.ptr, 0, 88)
            wr64(config.ptr, 64, long(store))
            let eng = sys.buffer(8)
            var made: long = 0
            unsafe
                made = long(CertCreateCertificateChainEngine(config.ptr, eng.ptr))
            end
            if made != 0
                let engine = usize(rd64(eng.ptr, 0))
                code = check_chain(engine, cert, leaf_store, wide_host)
                unsafe
                    CertFreeCertificateChainEngine(engine)
                end
            end
        end
        unsafe
            CertCloseStore(store, u32(0))
        end
    end
    unsafe
        CertFreeCertificateContext(cert)
    end
    if code != 0
        return chain_message(code)
    end
    return ""
end

// The protocol the server chose through ALPN, or empty text.
func selected_protocol(ref conn: Conn) -> text
    let b = sys.buffer(300)
    var rc: long = 0
    unsafe
        rc = code_of(QueryContextAttributesA(&conn.ctx, u32(SECPKG_ATTR_APPLICATION_PROTOCOL), b.ptr))
    end
    if rc != SEC_E_OK
        return ""
    end
    if rd32(b.ptr, 0) != 1
        return ""
    end
    var n: long = 0
    unsafe
        n = long(b.ptr[8])
    end
    if n == 0
        return ""
    end
    var out = ""
    unsafe
        out = c.from_bytes(b.ptr + 9, n)
    end
    return out
end

async func handshake(raw: net.Conn, host: text, opts: Options) -> Conn or error
    var pem = ""
    if opts.ca_file != ""
        match await fs.read(opts.ca_file)
            ok(t) -> pem = t
            err(e) -> return error(errors.InvalidInput, "TLS: cannot read the CA file {opts.ca_file}: {e.message}")
        end
        if text.index_of(pem, "BEGIN CERTIFICATE") < 0
            return error(errors.InvalidInput, "TLS: the CA file {opts.ca_file} holds no certificate")
        end
    end
    // the ALPN extension: SEC_APPLICATION_PROTOCOLS { lists size, { extension kind 2, size, names } }
    var alpn_len: long = 0
    var alpn_buf = sys.buffer(1)
    if opts.alpn.len > 0
        var names: []long = []
        for n in opts.alpn
            names.add(long(n.len))
            for i in 0..n.len
                names.add(long(n.byte(i)))
            end
        end
        alpn_len = 4 + 4 + 2 + long(names.len)
        alpn_buf = sys.buffer(alpn_len)
        wr32(alpn_buf.ptr, 0, 4 + 2 + long(names.len))
        wr32(alpn_buf.ptr, 4, 2)
        unsafe
            alpn_buf.ptr[8] = u8(long(names.len) bitand 255)
            alpn_buf.ptr[9] = u8((long(names.len) >> 8) bitand 255)
            for i in 0..names.len
                alpn_buf.ptr[10 + i] = u8(names[i])
            end
        end
    end
    var isc_flags = ISC_REQUEST
    if opts.ca_file != ""
        isc_flags = ISC_REQUEST bitor ISC_MANUAL_VALIDATION
    end
    let conn = Conn{ raw: raw, cred: sys.Scratch{}, ctx: sys.Scratch{}, sizes: Sizes{}, pending: "", plain: "", proto: "", ready: false, open: false }
    let cred = SchannelCred{}
    cred.version = u32(4)
    cred.flags = u32(CRED_FLAGS)
    let expiry = sys.Scratch{}
    var rc: long = 0
    unsafe
        rc = code_of(AcquireCredentialsHandleA(0, c.cstr(PACKAGE), u32(SECPKG_CRED_OUTBOUND), 0, &cred, 0, 0, &conn.cred, &expiry))
    end
    if rc != SEC_E_OK
        return sys.error_for(rc, "TLS: cannot acquire credentials")
    end
    conn.open = true
    var inbuf = ""
    var first = true
    let attrs = sys.Scratch{}
    while true
        let idesc = Desc{}
        let ib = Bufs{}
        ib.cb0 = u32(inbuf.len)
        ib.kind0 = u32(SECBUFFER_TOKEN)
        ib.p0 = c.cstr(inbuf)
        ib.kind1 = u32(SECBUFFER_EMPTY)
        idesc.count = u32(2)
        if first and alpn_len > 0
            ib.cb0 = u32(alpn_len)
            ib.kind0 = u32(SECBUFFER_APPLICATION_PROTOCOLS)
            ib.p0 = alpn_buf.ptr
            idesc.count = u32(1)
        end
        let ob = Bufs{}
        ob.kind0 = u32(SECBUFFER_TOKEN)
        let odesc = Desc{}
        odesc.count = u32(1)
        unsafe
            idesc.bufs = &ib
            odesc.bufs = &ob
            if first and alpn_len > 0
                rc = code_of(InitializeSecurityContextA(&conn.cred, 0, c.cstr(host), u32(isc_flags), u32(0), u32(0), &idesc, u32(0), &conn.ctx, &odesc, &attrs, &expiry))
            else if first
                rc = code_of(InitializeSecurityContextA(&conn.cred, 0, c.cstr(host), u32(isc_flags), u32(0), u32(0), 0, u32(0), &conn.ctx, &odesc, &attrs, &expiry))
            else
                rc = code_of(InitializeSecurityContextA(&conn.cred, &conn.ctx, c.cstr(host), u32(isc_flags), u32(0), u32(0), &idesc, u32(0), &conn.ctx, &odesc, &attrs, &expiry))
            end
        end
        if first and (rc == SEC_I_CONTINUE_NEEDED or rc == SEC_E_OK)
            conn.ready = true
        end
        first = false
        // a token for the server
        if ob.cb0 > u32(0) and ob.p0 != 0
            let token = c.from_bytes(ob.p0, long(ob.cb0))
            unsafe
                FreeContextBuffer(ob.p0)
            end
            try await raw.write(token)
        end
        if rc == SEC_E_OK
            if ib.kind1 == u32(SECBUFFER_EXTRA)
                conn.pending = inbuf.__raw_slice(inbuf.len - long(ib.cb1), inbuf.len)
            end
            break
        end
        if rc == SEC_I_CONTINUE_NEEDED
            if ib.kind1 == u32(SECBUFFER_EXTRA)
                inbuf = inbuf.__raw_slice(inbuf.len - long(ib.cb1), inbuf.len)
            else
                inbuf = ""
            end
        else
            if rc != SEC_E_INCOMPLETE_MESSAGE
                release(ref conn)
                return sys.error_for(rc, "TLS handshake with {host} failed")
            end
        end
        let more = try await raw.read(16384)
        if more.len == 0
            release(ref conn)
            return error(errors.ConnectionReset, "TLS handshake with {host} failed: the connection was closed")
        end
        inbuf = inbuf + more
    end
    unsafe
        rc = code_of(QueryContextAttributesA(&conn.ctx, u32(SECPKG_ATTR_STREAM_SIZES), &conn.sizes))
    end
    if rc != SEC_E_OK
        release(ref conn)
        return sys.error_for(rc, "TLS: cannot read the stream sizes")
    end
    if opts.ca_file != ""
        let why = verify_remote(ref conn, host, pem)
        if why != ""
            release(ref conn)
            return error(errors.Io, "TLS handshake with {host} failed: {why}")
        end
    end
    if opts.alpn.len > 0
        conn.proto = selected_protocol(ref conn)
        if conn.proto == "" and opts.require_alpn
            release(ref conn)
            return error(errors.Io, "TLS handshake with {host} failed: the server selected none of the offered protocols ({text.join(opts.alpn, ", ")})")
        end
    end
    return conn
end

// Encrypts and sends all of `data`.
pub async func (conn: Conn) write(data: text) -> error
    if not conn.ready
        return error(errors.Closed, "write: the connection is closed")
    end
    let header = long(conn.sizes.header)
    let trailer = long(conn.sizes.trailer)
    let most = long(conn.sizes.max_message)
    var done: long = 0
    while done < data.len
        var n = data.len - done
        if n > most
            n = most
        end
        let b = sys.buffer(header + n + trailer)
        put_text(b.ptr + header, data, done, n)
        let bufs = Bufs{}
        bufs.cb0 = conn.sizes.header
        bufs.kind0 = u32(SECBUFFER_STREAM_HEADER)
        bufs.p0 = b.ptr
        bufs.cb1 = u32(n)
        bufs.kind1 = u32(SECBUFFER_DATA)
        bufs.p1 = b.ptr + header
        bufs.cb2 = conn.sizes.trailer
        bufs.kind2 = u32(SECBUFFER_STREAM_TRAILER)
        bufs.p2 = b.ptr + header + n
        bufs.kind3 = u32(SECBUFFER_EMPTY)
        let desc = Desc{}
        desc.count = u32(4)
        var rc: long = 0
        unsafe
            desc.bufs = &bufs
            rc = code_of(EncryptMessage(&conn.ctx, u32(0), &desc, u32(0)))
        end
        if rc != SEC_E_OK
            return sys.error_for(rc, "TLS: cannot encrypt")
        end
        let total = long(bufs.cb0) + long(bufs.cb1) + long(bufs.cb2)
        try await conn.raw.write(c.from_bytes(b.ptr, total))
        done += n
    end
    return
end

// Receives up to `max` bytes; empty text means the server closed the connection.
pub async func (conn: Conn) read(max: long) -> text or error
    while true
        if conn.plain.len > 0
            var n = conn.plain.len
            if long(n) > max
                n = int(max)
            end
            let out = conn.plain.__raw_slice(0, n)
            conn.plain = conn.plain.__raw_slice(n, conn.plain.len)
            return out
        end
        if not conn.ready
            return ""
        end
        var need_more = true
        if conn.pending.len > 0
            let b = sys.buffer(conn.pending.len)
            put_text(b.ptr, conn.pending, 0, conn.pending.len)
            let bufs = Bufs{}
            bufs.cb0 = u32(conn.pending.len)
            bufs.kind0 = u32(SECBUFFER_DATA)
            bufs.p0 = b.ptr
            let desc = Desc{}
            desc.count = u32(4)
            var rc: long = 0
            unsafe
                desc.bufs = &bufs
                rc = code_of(DecryptMessage(&conn.ctx, &desc, u32(0), 0))
            end
            if rc == SEC_E_OK
                need_more = false
                var extra: long = 0
                if bufs.kind1 == u32(SECBUFFER_DATA)
                    conn.plain = conn.plain + c.from_bytes(bufs.p1, long(bufs.cb1))
                end
                if bufs.kind2 == u32(SECBUFFER_DATA)
                    conn.plain = conn.plain + c.from_bytes(bufs.p2, long(bufs.cb2))
                end
                if bufs.kind3 == u32(SECBUFFER_DATA)
                    conn.plain = conn.plain + c.from_bytes(bufs.p3, long(bufs.cb3))
                end
                if bufs.kind1 == u32(SECBUFFER_EXTRA)
                    extra = long(bufs.cb1)
                end
                if bufs.kind2 == u32(SECBUFFER_EXTRA)
                    extra = long(bufs.cb2)
                end
                if bufs.kind3 == u32(SECBUFFER_EXTRA)
                    extra = long(bufs.cb3)
                end
                conn.pending = conn.pending.__raw_slice(conn.pending.len - extra, conn.pending.len)
            else
                if rc == SEC_I_CONTEXT_EXPIRED
                    conn.pending = ""
                    conn.ready = false
                    need_more = false
                else
                    if rc == SEC_I_RENEGOTIATE
                        return error(errors.Unsupported, "TLS: renegotiation is not supported")
                    end
                    if rc != SEC_E_INCOMPLETE_MESSAGE
                        return sys.error_for(rc, "TLS: cannot decrypt")
                    end
                end
            end
        end
        if need_more
            let more = try await conn.raw.read(16384)
            if more.len == 0
                conn.ready = false
                if conn.pending.len > 0
                    return error(errors.ConnectionReset, "TLS: the connection was cut off")
                end
                return ""
            end
            conn.pending = conn.pending + more
        end
    end
    return ""
end

// Closes the connection now.
pub async func (conn: Conn) close()
    release(ref conn)
    await conn.raw.close()
end
