// =====================================================================
// Brasa standard library: `use ui`
//
// Windows and controls, written in Brasa. The compiler embeds this file and compiles it
// together with the program; nothing here is implemented in Rust or C. This is the Windows
// layer (native Win32 controls); std/ui.linux.br is the Linux layer (controls drawn on X11).
// Both have the same public API: the shared region is the same text in both files.
//
//   var win = ui.Window("Title", 640, 480)
//   var name = ui.TextBox()
//   var add = ui.Button("Add")
//   add.onClick(func() ... end)
//   win.layout(ui.vstack(name, add))
//   win.show()
//   ui.run()
//
// Widgets are plain records holding an opaque id, so copying one is cheap and every copy
// refers to the same control. Controls are created immediately, parked inside a hidden
// window, and moved into their real window by `layout`.
//
// With the environment variable BRASA_UI_SCRIPT naming a file, `run` applies its steps
// (click N, type TEXT, key NAME, select N, close) to the first window instead of waiting
// for a person; this is how the tests drive programs.
// =====================================================================

package ui

use c
use sys
use text

// ---------- Win32 bindings ----------

#[link("user32")]
extern "system" func RegisterClassExA(wc: *WndClass) -> u16
extern "system" func CreateWindowExA(ex: u32, class: *u8, title: *u8, style: u32, x: i32, y: i32, w: i32, h: i32, parent: usize, menu: usize, inst: usize, param: usize) -> usize
extern "system" func DefWindowProcA(hwnd: usize, msg: u32, wp: usize, lp: isize) -> isize
extern "system" func DestroyWindow(hwnd: usize) -> i32
extern "system" func ShowWindow(hwnd: usize, cmd: i32) -> i32
extern "system" func SetForegroundWindow(hwnd: usize) -> i32
extern "system" func SetParent(child: usize, parent: usize) -> usize
extern "system" func MoveWindow(hwnd: usize, x: i32, y: i32, w: i32, h: i32, repaint: i32) -> i32
extern "system" func GetClientRect(hwnd: usize, r: *Rect) -> i32
extern "system" func GetMessageA(msg: *Msg, hwnd: usize, min: u32, max: u32) -> i32
extern "system" func TranslateMessage(msg: *Msg) -> i32
extern "system" func DispatchMessageA(msg: *Msg) -> isize
extern "system" func IsDialogMessageA(hwnd: usize, msg: *Msg) -> i32
extern "system" func GetAncestor(hwnd: usize, flags: u32) -> usize
extern "system" func PostQuitMessage(code: i32)
extern "system" func SendMessageA(hwnd: usize, msg: u32, wp: usize, lp: isize) -> isize
extern "system" func SetWindowTextA(hwnd: usize, text: *u8) -> i32
extern "system" func GetWindowTextA(hwnd: usize, buf: *u8, max: i32) -> i32
extern "system" func GetWindowTextLengthA(hwnd: usize) -> i32
extern "system" func LoadCursorA(inst: usize, name: usize) -> usize
extern "system" func GetSysColorBrush(index: i32) -> usize
extern "system" func GetDpiForWindow(hwnd: usize) -> u32
extern "system" func GetDpiForSystem() -> u32
extern "system" func MessageBoxA(hwnd: usize, text: *u8, caption: *u8, kind: u32) -> i32

#[link("gdi32")]
extern "system" func CreateFontA(height: i32, width: i32, esc: i32, orient: i32, weight: i32, italic: u32, underline: u32, strike: u32, charset: u32, out_prec: u32, clip_prec: u32, quality: u32, pitch: u32, face: *u8) -> usize
extern "system" func SetBkMode(hdc: usize, mode: i32) -> i32

#[link("kernel32")]
extern "system" func GetModuleHandleA(name: usize) -> usize
extern "system" func GetEnvironmentVariableA(name: *u8, buffer: *u8, size: u32) -> u32
extern "system" func CreateFileA(name: *u8, access: u32, share: u32, security: usize, disposition: u32, flags: u32, template: usize) -> usize
extern "system" func ReadFile(file: usize, buffer: *u8, count: u32, read: *long, overlapped: usize) -> i32
extern "system" func GetFileSize(file: usize, high: usize) -> u32
extern "system" func CloseHandle(file: usize) -> i32
extern "system" func ExitProcess(code: u32)

#[c_layout]
type WndClass = record
    pub size: u32
    style: u32
    proc: extern "system" func(usize, u32, usize, isize) -> isize
    cls_extra: i32
    wnd_extra: i32
    instance: usize
    icon: usize
    cursor: usize
    background: usize
    menu_name: usize
    class_name: *u8
    icon_small: usize
end

#[c_layout]
type Msg = record
    pub hwnd: usize
    pub message: u32
    wparam: usize
    lparam: isize
    pub time: u32
    pub x: i32
    pub y: i32
    private: u32
end

#[c_layout]
type Rect = record
    pub left: i32
    top: i32
    pub right: i32
    bottom: i32
end

let WS_OVERLAPPEDWINDOW = 0x00CF0000
let WS_CLIPCHILDREN = 0x02000000
let WS_CHILD = 0x40000000
let WS_VISIBLE = 0x10000000
let WS_TABSTOP = 0x00010000
let WS_VSCROLL = 0x00200000
let WS_EX_CLIENTEDGE = 0x0200
let WS_EX_CONTROLPARENT = 0x00010000
let ES_AUTOHSCROLL = 0x0080
let LBS_NOTIFY = 0x0001
let LBS_NOINTEGRALHEIGHT = 0x0100
let SS_CENTERIMAGE = 0x0200
let CW_USEDEFAULT: i32 = -2147483648

let WM_DESTROY = 0x0002
let WM_SIZE = 0x0005
let WM_SETFONT = 0x0030
let WM_COMMAND = 0x0111
let WM_CTLCOLORSTATIC = 0x0138
let WM_DPICHANGED = 0x02E0
let LB_ADDSTRING = 0x0180
let LB_DELETESTRING = 0x0182
let LB_RESETCONTENT = 0x0184
let LB_GETCURSEL = 0x0188
let LB_GETCOUNT = 0x018B
let LB_SETCURSEL = 0x0186
let BN_CLICKED = 0
let EN_CHANGE = 0x0300
let LBN_SELCHANGE = 1
let IDOK = 1
let COLOR_WINDOW = 5
let SW_SHOW = 5
let GA_ROOT = 2

// ---- shared begin ----
// Everything from here to "shared end" is the same text in std/ui.br (Windows) and
// std/ui.linux.br (Linux); tests/ui.rs checks that. It holds the whole public API, the layout
// and the scripted input. The two files differ only in the `be_*` functions below it, which
// are the backend: the native controls of Win32 on Windows, controls drawn on X11 on Linux.

// ---------- widget model ----------

let TEXTBOX = 1
let BUTTON = 2
let LISTVIEW = 3
let LABEL = 4
let WINDOW = 5
let VSTACK = 6
let HSTACK = 7

// What a handler waits for.
let EV_CLICK = 0
let EV_CHANGE = 1
let EV_SELECT = 2

// Logical pixels; scaled by the window's DPI.
let PAD = 12
let GAP = 8

pub type Control = record
    pub id: usize
    pub kind: i32
    pub children: []Control
end

// A control's state at the moment its window closed.
type Frozen = record
    pub id: usize
    pub text: text
    pub count: i32
    pub selected: i32
end

type Handler = record
    pub id: usize
    pub code: i32
    pub action: func()
end

// An open top-level window and the layout tree it arranges.
type Frame = record
    pub id: usize
    pub root: Control?
end

var handlers: []Handler
var frames: []Frame
var scripted = false
// What a window's controls held when it closed; they keep answering with it afterwards.
var frozen: []Frozen
// While the library itself sets a text, the backend must not report it as typing.
var muted: long = 0

// ---------- constructors ----------

pub func Window(title: text, width: i32 = 640, height: i32 = 480) -> Control
    let id = be_window(title, width, height)
    frames.add(Frame{ id: id })
    return Control{ id: id, kind: WINDOW }
end

pub func TextBox(value: text = "") -> Control
    return Control{ id: be_create(TEXTBOX, value), kind: TEXTBOX }
end

pub func Button(label: text) -> Control
    return Control{ id: be_create(BUTTON, label), kind: BUTTON }
end

pub func ListView() -> Control
    return Control{ id: be_create(LISTVIEW, ""), kind: LISTVIEW }
end

pub func Label(value: text) -> Control
    return Control{ id: be_create(LABEL, value), kind: LABEL }
end

pub func vstack(items: ...Control) -> Control
    return Control{ kind: VSTACK, children: items }
end

func hstack(items: ...Control) -> Control
    return Control{ kind: HSTACK, children: items }
end

// ---------- properties: `w.text`, `w.text = ...`, `w.count`, `w.selected` ----------

pub func (w: Control) text() -> text
    for z in frozen
        if z.id == w.id
            return z.text
        end
    end
    return be_text(w.id)
end

pub func (w: Control) set_text(value: text)
    change_text(w.id, value)
end

pub func (w: Control) count() -> i32
    for z in frozen
        if z.id == w.id
            return z.count
        end
    end
    return be_list_count(w.id)
end

// Index of the selected list item, or -1.
pub func (w: Control) selected() -> i32
    for z in frozen
        if z.id == w.id
            return z.selected
        end
    end
    return be_list_selected(w.id)
end

// ---------- methods ----------

pub func (w: Control) add(item: text)
    be_list_add(w.id, item)
end

pub func (w: Control) remove(index: i32)
    be_list_remove(w.id, index)
end

pub func (w: Control) clear()
    if w.kind == LISTVIEW
        be_list_clear(w.id)
    else
        w.set_text("")
    end
end

pub func (w: Control) onClick(action: func())
    handlers.add(Handler{ id: w.id, code: EV_CLICK, action: action })
end

pub func (w: Control) onChange(action: func())
    handlers.add(Handler{ id: w.id, code: EV_CHANGE, action: action })
end

pub func (w: Control) onSelect(action: func())
    handlers.add(Handler{ id: w.id, code: EV_SELECT, action: action })
end

pub func (w: Control) layout(root: Control)
    adopt(root, w.id)
    for i in 0..frames.len
        if frames[i].id == w.id
            frames[i].root = root
        end
    end
    be_style(w.id, root)
    relayout(w.id)
end

pub func (w: Control) show()
    be_show(w.id)
    relayout(w.id)
end

pub func (w: Control) close()
    be_close(w.id)
end

// Runs the event loop until the last window is closed.
pub func run()
    run_script()
    be_run()
end

pub func alert(message: text, title: text = "Brasa")
    // a scripted run has nobody to dismiss it
    if be_script().len > 0
        return
    end
    be_alert(message, title)
end

// ---------- internals ----------

// Sets the text of a control; onChange runs once when the text really changed.
func change_text(id: usize, value: text)
    if be_text(id) == value
        return
    end
    muted += 1
    be_set_text(id, value)
    muted -= 1
    fire(id, EV_CHANGE)
end

// The windows and controls (not the stacks) under a node, in order.
func leaves(node: Control) -> []usize
    var out: []usize
    if node.kind == VSTACK or node.kind == HSTACK
        for ch in node.children
            for l in leaves(ch)
                out.add(l)
            end
        end
        return out
    end
    out.add(node.id)
    return out
end

func adopt(node: Control, window: usize)
    for l in leaves(node)
        be_adopt(window, l)
    end
end

func scale(v: i32, dpi: i32) -> i32
    return v * dpi / 96
end

func max(a: i32, b: i32) -> i32
    if a > b
        return a
    end
    return b
end

// Preferred size along one axis in logical pixels; -1 means "stretch".
func pref(w: Control, vertical: bool) -> i32
    if w.kind == TEXTBOX
        if vertical
            return 28
        end
        return -1
    end
    if w.kind == BUTTON
        if vertical
            return 32
        end
        return max(be_text_len(w.id) * 8 + 32, 88)
    end
    if w.kind == LABEL
        if vertical
            return 22
        end
        return be_text_len(w.id) * 7 + 8
    end
    if w.kind == VSTACK or w.kind == HSTACK
        let along = (w.kind == VSTACK) == vertical
        var total: i32 = 0
        for ch in w.children
            let p = pref(ch, vertical)
            if p < 0
                return -1
            end
            if along
                total += p
            else
                total = max(total, p)
            end
        end
        if along and w.children.len > 0
            total += GAP * (i32(w.children.len) - 1)
        end
        return total
    end
    return -1
end

func place(w: Control, x: i32, y: i32, width: i32, height: i32, dpi: i32)
    if w.kind != VSTACK and w.kind != HSTACK
        be_move(w.id, x, y, width, height)
        return
    end
    let vertical = w.kind == VSTACK
    let n = i32(w.children.len)
    if n == 0
        return
    end
    let gap = scale(GAP, dpi)
    var fixed: i32 = 0
    var flex: i32 = 0
    for ch in w.children
        let p = pref(ch, vertical)
        if p < 0
            flex += 1
        else
            fixed += scale(p, dpi)
        end
    end
    var main = width
    if vertical
        main = height
    end
    var each: i32 = 0
    if flex > 0
        each = max(main - fixed - gap * (n - 1), 0) / flex
    end
    var pos = x
    if vertical
        pos = y
    end
    for ch in w.children
        var len = each
        let p = pref(ch, vertical)
        if p >= 0
            len = scale(p, dpi)
        end
        if vertical
            place(ch, x, pos, width, len, dpi)
        else
            place(ch, pos, y, len, height, dpi)
        end
        pos += len + gap
    end
end

func relayout(window: usize)
    for f in frames
        if f.id == window and f.root != nil
            let dpi = be_dpi(window)
            let pad = scale(PAD, dpi)
            place(f.root, pad, pad, be_client_width(window) - 2 * pad, be_client_height(window) - 2 * pad, dpi)
        end
    end
end

func first_of(node: Control, kind: i32) -> usize
    if node.kind == kind
        return node.id
    end
    for ch in node.children
        let b = first_of(ch, kind)
        if b != 0
            return b
        end
    end
    return 0
end

// Enter in a field clicks the window's first button.
func enter_pressed(window: usize)
    for f in frames
        if f.id == window and f.root != nil
            let b = first_of(f.root, BUTTON)
            if b != 0
                fire(b, EV_CLICK)
            end
        end
    end
end

func fire(id: usize, code: i32)
    for h in handlers
        if h.id == id and h.code == code
            h.action()
        end
    end
end

// A window went away; the loop ends with the last one.
func closed(window: usize)
    for f in frames
        if f.id == window and f.root != nil
            for l in leaves(f.root)
                frozen.add(Frozen{ id: l, text: be_text(l), count: be_list_count(l), selected: be_list_selected(l) })
            end
        end
    end
    var open: long = 0
    for i in 0..frames.len
        if frames[i].id == window
            frames[i].id = 0
        end
        if frames[i].id != 0
            open += 1
        end
    end
    if open == 0
        be_quit()
    end
end

// ---------- display failure ----------

func no_display(reason: text)
    print("error: ui: cannot open a display: {reason}")
    be_exit(1)
end

// ---------- scripted input (BRASA_UI_SCRIPT, for tests) ----------
// Setting a text box's text runs its onChange handlers, as typing does, so the script only sets it.

// The buttons under a node, in order.
func buttons_of(node: Control) -> []usize
    var out: []usize
    if node.kind == BUTTON
        out.add(node.id)
    end
    for ch in node.children
        for b in buttons_of(ch)
            out.add(b)
        end
    end
    return out
end

func script_move(list: usize, delta: i32)
    let n = be_list_count(list)
    if n == 0
        return
    end
    var to = be_list_selected(list) + delta
    if to < 0
        to = 0
    end
    if to > n - 1
        to = n - 1
    end
    if to != be_list_selected(list)
        be_list_select(list, to)
        fire(list, EV_SELECT)
    end
end

func script_step(window: Frame, line: text)
    let root = window.root
    if root == nil
        return
    end
    var word = line
    var rest = ""
    let space = text.index_of(line, " ")
    if space >= 0
        word = line.slice(0, space)
        rest = line.slice(space + 1, line.len)
    end
    let box = first_of(root, TEXTBOX)
    let list = first_of(root, LISTVIEW)
    if word == "click"
        let which = text.parse_int(rest) ?? 0
        let all = buttons_of(root)
        if which >= 0 and which < i32(all.len)
            fire(all[which], EV_CLICK)
        end
    end
    if word == "type" and box != 0
        for c in rest
            change_text(box, be_text(box) + c.to_text())
        end
    end
    if word == "select" and list != 0
        let which = text.parse_int(rest) ?? 0
        if which >= 0 and which < be_list_count(list)
            be_list_select(list, which)
            fire(list, EV_SELECT)
        end
    end
    if word == "key"
        if rest == "backspace" and box != 0
            let now = be_text(box)
            if now.len > 0
                let cs = text.chars(now)
                cs.take()
                change_text(box, text.from_chars(cs))
            end
        end
        if rest == "enter"
            enter_pressed(window.id)
        end
        if rest == "up" and list != 0
            script_move(list, -1)
        end
        if rest == "down" and list != 0
            script_move(list, 1)
        end
    end
    if word == "close"
        be_close(window.id)
    end
end

// Applies the steps of the script file to the first window, then closes it.
func run_script()
    let script = be_script()
    if script.len == 0 or scripted
        return
    end
    scripted = true
    var first = Frame{}
    for f in frames
        if first.id == 0 and f.id != 0
            first = f
        end
    end
    if first.id == 0
        return
    end
    for line in text.lines(script)
        let step = text.trim(line)
        if step.len > 0
            script_step(first, step)
        end
    end
    be_close(first.id)
end
// ---- shared end ----

// ---------- backend: Win32 ----------

let CLASS = "BrasaWindow"

type Font = record
    pub window: usize
    font: usize
end

var ready = false
var instance: usize = 0
var parking: usize = 0
var fonts: []Font

func be_init()
    if ready
        return
    end
    ready = true
    unsafe
        instance = GetModuleHandleA(0)
        var wc = WndClass{
            size: 80,
            proc: wndproc,
            instance: instance,
            cursor: LoadCursorA(0, 32512),
            background: GetSysColorBrush(COLOR_WINDOW),
            class_name: c.cstr(CLASS)
        }
        RegisterClassExA(&wc)
        // Hidden window that owns controls until `layout` moves them.
        parking = CreateWindowExA(0, c.cstr(CLASS), c.cstr(""), 0, 0, 0, 0, 0, 0, 0, instance, 0)
    end
    if parking == 0
        no_display("the window system refused a window")
    end
end

func make(class: text, label: text, ex: u32, style: u32) -> usize
    be_init()
    var h: usize = 0
    unsafe
        h = CreateWindowExA(ex, c.cstr(class), c.cstr(label), WS_CHILD bitor WS_VISIBLE bitor style, 0, 0, 10, 10, parking, 0, instance, 0)
    end
    return h
end

func be_create(kind: i32, label: text) -> usize
    if kind == TEXTBOX
        return make("EDIT", label, WS_EX_CLIENTEDGE, WS_TABSTOP bitor ES_AUTOHSCROLL)
    end
    if kind == BUTTON
        return make("BUTTON", label, 0, WS_TABSTOP)
    end
    if kind == LISTVIEW
        return make("LISTBOX", "", WS_EX_CLIENTEDGE, WS_TABSTOP bitor WS_VSCROLL bitor LBS_NOTIFY bitor LBS_NOINTEGRALHEIGHT)
    end
    return make("STATIC", label, 0, SS_CENTERIMAGE)
end

func be_window(title: text, width: i32, height: i32) -> usize
    be_init()
    var h: usize = 0
    unsafe
        let dpi = i32(GetDpiForSystem())
        h = CreateWindowExA(WS_EX_CONTROLPARENT, c.cstr(CLASS), c.cstr(title), WS_OVERLAPPEDWINDOW bitor WS_CLIPCHILDREN, CW_USEDEFAULT, CW_USEDEFAULT, scale(width, dpi), scale(height, dpi), 0, 0, instance, 0)
    end
    return h
end

func be_text(id: usize) -> text
    unsafe
        let n = GetWindowTextLengthA(id)
        let buf = c.alloc(usize(n + 1))
        GetWindowTextA(id, buf, n + 1)
        let s = c.from_cstr(buf)
        c.free(buf)
        return s
    end
end

func be_set_text(id: usize, value: text)
    unsafe
        SetWindowTextA(id, c.cstr(value))
    end
end

func be_text_len(id: usize) -> i32
    unsafe
        return GetWindowTextLengthA(id)
    end
end

func be_list_count(id: usize) -> i32
    unsafe
        return i32(SendMessageA(id, LB_GETCOUNT, 0, 0))
    end
end

func be_list_selected(id: usize) -> i32
    unsafe
        return i32(SendMessageA(id, LB_GETCURSEL, 0, 0))
    end
end

func be_list_select(id: usize, index: i32)
    unsafe
        SendMessageA(id, LB_SETCURSEL, usize(index), 0)
    end
end

func be_list_add(id: usize, item: text)
    unsafe
        SendMessageA(id, LB_ADDSTRING, 0, isize(c.cstr(item)))
    end
end

func be_list_remove(id: usize, index: i32)
    unsafe
        SendMessageA(id, LB_DELETESTRING, usize(index), 0)
    end
end

func be_list_clear(id: usize)
    unsafe
        SendMessageA(id, LB_RESETCONTENT, 0, 0)
    end
end

func be_adopt(window: usize, id: usize)
    unsafe
        SetParent(id, window)
    end
end

func be_move(id: usize, x: i32, y: i32, width: i32, height: i32)
    unsafe
        MoveWindow(id, x, y, width, height, 1)
    end
end

func be_client_width(window: usize) -> i32
    var r = Rect{}
    unsafe
        GetClientRect(window, &r)
    end
    return r.right
end

func be_client_height(window: usize) -> i32
    var r = Rect{}
    unsafe
        GetClientRect(window, &r)
    end
    return r.bottom
end

pub func be_dpi(window: usize) -> i32
    var d: i32 = 0
    unsafe
        d = i32(GetDpiForWindow(window))
    end
    if d == 0
        return 96
    end
    return d
end

func make_font(dpi: i32) -> usize
    unsafe
        // Segoe UI 9pt, ClearType
        return CreateFontA(-((9 * dpi + 36) / 72), 0, 0, 0, 400, 0, 0, 0, 1, 0, 0, 5, 0, c.cstr("Segoe UI"))
    end
end

func apply_font(root: Control, font: usize)
    for l in leaves(root)
        unsafe
            SendMessageA(l, WM_SETFONT, font, 1)
        end
    end
end

// A new layout tree: give its controls the window's font.
func be_style(window: usize, root: Control)
    let font = make_font(be_dpi(window))
    apply_font(root, font)
end

func be_show(window: usize)
    unsafe
        ShowWindow(window, SW_SHOW)
        SetForegroundWindow(window)
    end
end

func be_close(window: usize)
    unsafe
        DestroyWindow(window)
    end
end

func be_quit()
    unsafe
        PostQuitMessage(0)
    end
end

func be_exit(code: i32)
    unsafe
        ExitProcess(u32(code))
    end
end

func be_run()
    var m = Msg{}
    unsafe
        while GetMessageA(&m, 0, 0, 0) > 0
            let top = GetAncestor(m.hwnd, GA_ROOT)
            // IsDialogMessage gives Tab navigation and Enter = default button.
            if top == 0 or IsDialogMessageA(top, &m) == 0
                TranslateMessage(&m)
                DispatchMessageA(&m)
            end
        end
    end
end

func be_alert(message: text, title: text)
    unsafe
        MessageBoxA(0, c.cstr(message), c.cstr(title), 0x40)
    end
end

// The contents of the file named by BRASA_UI_SCRIPT, or empty text.
func be_script() -> text
    unsafe
        let name = c.alloc(usize(520))
        let n = GetEnvironmentVariableA(c.cstr("BRASA_UI_SCRIPT"), name, 512)
        if n == 0 or n > 512
            c.free(name)
            return ""
        end
        let h = CreateFileA(name, 0x80000000, 1, 0, 3, 0x80, 0)
        c.free(name)
        if h == 0xFFFFFFFFFFFFFFFF
            return ""
        end
        let size = i32(GetFileSize(h, 0))
        let buf = c.alloc(usize(size + 1))
        let got = sys.Scratch{}
        ReadFile(h, buf, u32(size), &got.a, 0)
        CloseHandle(h)
        let s = c.from_bytes(buf, got.a)
        c.free(buf)
        return s
    end
end

// Window procedure for every Brasa window; called by Windows.
func wndproc(hwnd: usize, msg: u32, wp: usize, lp: isize) -> isize
    if msg == WM_COMMAND
        let id = wp bitand 0xFFFF
        let code = i32((wp >> 16) bitand 0xFFFF)
        if id == IDOK
            enter_pressed(hwnd)
            return 0
        end
        if code == BN_CLICKED
            fire(usize(lp), EV_CLICK)
        end
        if code == EN_CHANGE and muted == 0
            fire(usize(lp), EV_CHANGE)
        end
        if code == LBN_SELCHANGE
            fire(usize(lp), EV_SELECT)
        end
        return 0
    end
    if msg == WM_SIZE
        relayout(hwnd)
        return 0
    end
    if msg == WM_DPICHANGED
        let font = make_font(i32(wp bitand 0xFFFF))
        for f in frames
            if f.id == hwnd and f.root != nil
                apply_font(f.root, font)
            end
        end
        relayout(hwnd)
    end
    if msg == WM_CTLCOLORSTATIC
        unsafe
            SetBkMode(wp, 1)
            return isize(GetSysColorBrush(COLOR_WINDOW))
        end
    end
    if msg == WM_DESTROY
        closed(hwnd)
        return 0
    end
    unsafe
        return DefWindowProcA(hwnd, msg, wp, lp)
    end
end
