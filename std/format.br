// =====================================================================
// Brasa standard library: format
//
//     use format
//     print(format.text("%(<8)%(>6)", ["apples", format.int(12)]))
//     print(format.pad_left("7", 3, "0"))      // 007
//
// Templates take their arguments as a list of texts; `int`, `hex`, `bin`, `float` and
// `thousands` turn numbers into texts. Widths count characters (UTF-8), not bytes.
//
//     %  %0         the next argument, or the argument at that position
//     %(>8)  %0(>8) with a layout: [[fill]align][0][width]; align is < (left), > (right) or ^ (center)
//     %%            a literal percent sign
//
// (Placeholders are not written with braces because a brace in a text literal starts an
// interpolation.)
// =====================================================================

package format

use math

// ---- characters and padding ----

// The number of characters (not bytes) in `s`.
func chars(s: text) -> int
    var n = 0
    var i = 0
    while i < s.len
        if (int(s[i]) bitand 192) != 128
            n += 1
        end
        i += 1
    end
    return n
end

// How many bytes the character that starts at byte `i` takes.
func char_len(s: text, i: int) -> int
    let b = int(s[i])
    var n = 1
    if b >= 240
        n = 4
    else if b >= 224
        n = 3
    else if b >= 192
        n = 2
    end
    if i + n > s.len
        n = s.len - i
    end
    return n
end

// `fill` written `n` times.
func repeat(fill: text, n: int) -> text
    var out = ""
    var piece = fill
    var k = n
    while k > 0
        if (k bitand 1) == 1
            out = out + piece
        end
        piece = piece + piece
        k = k >> 1
    end
    return out
end

// `s` with `fill` added before it until it is `width` characters wide.
func pad_left(s: text, width: int, fill: text = " ") -> text
    let n = chars(s)
    if n >= width
        return s
    end
    return repeat(fill, width - n) + s
end

// `s` with `fill` added after it until it is `width` characters wide.
func pad_right(s: text, width: int, fill: text = " ") -> text
    let n = chars(s)
    if n >= width
        return s
    end
    return s + repeat(fill, width - n)
end

// `s` in the middle of `width` characters; an odd extra fill goes on the right.
func center(s: text, width: int, fill: text = " ") -> text
    let n = chars(s)
    if n >= width
        return s
    end
    let k = width - n
    return repeat(fill, k / 2) + s + repeat(fill, k - k / 2)
end

// ---- numbers as text ----

// The decimal text of `n`.
func int(n: int) -> text
    return "{n}"
end

// The digits of `n` in `base` (2 to 16), lowercase, with a leading `-` for negative numbers.
// Works on the remainders, so the smallest 64-bit integer needs no special case.
func to_base(n: int, base: int) -> text
    if n == 0
        return "0"
    end
    let digits = "0123456789abcdef"
    var v = n
    var out = ""
    while v != 0
        var d = v % base
        if d < 0
            d = 0 - d
        end
        out = digits.slice(d, d + 1) + out
        v = v / base
    end
    if n < 0
        return "-" + out
    end
    return out
end

// `n` in base 16 without a prefix: `hex(255)` is "ff".
func hex(n: int) -> text
    return to_base(n, 16)
end

// `n` in base 2 without a prefix: `bin(5)` is "101".
func bin(n: int) -> text
    return to_base(n, 2)
end

// `n` with a comma between groups of three digits: `thousands(1234567)` is "1,234,567".
func thousands(n: int) -> text
    let all = to_base(n, 10)
    var sign = ""
    var digits = all
    if n < 0
        sign = "-"
        digits = all.slice(1, all.len)
    end
    var out = ""
    var i = digits.len
    while i > 3
        out = "," + digits.slice(i - 3, i) + out
        i -= 3
    end
    return sign + digits.slice(0, i) + out
end

// `x` with exactly `digits` decimals, halves away from zero: `float(3.14159, 2)` is "3.14".
func float(x: float, digits: int) -> text
    return math.fixed(x, digits)
end

// ---- templates ----

func is_align(b: int) -> bool
    return b == 60 or b == 62 or b == 94
end

// `s` laid out as `layout` says: [[fill]align][0][width].
func apply_layout(s: text, layout: text) -> text or error
    if layout.len == 0
        return s
    end
    let bad = "bad layout '" + layout + "'"
    var fill = " "
    var align = 0
    var p = 0
    let first = char_len(layout, 0)
    if first < layout.len and is_align(int(layout[first]))
        fill = layout.slice(0, first)
        align = int(layout[first])
        p = first + 1
    else if is_align(int(layout[0]))
        align = int(layout[0])
        p = 1
    end
    if p < layout.len and layout[p] == 48
        if align == 0
            fill = "0"
            align = 62
        end
        p += 1
    end
    var width = 0
    while p < layout.len
        let d = int(layout[p]) - 48
        if d < 0 or d > 9 or width > 100000000
            return error(bad)
        end
        width = width * 10 + d
        p += 1
    end
    if align == 62
        return pad_left(s, width, fill)
    end
    if align == 94
        return center(s, width, fill)
    end
    return pad_right(s, width, fill)
end

// `template` with its placeholders replaced by `args`.
func text(template: text, args: []text) -> text or error
    var out = ""
    var i = 0
    var auto = 0
    let n = template.len
    while i < n
        let c = int(template[i])
        if c == 37
            // % (37): a placeholder, or %% for a percent sign
            if i + 1 < n and template[i + 1] == 37
                out = out + "%"
                i += 2
            else
                i += 1
                var idx = 0
                var digits = 0
                while i < n and template[i] >= 48 and template[i] <= 57
                    idx = idx * 10 + (int(template[i]) - 48)
                    digits += 1
                    i += 1
                end
                if digits == 0
                    idx = auto
                    auto += 1
                end
                var layout = ""
                if i < n and template[i] == 40
                    var j = i + 1
                    while j < n and template[j] != 41
                        j += 1
                    end
                    if j >= n
                        return error("unclosed '(' in placeholder")
                    end
                    layout = template.slice(i + 1, j)
                    i = j + 1
                end
                if idx >= args.len
                    return error("missing argument {idx}")
                end
                let piece = try apply_layout(args[idx], layout)
                out = out + piece
            end
        else
            let len = char_len(template, i)
            out = out + template.slice(i, i + len)
            i += len
        end
    end
    return out
end
