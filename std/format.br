// =====================================================================
// Brasa standard library: format
//
//     use format
//     print(format.text("%(<8)%(>6)", ["apples", format.int(12)]))
//     print(format.pad_left("7", 3, "0"))      // 007
//
// Templates take their arguments as a list of texts; `int`, `hex`, `bin`, `float` and
// `thousands` turn numbers into texts. Widths count characters (UTF-8), not bytes.
//
//     %  %0         the next argument, or the argument at that position
//     %(>8)  %0(>8) with a layout: [[fill]align][0][width]; align is < (left), > (right) or ^ (center)
//     %%            a literal percent sign
//
// (Placeholders are not written with braces because a brace in a text literal starts an
// interpolation.)
// =====================================================================

package format

use math
use errors

// ---- characters and padding ----

// The number of characters (not bytes) in `s`.
func chars(s: text) -> int
    return s.char_count()
end

// How many bytes the character that starts at byte `i` takes.
func char_len(s: text, i: int) -> int
    let b = int(s.byte(i))
    var n = 1
    if b >= 240
        n = 4
    else if b >= 224
        n = 3
    else if b >= 192
        n = 2
    end
    if i + n > s.len
        n = s.len - i
    end
    return n
end

// `fill` written `n` times.
pub func repeat(fill: text, n: int) -> text
    var out = ""
    var piece = fill
    var k = n
    while k > 0
        if (k bitand 1) == 1
            out = out + piece
        end
        piece = piece + piece
        k = k >> 1
    end
    return out
end

// `s` with `fill` added before it until it is `width` characters wide.
pub func pad_left(s: text, width: int, fill: text = " ") -> text
    let n = chars(s)
    if n >= width
        return s
    end
    return repeat(fill, width - n) + s
end

// `s` with `fill` added after it until it is `width` characters wide.
pub func pad_right(s: text, width: int, fill: text = " ") -> text
    let n = chars(s)
    if n >= width
        return s
    end
    return s + repeat(fill, width - n)
end

// `s` in the middle of `width` characters; an odd extra fill goes on the right.
pub func center(s: text, width: int, fill: text = " ") -> text
    let n = chars(s)
    if n >= width
        return s
    end
    let k = width - n
    return repeat(fill, k / 2) + s + repeat(fill, k - k / 2)
end

// ---- numbers as text ----

// The decimal text of `n`.
pub func int(n: long) -> text
    return "{n}"
end

// The digits of `n` in `base` (2 to 16), lowercase, with a leading `-` for negative numbers.
// Works on the remainders, so the smallest 64-bit integer needs no special case.
func to_base(n: long, base: int) -> text
    if n == 0
        return "0"
    end
    let digits = "0123456789abcdef"
    var v = n
    var out = ""
    while v != 0
        var d = v % base
        if d < 0
            d = 0 - d
        end
        out = digits.slice(int(d), int(d) + 1) + out
        v = v / base
    end
    if n < 0
        return "-" + out
    end
    return out
end

// `n` in base 16 without a prefix: `hex(255)` is "ff".
pub func hex(n: long) -> text
    return to_base(n, 16)
end

// `n` in base 2 without a prefix: `bin(5)` is "101".
pub func bin(n: long) -> text
    return to_base(n, 2)
end

// `n` with a comma between groups of three digits: `thousands(1234567)` is "1,234,567".
pub func thousands(n: long) -> text
    let all = to_base(n, 10)
    var sign = ""
    var digits = all
    if n < 0
        sign = "-"
        digits = all.slice(1, all.len)
    end
    var out = ""
    var i = digits.len
    while i > 3
        out = "," + digits.slice(i - 3, i) + out
        i -= 3
    end
    return sign + digits.slice(0, i) + out
end

// `x` with exactly `digits` decimals, halves away from zero: `float(3.14159, 2)` is "3.14".
pub func float(x: float, digits: int) -> text
    return math.fixed(x, digits)
end

// ---- values of any type ----

// A value to put in a template: what `format.fmt` makes of its arguments.
pub type Value = enum
    Int(long)
    Float(float)
    Text(text)
    Bool(bool)
end

// Anything with a `to_value` method can be formatted. Integers, floats, text and booleans
// have one here; give your own types one that returns `format.Text("...")`.
pub type Valued = interface
    func to_value(self) -> Value
end

func (n: int) to_value() -> Value
    return Int(long(n))
end

func (n: long) to_value() -> Value
    return Int(n)
end

func (x: float) to_value() -> Value
    return Float(x)
end

func (s: text) to_value() -> Value
    return Text(s)
end

func (b: bool) to_value() -> Value
    return Bool(b)
end

func (n: i8) to_value() -> Value
    return Int(long(n))
end

func (n: i16) to_value() -> Value
    return Int(long(n))
end

func (n: u8) to_value() -> Value
    return Int(long(n))
end

func (n: u16) to_value() -> Value
    return Int(long(n))
end

func (n: u32) to_value() -> Value
    return Int(long(n))
end

func (n: u64) to_value() -> Value
    return Int(long(n))
end

func (x: f32) to_value() -> Value
    return Float(float(x))
end

// What kind of value `v` is, for messages.
func kind_name(v: Value) -> text
    match v
        Int(n) -> return "integer"
        Float(x) -> return "float"
        Text(s) -> return "text"
        Bool(b) -> return "boolean"
    end
end

// The way `print` shows `v`.
func plain(v: Value) -> text
    match v
        Int(n) -> return "{n}"
        Float(x) -> return "{x}"
        Text(s) -> return s
        Bool(b) -> return "{b}"
    end
end

func int_of(v: Value) -> long
    match v
        Int(n) -> return n
        Float(x) -> return 0
        Text(s) -> return 0
        Bool(b) -> return 0
    end
end

func float_of(v: Value) -> float
    match v
        Int(n) -> return 0.0
        Float(x) -> return x
        Text(s) -> return 0.0
        Bool(b) -> return 0.0
    end
end

// ---- layouts ----

func is_align(b: int) -> bool
    return b == 60 or b == 62 or b == 94
end

// A parsed layout: [[fill]align][0][width][.precision][type].
// `prec` is -1 without a precision and `kind` is empty without a type letter.
type Spec = record
    pub fill: text
    pub align: int
    pub width: int
    prec: int
    pub kind: text
end

func is_digit(b: int) -> bool
    return b >= 48 and b <= 57
end

func parse_layout(layout: text) -> Spec or error
    let bad = "bad layout '" + layout + "'"
    var fill = " "
    var align = 0
    var p = 0
    if layout.len > 0
        let first = char_len(layout, 0)
        if first < layout.len and is_align(int(layout.byte(first)))
            fill = layout.slice(0, first)
            align = int(layout.byte(first))
            p = first + 1
        else if is_align(int(layout.byte(0)))
            align = int(layout.byte(0))
            p = 1
        end
    end
    if p < layout.len and layout.byte(p) == 48
        if align == 0
            fill = "0"
            align = 62
        end
        p += 1
    end
    var width = 0
    while p < layout.len and is_digit(int(layout.byte(p)))
        if width > 100000000
            return error(errors.InvalidInput, bad)
        end
        width = width * 10 + (int(layout.byte(p)) - 48)
        p += 1
    end
    var prec = 0 - 1
    if p < layout.len and layout.byte(p) == 46
        p += 1
        var digits = 0
        prec = 0
        while p < layout.len and is_digit(int(layout.byte(p)))
            if prec > 1000
                return error(errors.InvalidInput, bad)
            end
            prec = prec * 10 + (int(layout.byte(p)) - 48)
            digits += 1
            p += 1
        end
        if digits == 0
            return error(errors.InvalidInput, bad)
        end
    end
    var kind = ""
    if p < layout.len
        let letter = layout.slice(p, p + 1)
        if letter != "d" and letter != "x" and letter != "X" and letter != "b" and letter != "," and letter != "f" and letter != "s"
            return error(errors.InvalidInput, bad)
        end
        kind = letter
        p += 1
    end
    if p < layout.len
        return error(errors.InvalidInput, bad)
    end
    return Spec { fill: fill, align: align, width: width, prec: prec, kind: kind }
end

// Hexadecimal digits in capitals.
func upper(s: text) -> text
    var out = ""
    var i = 0
    while i < s.len
        let c = int(s.byte(i))
        if c >= 97 and c <= 102
            out = out + "ABCDEF".slice(c - 97, c - 96)
        else
            out = out + s.slice(i, i + 1)
        end
        i += 1
    end
    return out
end

// `v` as text the way `spec` asks, before padding.
func render(v: Value, spec: Spec) -> text or error
    let kind = kind_name(v)
    let t = spec.kind
    if spec.prec >= 0 and t != "" and t != "f"
        return error(errors.InvalidInput, "a precision goes with 'f', not '{t}'")
    end
    if t == "" and spec.prec < 0
        return plain(v)
    end
    if t == "s"
        return plain(v)
    end
    if t == "f" or t == ""
        if kind != "float"
            if t == "f"
                return error(errors.InvalidInput, "'f' needs a float, got {kind}")
            end
            return error(errors.InvalidInput, "a precision needs a float, got {kind}")
        end
        var digits = 6
        if spec.prec >= 0
            digits = spec.prec
        end
        return math.fixed(float_of(v), digits)
    end
    if kind != "integer"
        return error(errors.InvalidInput, "'{t}' needs an integer, got {kind}")
    end
    let n = int_of(v)
    if t == "x"
        return hex(n)
    end
    if t == "X"
        return upper(hex(n))
    end
    if t == "b"
        return bin(n)
    end
    if t == ","
        return thousands(n)
    end
    return "{n}"
end

// `s` padded as `spec` says.
func pad(s: text, spec: Spec) -> text
    if spec.align == 62
        return pad_left(s, spec.width, spec.fill)
    end
    if spec.align == 94
        return center(s, spec.width, spec.fill)
    end
    return pad_right(s, spec.width, spec.fill)
end

// `v` laid out as `layout` says.
func apply_value(v: Value, layout: text) -> text or error
    let spec = try parse_layout(layout)
    let s = try render(v, spec)
    return pad(s, spec)
end

// `s` laid out as `layout` says: [[fill]align][0][width]. (A type letter or a precision other
// than `s` does not fit text.)
func apply_layout(s: text, layout: text) -> text or error
    let spec = try parse_layout(layout)
    if spec.prec >= 0 and spec.kind != "" and spec.kind != "f"
        return error(errors.InvalidInput, "a precision goes with 'f', not '{spec.kind}'")
    end
    if spec.kind == "f"
        return error(errors.InvalidInput, "'f' needs a float, got text")
    end
    if spec.kind == "" and spec.prec >= 0
        return error(errors.InvalidInput, "a precision needs a float, got text")
    end
    if spec.kind != "" and spec.kind != "s"
        return error(errors.InvalidInput, "'{spec.kind}' needs an integer, got text")
    end
    return pad(s, spec)
end

// ---- templates ----

// A piece of a template: literal text (`idx` is -1) or a placeholder.
type Piece = record
    pub lit: text
    pub idx: int
    pub layout: text
end

// The pieces of `template`, for `nargs` arguments.
func parse_template(template: text, nargs: int) -> []Piece or error
    let out: []Piece = []
    var cur = ""
    var i = 0
    var auto = 0
    let n = template.len
    while i < n
        let c = int(template.byte(i))
        if c == 37
            // % (37): a placeholder, or %% for a percent sign
            if i + 1 < n and template.byte(i + 1) == 37
                cur = cur + "%"
                i += 2
            else
                i += 1
                var idx = 0
                var digits = 0
                while i < n and template.byte(i) >= 48 and template.byte(i) <= 57
                    idx = idx * 10 + (int(template.byte(i)) - 48)
                    digits += 1
                    i += 1
                end
                if digits == 0
                    idx = auto
                    auto += 1
                end
                var layout = ""
                if i < n and template.byte(i) == 40
                    var j = i + 1
                    while j < n and template.byte(j) != 41
                        j += 1
                    end
                    if j >= n
                        return error(errors.InvalidInput, "unclosed '(' in placeholder")
                    end
                    layout = template.slice(i + 1, j)
                    i = j + 1
                end
                if idx >= nargs
                    return error(errors.InvalidInput, "missing argument {idx}")
                end
                if cur.len > 0
                    out.add(Piece { lit: cur, idx: 0 - 1, layout: "" })
                    cur = ""
                end
                out.add(Piece { lit: "", idx: idx, layout: layout })
            end
        else
            let len = char_len(template, i)
            cur = cur + template.slice(i, i + len)
            i += len
        end
    end
    if cur.len > 0
        out.add(Piece { lit: cur, idx: 0 - 1, layout: "" })
    end
    return out
end

// `template` with its placeholders replaced by the texts in `args`.
pub func text(template: text, args: []text) -> text or error
    let pieces = try parse_template(template, args.len)
    var out = ""
    for p in pieces
        if p.idx < 0
            out = out + p.lit
        else
            let piece = try apply_layout(args[p.idx], p.layout)
            out = out + piece
        end
    end
    return out
end

// `template` with its placeholders replaced by `args`.
func values(template: text, args: []Value) -> text or error
    let pieces = try parse_template(template, args.len)
    var out = ""
    for p in pieces
        if p.idx < 0
            out = out + p.lit
        else
            let piece = try apply_value(args[p.idx], p.layout)
            out = out + piece
        end
    end
    return out
end

// `format.fmt(template, a, b, ...)` is `fmtN` for N values (at most eight): values of any
// type that is a `Valued`.
pub func fmt0(template: text) -> text or error
    let vs: []Value = []
    return values(template, vs)
end

pub func fmt1<A: Valued>(template: text, a: A) -> text or error
    return values(template, [a.to_value()])
end

pub func fmt2<A: Valued, B: Valued>(template: text, a: A, b: B) -> text or error
    return values(template, [a.to_value(), b.to_value()])
end

pub func fmt3<A: Valued, B: Valued, C: Valued>(template: text, a: A, b: B, c: C) -> text or error
    return values(template, [a.to_value(), b.to_value(), c.to_value()])
end

pub func fmt4<A: Valued, B: Valued, C: Valued, D: Valued>(template: text, a: A, b: B, c: C, d: D) -> text or error
    return values(template, [a.to_value(), b.to_value(), c.to_value(), d.to_value()])
end

pub func fmt5<A: Valued, B: Valued, C: Valued, D: Valued, E: Valued>(template: text, a: A, b: B, c: C, d: D, e: E) -> text or error
    return values(template, [a.to_value(), b.to_value(), c.to_value(), d.to_value(), e.to_value()])
end

pub func fmt6<A: Valued, B: Valued, C: Valued, D: Valued, E: Valued, F: Valued>(template: text, a: A, b: B, c: C, d: D, e: E, f: F) -> text or error
    return values(template, [a.to_value(), b.to_value(), c.to_value(), d.to_value(), e.to_value(), f.to_value()])
end

pub func fmt7<A: Valued, B: Valued, C: Valued, D: Valued, E: Valued, F: Valued, G: Valued>(template: text, a: A, b: B, c: C, d: D, e: E, f: F, g: G) -> text or error
    return values(template, [a.to_value(), b.to_value(), c.to_value(), d.to_value(), e.to_value(), f.to_value(), g.to_value()])
end

pub func fmt8<A: Valued, B: Valued, C: Valued, D: Valued, E: Valued, F: Valued, G: Valued, H: Valued>(template: text, a: A, b: B, c: C, d: D, e: E, f: F, g: G, h: H) -> text or error
    return values(template, [a.to_value(), b.to_value(), c.to_value(), d.to_value(), e.to_value(), f.to_value(), g.to_value(), h.to_value()])
end
