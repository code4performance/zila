// =====================================================================
// Zila Lang standard library: files (`use fs`)
//
// Written in Zila Lang on top of Windows overlapped I/O and the scheduler's
// completion port (std/task.zila). Reading and writing never block other
// tasks: the operating system moves the data while the scheduler runs
// something else.
//
//   let text = try await fs.read("notes.txt")
//   try await fs.write("copy.txt", text)
//
// Large files are transferred in 64 KiB pieces. Errors name the path and
// the reason Windows gives ("notes.txt: The system cannot find the file
// specified.").
// =====================================================================

package fs

use c
use sys
use errors
use task
use bufio
use text

#[link("kernel32")]
extern "system" func CreateFileW(name: *u8, access: u32, share: u32, security: usize, disposition: u32, flags: u32, template: usize) -> usize
extern "system" func ReadFile(handle: usize, buffer: *u8, count: u32, done: usize, overlapped: *task.Op) -> i32
extern "system" func WriteFile(handle: usize, buffer: *u8, count: u32, done: usize, overlapped: *task.Op) -> i32
extern "system" func CloseHandle(handle: usize) -> i32
extern "system" func GetStdHandle(n: i32) -> usize
extern "system" func SetConsoleCP(code_page: u32) -> i32
extern "system" func GetFileSizeEx(handle: usize, size: *long) -> i32
extern "system" func MultiByteToWideChar(codepage: u32, flags: u32, source: *u8, source_len: i32, dest: *u8, dest_len: i32) -> i32

let ERROR_IO_PENDING = 997
let ERROR_HANDLE_EOF = 38
let ERROR_BROKEN_PIPE = 109
let CHUNK = 65536

// Owns an open file handle; closes it when the last reference goes away.
#[shared]
pub type File = record
    pub handle: usize
    pub open: bool
end

pub func (ref f: File) drop()
    f.close()
end

// Closes the handle now (once).
pub func (f: File) close()
    if f.open
        f.open = false
        unsafe
            CloseHandle(f.handle)
        end
    end
end

// The path as a NUL-terminated UTF-16 string.
func wide(path: text) -> sys.Buf
    return sys.wide(path)
end

func open_file(path: text, write: bool) -> File or error
    if write
        return open_file_mode(path, 1)
    end
    return open_file_mode(path, 0)
end

// mode 0: an existing file to read; 1: create or replace for writing; 2: open or create for writing
func open_file_mode(path: text, mode: long) -> File or error
    let w = wide(path)
    var access: u32 = 0x80000000
    var disposition: u32 = 3
    if mode == 1
        access = 0x40000000
        disposition = 2
    end
    if mode == 2
        access = 0x40000000
        disposition = 4
    end
    var h: usize = 0
    unsafe
        h = CreateFileW(w.ptr, access, 1, 0, disposition, 0x40000000, 0)
    end
    if h == 0xFFFFFFFFFFFFFFFF
        return sys.error_for(task.last_error(), path)
    end
    task.io_attach(h)
    return File{ handle: h, open: true }
end

func file_size(f: File, path: text) -> long or error
    let s = sys.Scratch{}
    var ok: long = 0
    unsafe
        ok = GetFileSizeEx(f.handle, &s.a)
    end
    if ok == 0
        return sys.error_for(task.last_error(), path)
    end
    return s.a
end

// Moves up to `count` bytes at `offset` between the file and memory and waits
// for the operating system to finish. Returns the bytes moved (0 at end of file).
func transfer(f: File, ptr: *u8, count: long, offset: long, write: bool, path: text) -> long or error
    let op = task.op_new()
    op.offset = u32(offset bitand 0xFFFFFFFF)
    op.offset_high = u32(offset >> 32)
    var ok: long = 0
    var err: long = 0
    unsafe
        if write
            ok = WriteFile(f.handle, ptr, u32(count), 0, &op)
        else
            ok = ReadFile(f.handle, ptr, u32(count), 0, &op)
        end
    end
    if ok == 0
        err = task.last_error()
        if err != ERROR_IO_PENDING
            task.op_release(op)
            return sys.error_for(err, path)
        end
    end
    task.op_submit(op)
    task.op_wait(op)
    let status = op.status
    let moved = op.bytes
    task.op_release(op)
    if status == ERROR_HANDLE_EOF
        return 0
    end
    if status != 0
        return sys.error_for(status, path)
    end
    return moved
end

// Reads a whole file.
pub async func read(path: text) -> text or error
    task.io_init()
    let f = try open_file(path, false)
    let size = try file_size(f, path)
    let b = sys.buffer(size + 1)
    var done: long = 0
    while done < size
        var count = size - done
        if count > CHUNK
            count = CHUNK
        end
        let got = try transfer(f, b.ptr + done, count, done, false, path)
        if got == 0
            break
        end
        done += got
    end
    return c.from_bytes(b.ptr, done)
end

// Creates the file (or replaces it) with `data`.
pub async func write(path: text, data: text) -> error
    task.io_init()
    let f = try open_file(path, true)
    let bytes = data.len
    var done: long = 0
    while done < bytes
        var count = bytes - done
        if count > CHUNK
            count = CHUNK
        end
        let put = try transfer(f, c.cstr(data) + done, count, done, true, path)
        done += put
    end
    return
end

// ---- buffered reading and writing ----

// Reads a file in pieces of 64 KiB and hands it out by lines or bytes.
#[shared]
pub type Reader = record
    pub file: File
    pub path: text
    pub offset: long
    pub buf: bufio.InBuf
    pub reads: long
    // True for the reader of standard input (see `stdin`): it reads the process's handle 0 and
    // waits for the whole program, and closing it leaves standard input open.
    pub std: bool
end

// Collects writes and gives them to the system in large pieces.
#[shared]
pub type Writer = record
    pub file: File
    pub path: text
    pub offset: long
    pub buf: bufio.OutBuf
    pub writes: long
end

// Opens an existing file for reading by lines or bytes.
pub async func open(path: text) -> Reader or error
    task.io_init()
    let f = try open_file_mode(path, 0)
    return Reader{ file: f, path: path, offset: 0, buf: bufio.input(), reads: 0, std: false }
end

// A reader over standard input: a pipe, a redirected file or the terminal. It has the methods of
// a file reader. Unlike files it waits for the whole program (other tasks do not run while it
// waits for data), and closing it does not close standard input.
pub func stdin() -> Reader
    // A terminal hands over what is typed in its input code page (CP850 and the like, where
    // `ç` is one byte that is not UTF-8). Programs run with UTF-8 output, so ask for UTF-8 input
    // too; when standard input is not a console this does nothing.
    unsafe
        SetConsoleCP(65001)
    end
    let f = File{ handle: 0, open: false }
    return Reader{ file: f, path: "standard input", offset: 0, buf: bufio.input(), reads: 0, std: true }
end

// One synchronous read from standard input: the bytes read, 0 at the end of the input.
func stdin_read(ptr: *u8, count: long) -> long or error
    var done: usize = 0
    var ok: i32 = 0
    var err: long = 0
    unsafe
        ok = ReadFile(GetStdHandle(-10), ptr, u32(count), usize(&done), usize(0))
    end
    if ok == 0
        err = task.last_error()
        if err == ERROR_BROKEN_PIPE or err == ERROR_HANDLE_EOF
            return 0
        end
        return sys.error_for(err, "standard input")
    end
    return long(done)
end

// Creates the file (or replaces it) for buffered writing.
pub async func create(path: text) -> Writer or error
    task.io_init()
    let f = try open_file_mode(path, 1)
    return Writer{ file: f, path: path, offset: 0, buf: bufio.output(), writes: 0 }
end

// Opens the file (creating it when it does not exist) for buffered writing at its end.
pub async func append(path: text) -> Writer or error
    task.io_init()
    let f = try open_file_mode(path, 2)
    let size = try file_size(f, path)
    return Writer{ file: f, path: path, offset: size, buf: bufio.output(), writes: 0 }
end

// Brings in the next piece of the file; the end of the file finishes the buffer.
pub async func (r: Reader) fill() -> error
    if r.buf.finished()
        return
    end
    let b = sys.buffer(CHUNK)
    var got: long = 0
    if r.std
        got = try stdin_read(b.ptr, CHUNK)
    else
        got = try transfer(r.file, b.ptr, CHUNK, r.offset, false, r.path)
    end
    r.reads += 1
    if got == 0
        r.buf.finish()
        return
    end
    r.offset += got
    r.buf.feed(c.from_bytes(b.ptr, got))
    return
end

// The next line without its `\n` or `\r\n`, or the error `end of file`.
pub async func (r: Reader) read_line() -> text or error
    while not r.buf.has_line()
        if r.buf.finished()
            break
        end
        try await r.fill()
    end
    if not r.buf.has_line()
        return error(errors.UnexpectedEof, "end of file")
    end
    return r.buf.take_line()
end

// Up to `max` bytes; empty text at the end of the file.
pub async func (r: Reader) read(max: int) -> text or error
    if r.buf.unread() == 0
        try await r.fill()
    end
    return r.buf.take(max)
end

// Everything that is left.
pub async func (r: Reader) read_all() -> text or error
    while not r.buf.finished()
        try await r.fill()
    end
    return r.buf.take_all()
end

// True when nothing is left to read.
pub async func (r: Reader) at_end() -> bool or error
    if r.buf.unread() == 0 and not r.buf.finished()
        try await r.fill()
    end
    return r.buf.unread() == 0
end

// Closes the file now.
pub async func (r: Reader) close()
    r.buf.finish()
    r.file.close()
end

// Hands everything that is buffered to the system.
pub async func (w: Writer) drain() -> error
    if w.buf.len() == 0
        return
    end
    let data = w.buf.take()
    var done: long = 0
    while done < data.len
        let put = try transfer(w.file, c.cstr(data) + done, data.len - done, w.offset + done, true, w.path)
        w.writes += 1
        done += put
    end
    w.offset += data.len
    return
end

// Adds `data` to the file (the system sees it once 64 KiB have gathered, or on `flush`).
pub async func (w: Writer) write(data: text) -> error
    w.buf.add(data)
    if w.buf.len() >= CHUNK
        try await w.drain()
    end
    return
end

// Adds `data` and a newline.
pub async func (w: Writer) write_line(data: text) -> error
    w.buf.add(data)
    w.buf.add("\n")
    if w.buf.len() >= CHUNK
        try await w.drain()
    end
    return
end

// Writes out whatever is buffered.
pub async func (w: Writer) flush() -> error
    try await w.drain()
    return
end

// Flushes and closes the file.
pub async func (w: Writer) close() -> error
    try await w.drain()
    w.file.close()
    return
end

// ---- named pipes (Windows) ----

let ERROR_BROKEN_PIPE = 109
let ERROR_PIPE_BUSY = 231

// The client end of a named pipe, such as `\.\pipe\MSSQL$SQL2025\sql\query`: a byte stream that
// reads and writes without blocking the other tasks. Closes when the last reference goes away.
#[shared]
pub type Pipe = record
    pub handle: usize
    pub path: text
    pub open: bool
end

pub func (ref p: Pipe) drop()
    if p.open
        p.open = false
        unsafe
            CloseHandle(p.handle)
        end
    end
end

// Opens the named pipe `path` for reading and writing. A pipe whose server is busy with other
// clients is retried for about a second. Errors name the path and the reason Windows gives.
pub async func pipe(path: text) -> Pipe or error
    task.io_init()
    let w = wide(path)
    var tries = 0
    while true
        var h: usize = 0
        unsafe
            h = CreateFileW(w.ptr, 0xC0000000, 0, 0, 3, 0x40000000, 0)
        end
        if h != 0xFFFFFFFFFFFFFFFF
            task.io_attach(h)
            return Pipe{ handle: h, path: path, open: true }
        end
        let err = task.last_error()
        tries += 1
        if err != ERROR_PIPE_BUSY or tries > 20
            return sys.error_for(err, path)
        end
        await sleep(50)
    end
    return error(errors.Io, path)
end

// Receives up to `max` bytes; empty text means the other end closed the pipe.
pub async func (p: Pipe) read(max: long) -> text or error
    if not p.open
        return ""
    end
    let view = File{ handle: p.handle, open: false }
    let b = sys.buffer(max + 1)
    var got: long = 0
    match transfer(view, b.ptr, max, 0, false, p.path)
        ok(n) -> got = n
        err(e) ->
            if text.contains(e.message, "pipe has been ended") or text.contains(e.message, "pipe is being closed")
                return ""
            end
            return e
    end
    return c.from_bytes(b.ptr, got)
end

// Sends all of `data`.
pub async func (p: Pipe) write(data: text) -> error
    if not p.open
        return error(errors.Closed, "write: the pipe is closed")
    end
    let view = File{ handle: p.handle, open: false }
    var done: long = 0
    while done < data.len
        var count = data.len - done
        if count > CHUNK
            count = CHUNK
        end
        let put = try transfer(view, c.cstr(data) + done, count, 0, true, p.path)
        if put == 0
            return error(errors.Closed, "write: the pipe is closed")
        end
        done += put
    end
    return
end

// Closes the pipe now.
pub async func (p: Pipe) close()
    if p.open
        p.open = false
        unsafe
            CloseHandle(p.handle)
        end
    end
end
