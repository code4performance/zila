// =====================================================================
// Zila Lang standard library: futures (`async func`, `await`)
//
// Written in Zila Lang. The compiler lowers
//
//     async func f(a) -> T          to      a function returning Future<T>
//     await e                       to      future.wait(e)
//
// An async function runs as its own task (a fiber, see std/task.zila). The
// value it returns is stored in `slot` as a plain word; `slot` is a list
// created with the element-ownership flag of T, so a result nobody awaited
// is released together with the future.
//
// `await` is allowed in any function, not only in `async` ones: it parks the current task.
// A future can be awaited once: `wait` takes the value out of the slot.
// =====================================================================

package future

use task
use errors

// Reference semantics: copying a Future would split its waiters from its result.
#[shared]
pub type Future = record
    pub done: bool
    pub slot: []long
    waiters: []long
end

func future_new() -> Future
    return Future{}
end

// Stores the result and wakes every task waiting for it.
func complete(fut: Future, word: long)
    fut.slot.add(word)
    fut.done = true
    for i in 0..fut.waiters.len
        task.wake(fut.waiters[i])
    end
    fut.waiters.clear()
end

// Waits for the future without blocking other tasks and takes its value.
func wait(fut: Future) -> long
    task.init()
    while not fut.done
        fut.waiters.add(task.cur())
        task.park()
    end
    if fut.slot.len == 0
        task.fatal("future already awaited")
    end
    return fut.slot.take()
end

// Waits until at least one of the futures is done; returns its index.
func wait_any(fs: []Future) -> long
    task.init()
    while true
        for i in 0..fs.len
            if fs[i].done
                return i
            end
        end
        for i in 0..fs.len
            fs[i].waiters.add(task.cur())
        end
        task.park()
    end
    return 0
end

// Waits until `f` completes or `ms` milliseconds have passed; 1 when `f` completed.
// A stale wake-up (from an earlier timer) only makes the loop check again.
pub func timeout_wait(ms: long, f: Future) -> long
    task.init()
    let me = task.cur()
    let deadline = task.now() + ms
    task.add_timer(deadline, func()
        task.wake(me)
    end)
    while not f.done and task.now() < deadline
        f.waiters.add(me)
        task.park()
    end
    if f.done
        return 1
    end
    return 0
end

// The error of `timeout(ms, f)` when `ms` pass first.
pub func timed_out() -> error?
    return error(errors.Timeout, "timed out")
end

// A future that completes `ms` milliseconds from now (`await sleep(ms)`).
func sleep_future(ms: long) -> Future
    task.init()
    let fut = Future{}
    task.add_timer(task.now() + ms, func()
        complete(fut, 0)
    end)
    return fut
end

// Runs `body` as a task and completes `fut` with the word it returns.
func launch(body: func() -> long, fut: Future)
    task.start(func()
        complete(fut, body())
    end)
end
