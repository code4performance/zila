// =====================================================================
// Brasa standard library: math on floats
//
//     use math
//     println(math.sqrt(2.25))        // 1.5
//
// `sqrt`, `floor`, `ceil` and `trunc` use the processor's own instructions
// (through the compiler intrinsics `__sqrt`, `__floor`, `__ceil` and `__trunc`).
// The rest is written in Brasa.
// =====================================================================

package math

use errors

// Square root. `sqrt(-1.0)` is NaN.
#[no_alloc]
func sqrt(x: float) -> float
    return __sqrt(x)
end

// Largest whole number not above x.
#[no_alloc]
func floor(x: float) -> float
    return __floor(x)
end

// Smallest whole number not below x.
#[no_alloc]
func ceil(x: float) -> float
    return __ceil(x)
end

// x without its fractional part (rounds toward zero).
#[no_alloc]
func trunc(x: float) -> float
    return __trunc(x)
end

#[no_alloc]
func abs(x: float) -> float
    if x < 0.0 or (x == 0.0 and 1.0 / x < 0.0)
        return -x
    end
    return x
end

#[no_alloc]
func min(a: float, b: float) -> float
    if b < a
        return b
    end
    return a
end

#[no_alloc]
func max(a: float, b: float) -> float
    if b > a
        return b
    end
    return a
end

// Nearest whole number; halves round away from zero (`round(2.5)` is 3.0, `round(-2.5)` is -3.0).
#[no_alloc]
func round(x: float) -> float
    let t = __trunc(x)
    let d = abs(x - t)
    if d >= 0.5
        if x < 0.0
            return t - 1.0
        end
        return t + 1.0
    end
    return t
end

// x to a whole-number power; negative powers give 1 / x^|n|.
#[no_alloc]
func pow(x: float, n: int) -> float
    var e = n
    if e < 0
        e = 0 - e
    end
    var result = 1.0
    var base = x
    while e > 0
        if (e bitand 1) == 1
            result = result * base
        end
        base = base * base
        e = e >> 1
    end
    if n < 0
        return 1.0 / result
    end
    return result
end

// x written with exactly `digits` decimals: `fixed(3.14159, 2)` is "3.14".
// NaN, infinities and numbers too large to scale are written like `print` does.
func fixed(x: float, digits: int) -> text
    if x != x or x > 1.0e15 or x < -1.0e15 or digits < 0 or digits > 15
        return "{x}"
    end
    let scaled = round(abs(x) * pow(10.0, digits))
    if scaled >= 9.0e15
        return "{x}"
    end
    let n = long(scaled)
    var out = ""
    if x < 0.0 and n != 0
        out = "-"
    end
    if digits == 0
        return out + "{n}"
    end
    let unit = long(pow(10.0, digits))
    var frac = "{n % unit}"
    while frac.len < digits
        frac = "0" + frac
    end
    return out + "{n / unit}." + frac
end

// ---- checked integer arithmetic ----
// `+`, `-` and `*` on integers wrap at the width of the type and never fail. When a program
// needs to know, these return the exact result or an error: kind `Overflow` when it does not
// fit, kind `InvalidInput` for a zero divisor. `checked_add` and its friends work on `int`
// (32 bits); the `_long` versions work on `long` (64 bits).

func checked_add(a: int, b: int) -> int or error
    let r = long(a) + long(b)
    if r != long(int(r))
        return error(errors.Overflow, "integer overflow: {a} + {b}")
    end
    return int(r)
end

func checked_sub(a: int, b: int) -> int or error
    let r = long(a) - long(b)
    if r != long(int(r))
        return error(errors.Overflow, "integer overflow: {a} - {b}")
    end
    return int(r)
end

func checked_mul(a: int, b: int) -> int or error
    let r = long(a) * long(b)
    if r != long(int(r))
        return error(errors.Overflow, "integer overflow: {a} * {b}")
    end
    return int(r)
end

// Whole-number division, rounding toward zero. `MIN / -1` does not fit.
func checked_div(a: int, b: int) -> int or error
    if b == 0
        return error(errors.InvalidInput, "division by zero: {a} / {b}")
    end
    let least = 0 - 2147483647 - 1
    if a == least and b == -1
        return error(errors.Overflow, "integer overflow: {a} / {b}")
    end
    return a / b
end

func checked_add_long(a: long, b: long) -> long or error
    let r = a + b
    if (b > 0 and r < a) or (b < 0 and r > a)
        return error(errors.Overflow, "integer overflow: {a} + {b}")
    end
    return r
end

func checked_sub_long(a: long, b: long) -> long or error
    let r = a - b
    if (b > 0 and r > a) or (b < 0 and r < a)
        return error(errors.Overflow, "integer overflow: {a} - {b}")
    end
    return r
end

func checked_mul_long(a: long, b: long) -> long or error
    if a == 0 or b == 0
        return 0
    end
    let least: long = 0 - 9223372036854775807 - 1
    if (a == -1 and b == least) or (b == -1 and a == least)
        return error(errors.Overflow, "integer overflow: {a} * {b}")
    end
    let r = a * b
    if r / b != a
        return error(errors.Overflow, "integer overflow: {a} * {b}")
    end
    return r
end

func checked_div_long(a: long, b: long) -> long or error
    if b == 0
        return error(errors.InvalidInput, "division by zero: {a} / {b}")
    end
    let least: long = 0 - 9223372036854775807 - 1
    if a == least and b == -1
        return error(errors.Overflow, "integer overflow: {a} / {b}")
    end
    return a / b
end
