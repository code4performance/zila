// =====================================================================
// Zila Lang standard library: TCP networking (`use net`)
//
// Written in Zila Lang on Winsock with overlapped sockets and the scheduler's
// completion port (std/task.zila). No call blocks the other tasks.
//
//   let listener = try await net.listen(8080)
//   let conn = try await listener.accept()
//   let request = try await conn.read(4096)
//   try await conn.write("hello")
//
//   let client = try await net.connect("127.0.0.1", 8080)
//
// `read` returns empty text when the peer closed the connection. Sockets
// close when the last reference to them goes away, or earlier with `close()`.
// Numeric IPv4 addresses never block; a host name goes through the Windows
// resolver, which blocks every task until it answers.
// =====================================================================

package net

use c
use sys
use errors
use task
use ws
use bufio

let AF_INET = 2
let SOCK_STREAM = 1
let NS_DNS = 12
let SOCK_DGRAM = 2
let IPPROTO_UDP = 17
let SIO_UDP_CONNRESET: u32 = 0x9800000C
let WSAEMSGSIZE = 10040
let ERROR_MORE_DATA = 234
let IPPROTO_TCP = 6
let WSA_FLAG_OVERLAPPED = 1
let SOL_SOCKET = 0xFFFF
let SO_UPDATE_ACCEPT_CONTEXT = 0x700B
let SO_UPDATE_CONNECT_CONTEXT = 0x7010
let SIO_GET_EXTENSION_FUNCTION_POINTER: u32 = 0xC8000006
let ERROR_IO_PENDING = 997
let INVALID_SOCKET: usize = 0xFFFFFFFFFFFFFFFF

type ConnectExFn = extern "system" func(usize, *u8, i32, usize, u32, usize, *task.Op) -> i32
type AcceptExFn = extern "system" func(usize, usize, *u8, u32, u32, u32, usize, *task.Op) -> i32

var started = false
var connect_ex: ConnectExFn
var accept_ex: AcceptExFn

// An open connection. Closes its socket when the last reference goes away.
#[shared]
pub type Conn = record
    pub sock: usize
    pub open: bool
end

pub func (ref conn: Conn) drop()
    if conn.open
        unsafe
            ws.closesocket(conn.sock)
        end
        conn.open = false
    end
end

// A listening socket and the port it listens on.
#[shared]
pub type Listener = record
    pub sock: usize
    pub port: long
    pub open: bool
end

pub func (ref l: Listener) drop()
    if l.open
        unsafe
            ws.closesocket(l.sock)
        end
        l.open = false
    end
end

func new_socket_of(kind: i32, protocol: i32) -> usize
    var s: usize = INVALID_SOCKET
    unsafe
        s = ws.WSASocketW(AF_INET, kind, protocol, 0, 0, WSA_FLAG_OVERLAPPED)
    end
    if s != INVALID_SOCKET
        task.io_attach(s)
    end
    return s
end

func new_socket() -> usize
    return new_socket_of(SOCK_STREAM, IPPROTO_TCP)
end

// Looks up a Winsock extension function (ConnectEx, AcceptEx) by its GUID.
func extension(s: usize, guid: sys.Buf) -> long
    let out = sys.Scratch{}
    let size = sys.Scratch{}
    var rc: long = 0
    unsafe
        rc = ws.WSAIoctl(s, SIO_GET_EXTENSION_FUNCTION_POINTER, guid.ptr, 16, &out.a, 8, &size.a, 0, 0)
    end
    if rc != 0
        return 0
    end
    return out.a
end

func put_bytes(p: *u8, b0: long, b1: long, b2: long, b3: long, b4: long, b5: long, b6: long, b7: long)
    unsafe
        p[0] = u8(b0)
        p[1] = u8(b1)
        p[2] = u8(b2)
        p[3] = u8(b3)
        p[4] = u8(b4)
        p[5] = u8(b5)
        p[6] = u8(b6)
        p[7] = u8(b7)
    end
end

// Starts Winsock and finds ConnectEx and AcceptEx, once.
func net_init() -> error
    if started
        return
    end
    let data = sys.buffer(512)
    var rc: long = 0
    unsafe
        rc = ws.WSAStartup(0x0202, data.ptr)
    end
    if rc != 0
        return error(errors.Io, "cannot start Winsock (error {rc})")
    end
    task.io_init()
    let s = new_socket()
    if s == INVALID_SOCKET
        return sys.error_for(task.last_error(), "cannot create a socket")
    end
    // {25a207b9-ddf3-4660-8ee9-76e58c74063e}
    let g1 = sys.buffer(16)
    put_bytes(g1.ptr, 0xB9, 0x07, 0xA2, 0x25, 0xF3, 0xDD, 0x60, 0x46)
    put_bytes(g1.ptr + 8, 0x8E, 0xE9, 0x76, 0xE5, 0x8C, 0x74, 0x06, 0x3E)
    // {b5367df1-cbac-11cf-95ca-00805f48a192}
    let g2 = sys.buffer(16)
    put_bytes(g2.ptr, 0xF1, 0x7D, 0x36, 0xB5, 0xAC, 0xCB, 0xCF, 0x11)
    put_bytes(g2.ptr + 8, 0x95, 0xCA, 0x00, 0x80, 0x5F, 0x48, 0xA1, 0x92)
    connect_ex = extension(s, g1)
    accept_ex = extension(s, g2)
    unsafe
        ws.closesocket(s)
    end
    started = true
    return
end

// A sockaddr_in for an IPv4 address given as a 32-bit number and a port.
func make_addr(ip: long, port: long) -> sys.Buf
    let b = sys.buffer(16)
    put_bytes(b.ptr, AF_INET, 0, (port >> 8) bitand 255, port bitand 255, (ip >> 24) bitand 255, (ip >> 16) bitand 255, (ip >> 8) bitand 255, ip bitand 255)
    return b
end

// "a.b.c.d" as a number, or -1 when `host` is not a numeric IPv4 address.
pub func parse_ip(host: text) -> long
    var ip: long = 0
    var parts: long = 0
    var value: long = 0
    var digits: long = 0
    for i in 0..host.len + 1
        var ch: long = 46
        if i < host.len
            ch = long(host.byte(i))
        end
        if ch == 46
            if digits == 0 or value > 255
                return -1
            end
            ip = ip * 256 + value
            parts += 1
            value = 0
            digits = 0
        else if ch >= 48 and ch <= 57
            value = value * 10 + (ch - 48)
            digits += 1
        else
            return -1
        end
    end
    if parts != 4
        return -1
    end
    return ip
end

// The first IPv4 address of `host` as "a.b.c.d". A numeric address is returned as it is; a
// name goes through the asynchronous Windows resolver: the task waits and the others run.
pub async func lookup(host: text) -> text or error
    if parse_ip(host) >= 0
        return host
    end
    try net_init()
    let name = sys.wide(host)
    let hints = sys.buffer(80)
    unsafe
        hints.ptr[4] = AF_INET
        hints.ptr[8] = SOCK_STREAM
    end
    let res = sys.Scratch{}
    let op = task.op_new()
    var rc: long = 0
    unsafe
        rc = ws.GetAddrInfoExW(name.ptr, 0, NS_DNS, 0, hints.ptr, &res.a, 0, &op, task.dns_done, 0)
    end
    if rc == ERROR_IO_PENDING
        task.op_submit(op)
        task.op_wait(op)
        rc = op.status
    end
    task.op_release(op)
    if rc != 0
        return error(errors.NotFound, "cannot resolve '{host}'")
    end
    // the first AF_INET entry of the list (ADDRINFOEXW: family at 4, address at 32, next at 64)
    var found = ""
    var info = res.a
    var guard: long = 0
    while info != 0 and guard < 32
        let node: *u8 = info
        let slot: *long = info + 32
        let next: *long = info + 64
        unsafe
            if node[4] == AF_INET and found == ""
                let addr: *u8 = slot[0]
                found = "{long(addr[4])}.{long(addr[5])}.{long(addr[6])}.{long(addr[7])}"
            end
            info = next[0]
        end
        guard += 1
    end
    unsafe
        ws.FreeAddrInfoExW(usize(res.a))
    end
    if found == ""
        return error(errors.NotFound, "cannot resolve '{host}'")
    end
    return found
end

// The IPv4 address of `host` as a number, for building a socket address.
pub async func resolve(host: text) -> long or error
    let text_ip = try await lookup(host)
    return parse_ip(text_ip)
end

// Waits for an operation the system accepted (or finished at once) and
// returns the bytes it moved.
func await_op(op: task.Op, accepted: bool, err: long, what: text) -> long or error
    if not accepted and err != ERROR_IO_PENDING
        task.op_release(op)
        return sys.error_for(err, what)
    end
    task.op_submit(op)
    task.op_wait(op)
    let status = op.status
    let moved = op.bytes
    task.op_release(op)
    if status != 0
        return sys.error_for(status, what)
    end
    return moved
end

// Connects to a TCP server.
pub async func connect(host: text, port: long) -> Conn or error
    try net_init()
    let ip = try await resolve(host)
    let s = new_socket()
    if s == INVALID_SOCKET
        return sys.error_for(task.last_error(), "cannot create a socket")
    end
    let conn = Conn{ sock: s, open: true }
    // ConnectEx wants the socket bound first
    let local = make_addr(0, 0)
    var rc: long = 0
    unsafe
        rc = ws.bind(s, local.ptr, 16)
    end
    if rc != 0
        return sys.error_for(task.last_error(), "cannot bind a socket")
    end
    let remote = make_addr(ip, port)
    let op = task.op_new()
    var ok: long = 0
    var err: long = 0
    unsafe
        ok = connect_ex(s, remote.ptr, 16, 0, 0, 0, &op)
        err = task.last_error()
    end
    try await_op(op, ok != 0, err, "connect to {host}:{port}")
    unsafe
        ws.setsockopt(s, SOL_SOCKET, SO_UPDATE_CONNECT_CONTEXT, 0, 0)
    end
    return conn
end

// Starts listening on a port on every network interface (0 picks a free one; see `.port`).
pub async func listen(port: long) -> Listener or error
    return await listen_on("", port)
end

// Starts listening on one local address and a port: `"127.0.0.1"` or `"localhost"` for this machine
// only, `"0.0.0.0"` or `""` for every network interface, or the numeric IPv4 address of one
// interface. 0 picks a free port (see `.port`).
pub async func listen_on(host: text, port: long) -> Listener or error
    var ip: long = 0
    if host == "localhost"
        ip = 2130706433
    else if host != "" and host != "0.0.0.0"
        ip = parse_ip(host)
        if ip < 0
            return error(errors.InvalidInput, "'{host}' is not an IPv4 address, \"localhost\" or \"\"")
        end
    end
    try net_init()
    let s = new_socket()
    if s == INVALID_SOCKET
        return sys.error_for(task.last_error(), "cannot create a socket")
    end
    let l = Listener{ sock: s, port: port, open: true }
    let addr = make_addr(ip, port)
    var rc: long = 0
    unsafe
        rc = ws.bind(s, addr.ptr, 16)
    end
    if rc != 0
        return sys.error_for(task.last_error(), "cannot listen on port {port}")
    end
    unsafe
        rc = ws.listen(s, 128)
    end
    if rc != 0
        return sys.error_for(task.last_error(), "cannot listen on port {port}")
    end
    let bound = sys.buffer(16)
    let size = sys.Scratch{ a: 16 }
    unsafe
        ws.getsockname(s, bound.ptr, &size.a)
        l.port = (long(bound.ptr[2]) << 8) bitor long(bound.ptr[3])
    end
    return l
end

// Waits for the next client.
pub async func (l: Listener) accept() -> Conn or error
    let s = new_socket()
    if s == INVALID_SOCKET
        return sys.error_for(task.last_error(), "cannot create a socket")
    end
    let conn = Conn{ sock: s, open: true }
    let scratch = sys.buffer(64)
    let op = task.op_new()
    var ok: long = 0
    var err: long = 0
    unsafe
        ok = accept_ex(l.sock, s, scratch.ptr, 0, 32, 32, 0, &op)
        err = task.last_error()
    end
    try await_op(op, ok != 0, err, "accept")
    unsafe
        ws.setsockopt(s, SOL_SOCKET, SO_UPDATE_ACCEPT_CONTEXT, &l.sock, 8)
    end
    return conn
end

// Receives up to `max` bytes; empty text means the peer closed the connection.
pub async func (conn: Conn) read(max: long) -> text or error
    let b = sys.buffer(max)
    let wb = ws.Wsabuf{ len: u32(max), ptr: b.ptr }
    let flags = sys.Scratch{}
    let op = task.op_new()
    var rc: long = 0
    var err: long = 0
    unsafe
        rc = ws.WSARecv(conn.sock, &wb, 1, 0, &flags.a, &op, 0)
        err = task.last_error()
    end
    let n = try await_op(op, rc == 0, err, "read")
    return c.from_bytes(b.ptr, n)
end

// Sends all of `data`.
pub async func (conn: Conn) write(data: text) -> error
    var done: long = 0
    while done < data.len
        let wb = ws.Wsabuf{ len: u32(data.len - done), ptr: c.cstr(data) + done }
        let op = task.op_new()
        var rc: long = 0
        var err: long = 0
        unsafe
            rc = ws.WSASend(conn.sock, &wb, 1, 0, 0, &op, 0)
            err = task.last_error()
        end
        let sent = try await_op(op, rc == 0, err, "write")
        if sent == 0
            return error(errors.Closed, "write: the connection is closed")
        end
        done += sent
    end
    return
end

// Closes the connection now.
pub async func (conn: Conn) close()
    if conn.open
        unsafe
            ws.closesocket(conn.sock)
        end
        conn.open = false
    end
end

// Ends the reads and writes that are waiting on this connection (they fail) without closing it,
// so a task can answer after a timeout. Meant for timers: it is a plain function.
pub func (conn: Conn) cancel(writes: bool)
    if conn.open
        unsafe
            ws.CancelIoEx(conn.sock, 0)
        end
    end
end

// Ends the accept that is waiting on this listener (it fails) without closing it.
pub func (l: Listener) cancel()
    if l.open
        unsafe
            ws.CancelIoEx(l.sock, 0)
        end
    end
end

// Stops listening now.
pub async func (l: Listener) close()
    if l.open
        unsafe
            ws.closesocket(l.sock)
        end
        l.open = false
    end
end

// ---- buffered reading and writing ----

// Reads a connection in pieces and hands it out by lines or bytes.
#[shared]
pub type Reader = record
    pub conn: Conn
    pub buf: bufio.InBuf
    pub reads: long
end

// Collects writes and sends them in large pieces.
#[shared]
pub type Writer = record
    pub conn: Conn
    pub buf: bufio.OutBuf
    pub writes: long
end

// A reader over this connection (the end of the data is the peer closing it).
pub func (conn: Conn) reader() -> Reader
    return Reader{ conn: conn, buf: bufio.input(), reads: 0 }
end

// A writer over this connection: `flush()` sends what has been collected.
pub func (conn: Conn) writer() -> Writer
    return Writer{ conn: conn, buf: bufio.output(), writes: 0 }
end

// Waits for more data; the peer closing the connection finishes the buffer.
pub async func (r: Reader) fill() -> error
    if r.buf.finished()
        return
    end
    let s = try await r.conn.read(65536)
    r.reads += 1
    if s.len == 0
        r.buf.finish()
        return
    end
    r.buf.feed(s)
    return
end

// The next line without its `\n` or `\r\n`, or the error `end of file`.
pub async func (r: Reader) read_line() -> text or error
    while not r.buf.has_line()
        if r.buf.finished()
            break
        end
        try await r.fill()
    end
    if not r.buf.has_line()
        return error(errors.UnexpectedEof, "end of file")
    end
    return r.buf.take_line()
end

// Up to `max` bytes; empty text once the peer has closed the connection.
pub async func (r: Reader) read(max: int) -> text or error
    if r.buf.unread() == 0
        try await r.fill()
    end
    return r.buf.take(max)
end

// Everything until the peer closes the connection.
pub async func (r: Reader) read_all() -> text or error
    while not r.buf.finished()
        try await r.fill()
    end
    return r.buf.take_all()
end

// True when nothing is left to read (waits for data).
pub async func (r: Reader) at_end() -> bool or error
    if r.buf.unread() == 0 and not r.buf.finished()
        try await r.fill()
    end
    return r.buf.unread() == 0
end

// Sends everything that is buffered.
pub async func (w: Writer) drain() -> error
    if w.buf.len() == 0
        return
    end
    let data = w.buf.take()
    try await w.conn.write(data)
    w.writes += 1
    return
end

// Adds `data` (sent once 64 KiB have gathered, or on `flush`).
pub async func (w: Writer) write(data: text) -> error
    w.buf.add(data)
    if w.buf.len() >= 65536
        try await w.drain()
    end
    return
end

// Adds `data` and a newline.
pub async func (w: Writer) write_line(data: text) -> error
    w.buf.add(data)
    w.buf.add("\n")
    if w.buf.len() >= 65536
        try await w.drain()
    end
    return
end

// Sends whatever is buffered.
pub async func (w: Writer) flush() -> error
    try await w.drain()
    return
end

// Sends whatever is buffered. The connection stays open: close it with `conn.close()`.
pub async func (w: Writer) close() -> error
    try await w.drain()
    return
end

// ---- UDP ----

// A bound UDP socket. Closes when the last reference goes away.
#[shared]
pub type UdpSocket = record
    pub sock: usize
    pub open: bool
    pub port: long
end

pub func (ref s: UdpSocket) drop()
    if s.open
        unsafe
            ws.closesocket(s.sock)
        end
        s.open = false
    end
end

// One received datagram and where it came from.
pub type Packet = record
    pub data: text
    pub host: text
    pub port: long
end

// Like `await_op`, for receiving a datagram: a datagram larger than the buffer is its own error.
func await_dgram(op: task.Op, accepted: bool, err: long, what: text, max: long) -> long or error
    if not accepted and err != ERROR_IO_PENDING
        task.op_release(op)
        if err == WSAEMSGSIZE or err == ERROR_MORE_DATA
            return error(errors.InvalidInput, "datagram larger than {max} bytes")
        end
        return sys.error_for(err, what)
    end
    task.op_submit(op)
    task.op_wait(op)
    let status = op.status
    let moved = op.bytes
    task.op_release(op)
    if status == WSAEMSGSIZE or status == ERROR_MORE_DATA
        return error(errors.InvalidInput, "datagram larger than {max} bytes")
    end
    if status != 0
        return sys.error_for(status, what)
    end
    return moved
end

// Binds a UDP socket to a port (0 picks a free one; see `.port`).
pub async func udp(port: long) -> UdpSocket or error
    try net_init()
    let s = new_socket_of(SOCK_DGRAM, IPPROTO_UDP)
    if s == INVALID_SOCKET
        return sys.error_for(task.last_error(), "cannot create a socket")
    end
    let sock = UdpSocket{ sock: s, open: true, port: port }
    // an ICMP "port unreachable" must not make a later receive fail
    let off = sys.Scratch{}
    let got = sys.Scratch{}
    unsafe
        ws.WSAIoctl(s, SIO_UDP_CONNRESET, &off.a, 4, 0, 0, &got.a, 0, 0)
    end
    let addr = make_addr(0, port)
    var rc: long = 0
    unsafe
        rc = ws.bind(s, addr.ptr, 16)
    end
    if rc != 0
        return sys.error_for(task.last_error(), "cannot bind UDP port {port}")
    end
    let bound = sys.buffer(16)
    let size = sys.Scratch{ a: 16 }
    unsafe
        ws.getsockname(s, bound.ptr, &size.a)
        sock.port = (long(bound.ptr[2]) << 8) bitor long(bound.ptr[3])
    end
    return sock
end

// Sends `data` as one datagram to `host` (an address or a name) and `port`.
pub async func (sock: UdpSocket) send_to(host: text, port: long, data: text) -> error
    if not sock.open
        return error(errors.Closed, "the socket is closed")
    end
    let ip = try await resolve(host)
    let addr = make_addr(ip, port)
    let wb = ws.Wsabuf{ len: u32(data.len), ptr: c.cstr(data) }
    let op = task.op_new()
    var rc: long = 0
    var err: long = 0
    unsafe
        rc = ws.WSASendTo(sock.sock, &wb, 1, 0, 0, addr.ptr, 16, &op, 0)
        err = task.last_error()
    end
    try await_op(op, rc == 0, err, "send to {host}:{port}")
    return
end

// Waits for the next datagram (up to `max` bytes) and says who sent it.
pub async func (sock: UdpSocket) recv(max: long = 65535) -> Packet or error
    if not sock.open
        return error(errors.Closed, "the socket is closed")
    end
    let b = sys.buffer(max + 1)
    let wb = ws.Wsabuf{ len: u32(max), ptr: b.ptr }
    let from = sys.buffer(16)
    let size = sys.Scratch{ a: 16 }
    let flags = sys.Scratch{}
    let op = task.op_new()
    var rc: long = 0
    var err: long = 0
    unsafe
        rc = ws.WSARecvFrom(sock.sock, &wb, 1, 0, &flags.a, from.ptr, &size.a, &op, 0)
        err = task.last_error()
    end
    let n = try await_dgram(op, rc == 0, err, "receive", max)
    var host = ""
    var port: long = 0
    unsafe
        host = "{long(from.ptr[4])}.{long(from.ptr[5])}.{long(from.ptr[6])}.{long(from.ptr[7])}"
        port = (long(from.ptr[2]) << 8) bitor long(from.ptr[3])
    end
    return Packet{ data: c.from_bytes(b.ptr, n), host: host, port: port }
end

// Closes the socket now.
pub async func (sock: UdpSocket) close()
    if sock.open
        unsafe
            ws.closesocket(sock.sock)
        end
        sock.open = false
    end
end
