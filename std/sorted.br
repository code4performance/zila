// =====================================================================
// Brasa standard library: sorted maps and sets
//
//     use sorted
//     let scores: sorted.SortedMap<text, int> = sorted.text_map()
//     scores.put("carla", 70)
//     scores.put("ana", 90)
//     print(scores.keys())            // [ana, carla]
//     print(scores.min() ?? "none")   // ana
//
// Balanced (AVL) binary search trees: putting, finding and removing take time proportional
// to the logarithm of the number of entries. The order is decided by a function
// `less(a, b)` (true when `a` comes before `b`; it must be a strict order, so `a < b` and
// not `a <= b`). Two keys are the same key when neither is less than the other.
// =====================================================================

package sorted

use text

#[shared]
type Node<K, V> = record
    key: K
    value: V
    left: Node<K, V>?
    right: Node<K, V>?
    height: int
end

// One entry of a sorted map, as listed by `entries()`.
type Entry<K, V> = record
    key: K
    value: V
end

#[shared]
type SortedMap<K, V> = record
    root: Node<K, V>?
    less: func(K, K) -> bool
    size: int
end

#[shared]
type SortedSet<T> = record
    inner: SortedMap<T, bool>
end

// ---- making them ----

// An empty map ordered by `less`.
func map_by<K, V>(less: func(K, K) -> bool) -> SortedMap<K, V>
    return SortedMap { root: nil, less: less, size: 0 }
end

// An empty map with integer keys, smallest first.
func int_map<V>() -> SortedMap<int, V>
    return SortedMap { root: nil, less: func(a, b) a < b end, size: 0 }
end

// An empty map with text keys ordered by bytes.
func text_map<V>() -> SortedMap<text, V>
    return SortedMap { root: nil, less: func(a, b) text.compare(a, b) < 0 end, size: 0 }
end

// An empty set ordered by `less`.
func set_by<T>(less: func(T, T) -> bool) -> SortedSet<T>
    let m: SortedMap<T, bool> = SortedMap { root: nil, less: less, size: 0 }
    return SortedSet { inner: m }
end

// An empty set of integers, smallest first.
func int_set() -> SortedSet<int>
    let m: SortedMap<int, bool> = SortedMap { root: nil, less: func(a, b) a < b end, size: 0 }
    return SortedSet { inner: m }
end

// An empty set of text ordered by bytes.
func text_set() -> SortedSet<text>
    let m: SortedMap<text, bool> = SortedMap { root: nil, less: func(a, b) text.compare(a, b) < 0 end, size: 0 }
    return SortedSet { inner: m }
end

// ---- the tree ----

func h<K, V>(n: Node<K, V>?) -> int
    if n == nil
        return 0
    end
    return n.height
end

func fix<K, V>(n: Node<K, V>?)
    let a = h(n.left)
    let b = h(n.right)
    if a > b
        n.height = a + 1
    else
        n.height = b + 1
    end
end

func rotate_right<K, V>(n: Node<K, V>?) -> Node<K, V>?
    let l = n.left
    n.left = l.right
    l.right = n
    fix(n)
    fix(l)
    return l
end

func rotate_left<K, V>(n: Node<K, V>?) -> Node<K, V>?
    let r = n.right
    n.right = r.left
    r.left = n
    fix(n)
    fix(r)
    return r
end

// Restores the balance of the subtree rooted at `n`, whose children are balanced.
func balance<K, V>(n: Node<K, V>?) -> Node<K, V>?
    fix(n)
    let bf = h(n.left) - h(n.right)
    if bf > 1
        if h(n.left.left) < h(n.left.right)
            n.left = rotate_left(n.left)
        end
        return rotate_right(n)
    end
    if bf < 0 - 1
        if h(n.right.right) < h(n.right.left)
            n.right = rotate_right(n.right)
        end
        return rotate_left(n)
    end
    return n
end

func put_node<K, V>(m: SortedMap<K, V>, n: Node<K, V>?, k: K, v: V) -> Node<K, V>?
    if n == nil
        m.size += 1
        return Node { key: k, value: v, left: nil, right: nil, height: 1 }
    end
    if m.less(k, n.key)
        n.left = put_node(m, n.left, k, v)
    else if m.less(n.key, k)
        n.right = put_node(m, n.right, k, v)
    else
        n.value = v
        return n
    end
    return balance(n)
end

func find<K, V>(m: SortedMap<K, V>, k: K) -> Node<K, V>?
    var n = m.root
    while n != nil
        if m.less(k, n.key)
            n = n.left
        else if m.less(n.key, k)
            n = n.right
        else
            return n
        end
    end
    return nil
end

func min_node<K, V>(n: Node<K, V>?) -> Node<K, V>?
    var c = n
    while c.left != nil
        c = c.left
    end
    return c
end

// The subtree without its smallest node.
func remove_min<K, V>(n: Node<K, V>?) -> Node<K, V>?
    if n.left == nil
        return n.right
    end
    n.left = remove_min(n.left)
    return balance(n)
end

func remove_node<K, V>(m: SortedMap<K, V>, n: Node<K, V>?, k: K) -> Node<K, V>?
    if n == nil
        return nil
    end
    if m.less(k, n.key)
        n.left = remove_node(m, n.left, k)
    else if m.less(n.key, k)
        n.right = remove_node(m, n.right, k)
    else
        m.size -= 1
        if n.left == nil
            return n.right
        end
        if n.right == nil
            return n.left
        end
        let s = min_node(n.right)
        s.right = remove_min(n.right)
        s.left = n.left
        return balance(s)
    end
    return balance(n)
end

func walk_keys<K, V>(n: Node<K, V>?, out: []K)
    if n == nil
        return
    end
    walk_keys(n.left, out)
    out.add(n.key)
    walk_keys(n.right, out)
end

func walk_values<K, V>(n: Node<K, V>?, out: []V)
    if n == nil
        return
    end
    walk_values(n.left, out)
    out.add(n.value)
    walk_values(n.right, out)
end

func walk_entries<K, V>(n: Node<K, V>?, out: []Entry<K, V>)
    if n == nil
        return
    end
    walk_entries(n.left, out)
    out.add(Entry { key: n.key, value: n.value })
    walk_entries(n.right, out)
end

func walk_range<K, V>(m: SortedMap<K, V>, n: Node<K, V>?, lo: K, hi: K, out: []K)
    if n == nil
        return
    end
    if m.less(lo, n.key)
        walk_range(m, n.left, lo, hi, out)
    end
    if not m.less(n.key, lo) and m.less(n.key, hi)
        out.add(n.key)
    end
    if m.less(n.key, hi)
        walk_range(m, n.right, lo, hi, out)
    end
end

// ---- sorted map ----

// Adds the entry or replaces the value of the same key; true when the key was new.
func (m: SortedMap<K, V>) put(k: K, v: V) -> bool
    let before = m.size
    m.root = put_node(m, m.root, k, v)
    return m.size > before
end

// The value stored for `k`, or `default`.
func (m: SortedMap<K, V>) get(k: K, default: V) -> V
    let n = find(m, k)
    if n == nil
        return default
    end
    return n.value
end

// True when `k` is in the map.
func (m: SortedMap<K, V>) has(k: K) -> bool
    return find(m, k) != nil
end

// Removes `k`; true when it was in the map.
func (m: SortedMap<K, V>) remove(k: K) -> bool
    let before = m.size
    m.root = remove_node(m, m.root, k)
    return m.size < before
end

// Removes every entry.
func (m: SortedMap<K, V>) clear()
    m.root = nil
    m.size = 0
end

// The number of entries.
func (m: SortedMap<K, V>) len() -> int
    return m.size
end

// The keys, smallest first.
func (m: SortedMap<K, V>) keys() -> []K
    let out: []K = []
    walk_keys(m.root, out)
    return out
end

// The values, in key order.
func (m: SortedMap<K, V>) values() -> []V
    let out: []V = []
    walk_values(m.root, out)
    return out
end

// The entries, in key order.
func (m: SortedMap<K, V>) entries() -> []Entry<K, V>
    let out: []Entry<K, V> = []
    walk_entries(m.root, out)
    return out
end

// The smallest key.
func (m: SortedMap<K, V>) min() -> K or error
    if m.root == nil
        return error("the collection is empty")
    end
    return min_node(m.root).key
end

// The largest key.
func (m: SortedMap<K, V>) max() -> K or error
    if m.root == nil
        return error("the collection is empty")
    end
    var n = m.root
    while n.right != nil
        n = n.right
    end
    return n.key
end

// The largest key that is not after `k`.
func (m: SortedMap<K, V>) floor(k: K) -> K or error
    var best: Node<K, V>? = nil
    var n = m.root
    while n != nil
        if m.less(k, n.key)
            n = n.left
        else
            best = n
            n = n.right
        end
    end
    if best == nil
        return error("no key at or below the given key")
    end
    return best.key
end

// The smallest key that is not before `k`.
func (m: SortedMap<K, V>) ceil(k: K) -> K or error
    var best: Node<K, V>? = nil
    var n = m.root
    while n != nil
        if m.less(n.key, k)
            n = n.right
        else
            best = n
            n = n.left
        end
    end
    if best == nil
        return error("no key at or above the given key")
    end
    return best.key
end

// The keys from `lo` up to, but not including, `hi`, smallest first.
func (m: SortedMap<K, V>) range(lo: K, hi: K) -> []K
    let out: []K = []
    walk_range(m, m.root, lo, hi, out)
    return out
end

// ---- sorted set ----

// Adds `x`; true when it was not in the set yet.
func (s: SortedSet<T>) add(x: T) -> bool
    return s.inner.put(x, true)
end

// True when `x` is in the set.
func (s: SortedSet<T>) has(x: T) -> bool
    return s.inner.has(x)
end

// Removes `x`; true when it was in the set.
func (s: SortedSet<T>) remove(x: T) -> bool
    return s.inner.remove(x)
end

// Removes every element.
func (s: SortedSet<T>) clear()
    s.inner.clear()
end

// The number of elements.
func (s: SortedSet<T>) len() -> int
    return s.inner.size
end

// The elements, smallest first.
func (s: SortedSet<T>) to_list() -> []T
    return s.inner.keys()
end

// The smallest element.
func (s: SortedSet<T>) min() -> T or error
    return s.inner.min()
end

// The largest element.
func (s: SortedSet<T>) max() -> T or error
    return s.inner.max()
end

// The largest element that is not after `x`.
func (s: SortedSet<T>) floor(x: T) -> T or error
    return s.inner.floor(x)
end

// The smallest element that is not before `x`.
func (s: SortedSet<T>) ceil(x: T) -> T or error
    return s.inner.ceil(x)
end

// The elements from `lo` up to, but not including, `hi`.
func (s: SortedSet<T>) range(lo: T, hi: T) -> []T
    return s.inner.range(lo, hi)
end

// The elements of `a` and of `b`, ordered like `a`.
func union<T>(a: SortedSet<T>, b: SortedSet<T>) -> SortedSet<T>
    let out = set_by(a.inner.less)
    for x in a.to_list()
        out.add(x)
    end
    for x in b.to_list()
        out.add(x)
    end
    return out
end

// The elements that are in both `a` and `b`.
func intersect<T>(a: SortedSet<T>, b: SortedSet<T>) -> SortedSet<T>
    let out = set_by(a.inner.less)
    for x in a.to_list()
        if b.has(x)
            out.add(x)
        end
    end
    return out
end

// The elements of `a` that are not in `b`.
func difference<T>(a: SortedSet<T>, b: SortedSet<T>) -> SortedSet<T>
    let out = set_by(a.inner.less)
    for x in a.to_list()
        if not b.has(x)
            out.add(x)
        end
    end
    return out
end

// True when every element of `a` is in `b`.
func is_subset<T>(a: SortedSet<T>, b: SortedSet<T>) -> bool
    for x in a.to_list()
        if not b.has(x)
            return false
        end
    end
    return true
end
