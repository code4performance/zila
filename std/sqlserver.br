// =====================================================================
// Brasa standard library: SQL Server driver (`use sqlserver`)
//
//     use db
//     use sqlserver
//
//     let conn = try sqlserver.open("sqlserver://app:secret@localhost:1433/shop?encrypt=strict")
//     let rows = try db.query(Customer, conn, "select id, name from customers where id > @p1", db.int(10))
//
// The TDS protocol written in Brasa over `net` and `tls`; there is no C library.
// `sqlserver.open(url)` returns a `db.Conn`, so the code of `use db` (typed rows, parameters,
// transactions, errors) works unchanged.
//
//   * URL: `sqlserver://user:password@host:port/database?encrypt=...&cafile=...` (port 1433 by
//     default; SQL login only; named instances and Windows authentication are not supported).
//   * `encrypt=strict` (the default) is TDS 8.0: TLS first, with the ALPN protocol `tds/8.0`, the
//     certificate chain and host name validated (SQL Server 2022 or later, Azure SQL).
//     `cafile=<file>` adds the CA certificates of a PEM file for this connection only.
//   * `encrypt=off` sends no encryption at all (the password is only obfuscated, as TDS defines):
//     for local development. `encrypt=on` (TLS inside the TDS pre-login) is not supported and is
//     refused before any connection is made.
//   * With arguments a statement runs as `sp_executesql` with typed parameters `@p1`, `@p2`, ...;
//     without, as a batch. Results are read completely, up to `max_rows` (1,000,000, or
//     `?max_rows=N` in the URL), then an error; the connection stays usable. `?timeout=ms` cancels
//     a statement that runs longer (an ATTENTION packet) with an error of kind Timeout.
//   * Types: integers, bit, float and real, decimal, numeric and money (as text), char, varchar,
//     nchar and nvarchar (UTF-16 converted; single-byte data in code page 1252 or a UTF-8
//     collation), date and time types (ISO 8601 text), uniqueidentifier (text), binary and
//     varbinary. A column of another type (sql_variant, text, ntext, image, ...) is an error
//     that names the column and the type. `db.vector(xs)` is sent as the text `[1.0,2.5]`.
//
// Error numbers become kinds: 2627 and 2601 AlreadyExists, 18456 and 4060 Unauthenticated, 229,
// 230, 262 and 297 PermissionDenied, 1205 Unavailable, other syntax, object, conversion and
// constraint errors InvalidInput. The message carries the server's text, the number, severity
// and state.
// =====================================================================

package sqlserver

use net
use fs
use tls
use crypto
use db
use errors
use task
use text

// How many rows one statement may return.
pub let MAX_ROWS = 1000000

#[shared]
type Session = record
    shut: func()
    write: func(text) -> error
    read: func() -> text or error
    buf: text
    pos: int
    open: bool
    packet: int
    tran: text
    max_rows: int
    server_error: bool
    timeout: long
    gen: long
    waiting: bool
    attn_sent: bool
end

// A column of a result: the name and what its TYPE_INFO said.
type Col = record
    name: text
    ty: int
    size: int
    prec: int
    scale: int
    cp: int
    tag: text
    bad: bool
end

// A read position in a message.
type Cur = record
    s: text
    p: int
    bad: bool
end

// ---------------------------------------------------------------------------
// Bytes
// ---------------------------------------------------------------------------

func le16(n: long) -> text
    return crypto.from_bytes([n bitand 255, (n >> 8) bitand 255])
end

func le32(n: long) -> text
    return crypto.from_bytes([n bitand 255, (n >> 8) bitand 255, (n >> 16) bitand 255, (n >> 24) bitand 255])
end

func le64(n: long) -> text
    return le32(n bitand 4294967295) + le32((n >> 32) bitand 4294967295)
end

func be16(n: long) -> text
    return crypto.from_bytes([(n >> 8) bitand 255, n bitand 255])
end

func byte1(n: long) -> text
    return crypto.from_bytes([n bitand 255])
end

// UTF-16LE bytes of `s`.
func utf16(s: text) -> text
    var out: []long = []
    for c in s
        let cp = c.code
        if cp < 65536
            out.add(long(cp bitand 255))
            out.add(long((cp >> 8) bitand 255))
        else
            let v = cp - 65536
            let hi = 55296 + (v >> 10)
            let lo = 56320 + (v bitand 1023)
            out.add(long(hi bitand 255))
            out.add(long((hi >> 8) bitand 255))
            out.add(long(lo bitand 255))
            out.add(long((lo >> 8) bitand 255))
        end
    end
    return crypto.from_bytes(out)
end

// The text of UTF-16LE bytes (a lone surrogate becomes U+FFFD).
func from_utf16(b: text) -> text
    var cs: []char = []
    var i = 0
    while i + 1 < b.len
        let u = int(b.byte(i)) + int(b.byte(i + 1)) * 256
        i += 2
        if u >= 55296 and u < 56320 and i + 1 < b.len
            let u2 = int(b.byte(i)) + int(b.byte(i + 1)) * 256
            if u2 >= 56320 and u2 < 57344
                i += 2
                cs.add(char(65536 + ((u - 55296) << 10) + (u2 - 56320)))
                continue
            end
        end
        if u >= 55296 and u < 57344
            cs.add(char(65533))
        else
            cs.add(char(u))
        end
    end
    return text.from_chars(cs)
end

func rd8(ref c: Cur) -> int
    if c.p >= c.s.len
        c.bad = true
        return 0
    end
    let v = int(c.s.byte(c.p))
    c.p += 1
    return v
end

func rd16(ref c: Cur) -> int
    if c.p + 2 > c.s.len
        c.bad = true
        c.p = c.s.len
        return 0
    end
    let v = int(c.s.byte(c.p)) + int(c.s.byte(c.p + 1)) * 256
    c.p += 2
    return v
end

func rd32(ref c: Cur) -> long
    if c.p + 4 > c.s.len
        c.bad = true
        c.p = c.s.len
        return 0
    end
    let v = long(c.s.byte(c.p)) + (long(c.s.byte(c.p + 1)) << 8) + (long(c.s.byte(c.p + 2)) << 16) + (long(c.s.byte(c.p + 3)) << 24)
    c.p += 4
    return v
end

func rds32(ref c: Cur) -> long
    var v = rd32(ref c)
    if v >= 2147483648
        v = v - 4294967296
    end
    return v
end

func rds64(ref c: Cur) -> long
    let lo = rd32(ref c)
    let hi = rd32(ref c)
    return lo + (hi << 32)
end

func take(ref c: Cur, n: int) -> text
    if n < 0 or c.p + n > c.s.len
        c.bad = true
        c.p = c.s.len
        return ""
    end
    let out = c.s.__raw_slice(c.p, c.p + n)
    c.p += n
    return out
end

// A signed little-endian integer of `n` bytes (1 to 8) as the server wrote it.
func int_of(ref c: Cur, n: int, signed: bool) -> long
    if c.p + n > c.s.len
        c.bad = true
        c.p = c.s.len
        return 0
    end
    var v: long = 0
    for k in 0..n
        v = v + (long(c.s.byte(c.p + k)) << (8 * k))
    end
    c.p += n
    if signed and n < 8
        let one: long = 1
        let top = one << (8 * n - 1)
        if v >= top
            v = v - (one << (8 * n))
        end
    end
    return v
end

// B_VARCHAR: a length in characters (1 byte) then UTF-16.
func b_varchar(ref c: Cur) -> text
    let n = rd8(ref c)
    return from_utf16(take(ref c, n * 2))
end

// US_VARCHAR: a length in characters (2 bytes) then UTF-16.
func us_varchar(ref c: Cur) -> text
    let n = rd16(ref c)
    return from_utf16(take(ref c, n * 2))
end

// ---------------------------------------------------------------------------
// Packets
// ---------------------------------------------------------------------------

func send(s: Session, data: text) -> error
    if not s.open
        return error(errors.Unavailable, "the database connection is closed")
    end
    match s.write(data)
        ok -> return
        err(e) ->
            s.open = false
            return error(errors.Unavailable, "the database connection was lost: {e.message}")
    end
    return
end

func fill(s: Session, need: int) -> error
    while s.buf.len - s.pos < need
        var more = ""
        match s.read()
            ok(chunk) -> more = chunk
            err(e) ->
                s.open = false
                return error(errors.Unavailable, "the database connection was lost: {e.message}")
        end
        if more.len == 0
            s.open = false
            return error(errors.Unavailable, "the database server closed the connection")
        end
        if s.pos > 0
            s.buf = s.buf.__raw_slice(s.pos, s.buf.len) + more
            s.pos = 0
        else
            s.buf = s.buf + more
        end
    end
    return
end

// Sends a message of packet type `kind`, split into packets of the negotiated size.
func send_message(s: Session, kind: int, payload: text) -> error
    var at = 0
    var id = 1
    let room = s.packet - 8
    var all = ""
    while true
        var n = payload.len - at
        var last = true
        if n > room
            n = room
            last = false
        end
        var status = 0
        if last
            status = 1
        end
        let head = crypto.from_bytes([long(kind), long(status)]) + be16(long(n + 8)) + be16(0) + crypto.from_bytes([long(id bitand 255), 0])
        all = all + head + payload.__raw_slice(at, at + n)
        at += n
        id += 1
        if last
            break
        end
    end
    return send(s, all)
end

// Reads one whole message (all its packets): the payload.
func read_message(s: Session) -> text or error
    var parts: []text = []
    while true
        try fill(s, 8)
        let status = int(s.buf.byte(s.pos + 1))
        let len = int(s.buf.byte(s.pos + 2)) * 256 + int(s.buf.byte(s.pos + 3))
        if len < 8
            s.open = false
            return error(errors.Io, "the database server sent a malformed packet")
        end
        try fill(s, len)
        parts.add(s.buf.__raw_slice(s.pos + 8, s.pos + len))
        s.pos += len
        if status bitand 1 != 0
            break
        end
    end
    return text.join(parts, "")
end

// ---------------------------------------------------------------------------
// Values
// ---------------------------------------------------------------------------

// Days since 0001-01-01 as an ISO date.
func iso_date(days: long) -> text
    // civil from days (Howard Hinnant), with 0001-01-01 as day 0: shift to 0000-03-01 based days
    let z = days + 306
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    var y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    var m = mp + 3
    if m > 12
        m -= 12
    end
    if m <= 2
        y += 1
    end
    return "{pad(y, 4)}-{pad(m, 2)}-{pad(d, 2)}"
end

func pad(n: long, width: int) -> text
    var s = "{n}"
    while s.len < width
        s = "0" + s
    end
    return s
end

// The time of day for `units` of 10^-scale seconds.
func iso_time(units: long, scale: int) -> text
    var per: long = 1
    for k in 0..scale
        per = per * 10
    end
    let secs = units / per
    let frac = units - secs * per
    var out = "{pad(secs / 3600, 2)}:{pad((secs / 60) % 60, 2)}:{pad(secs % 60, 2)}"
    if scale > 0
        out = out + "." + pad(frac, scale)
    end
    return out
end

func time_bytes(scale: int) -> int
    if scale <= 2
        return 3
    end
    if scale <= 4
        return 4
    end
    return 5
end

// A little-endian magnitude of `n` bytes as decimal digits.
func magnitude_digits(b: text) -> text
    var bytes: []long = []
    for k in 0..b.len
        bytes.add(long(b.byte(b.len - 1 - k)))
    end
    var digits = ""
    var nonzero = true
    while nonzero
        var rem: long = 0
        nonzero = false
        for k in 0..bytes.len
            let cur = rem * 256 + bytes[k]
            bytes[k] = cur / 10
            rem = cur % 10
            if bytes[k] != 0
                nonzero = true
            end
        end
        digits = "{rem}" + digits
    end
    return digits
end

func with_scale(sign: text, digits: text, scale: int) -> text
    var d = digits
    while d.len <= scale
        d = "0" + d
    end
    if scale == 0
        return sign + d
    end
    return sign + d.slice(0, d.len - scale) + "." + d.slice(d.len - scale, d.len)
end

func pow2(n: int) -> float
    var r = 1.0
    if n >= 0
        for k in 0..n
            r = r * 2.0
        end
    else
        for k in 0..(0 - n)
            r = r / 2.0
        end
    end
    return r
end

// An IEEE 754 float of 4 or 8 bytes.
func ieee(b: text) -> float
    var bits: long = 0
    for k in 0..b.len
        bits = bits + (long(b.byte(k)) << (8 * k))
    end
    var ebits = 11
    var mbits = 52
    var bias = 1023
    if b.len == 4
        ebits = 8
        mbits = 23
        bias = 127
    end
    let one: long = 1
    let sign = (bits >> (ebits + mbits)) bitand 1
    let e = int((bits >> mbits) bitand ((one << ebits) - 1))
    let m = bits bitand ((one << mbits) - 1)
    var v = 0.0
    if e == 0
        v = float(m) * pow2(1 - bias - mbits)
    else
        v = (1.0 + float(m) / pow2(mbits)) * pow2(e - bias)
    end
    if sign == 1
        return 0.0 - v
    end
    return v
end

func guid_text(b: text) -> text
    let h = crypto.hex(b)
    // the first three groups are little-endian
    var g1 = ""
    for k in 0..4
        g1 = g1 + h.slice((3 - k) * 2, (3 - k) * 2 + 2)
    end
    let g2 = h.slice(10, 12) + h.slice(8, 10)
    let g3 = h.slice(14, 16) + h.slice(12, 14)
    return g1 + "-" + g2 + "-" + g3 + "-" + h.slice(16, 20) + "-" + h.slice(20, 32)
end

// The characters of the bytes 128 to 255 in code pages 1250 (Central European) and 1251
// (Cyrillic); U+FFFD for a byte the code page leaves undefined.
let CP1250: []int = [
    8364, 65533, 8218, 65533, 8222, 8230, 8224, 8225, 65533, 8240, 352, 8249, 346, 356, 381, 377,
    65533, 8216, 8217, 8220, 8221, 8226, 8211, 8212, 65533, 8482, 353, 8250, 347, 357, 382, 378,
    160, 711, 728, 321, 164, 260, 166, 167, 168, 169, 350, 171, 172, 173, 174, 379,
    176, 177, 731, 322, 180, 181, 182, 183, 184, 261, 351, 187, 317, 733, 318, 380,
    340, 193, 194, 258, 196, 313, 262, 199, 268, 201, 280, 203, 282, 205, 206, 270,
    272, 323, 327, 211, 212, 336, 214, 215, 344, 366, 218, 368, 220, 221, 354, 223,
    341, 225, 226, 259, 228, 314, 263, 231, 269, 233, 281, 235, 283, 237, 238, 271,
    273, 324, 328, 243, 244, 337, 246, 247, 345, 367, 250, 369, 252, 253, 355, 729
]

let CP1251: []int = [
    1026, 1027, 8218, 1107, 8222, 8230, 8224, 8225, 8364, 8240, 1033, 8249, 1034, 1036, 1035, 1039,
    1106, 8216, 8217, 8220, 8221, 8226, 8211, 8212, 65533, 8482, 1113, 8250, 1114, 1116, 1115, 1119,
    160, 1038, 1118, 1032, 164, 1168, 166, 167, 1025, 169, 1028, 171, 172, 173, 174, 1031,
    176, 177, 1030, 1110, 1169, 181, 182, 183, 1105, 8470, 1108, 187, 1112, 1029, 1109, 1111,
    1040, 1041, 1042, 1043, 1044, 1045, 1046, 1047, 1048, 1049, 1050, 1051, 1052, 1053, 1054, 1055,
    1056, 1057, 1058, 1059, 1060, 1061, 1062, 1063, 1064, 1065, 1066, 1067, 1068, 1069, 1070, 1071,
    1072, 1073, 1074, 1075, 1076, 1077, 1078, 1079, 1080, 1081, 1082, 1083, 1084, 1085, 1086, 1087,
    1088, 1089, 1090, 1091, 1092, 1093, 1094, 1095, 1096, 1097, 1098, 1099, 1100, 1101, 1102, 1103
]

// Single-byte text in code page 1252, 1250 or 1251 (or UTF-8 for a UTF-8 collation) as text.
func single_byte(b: text, cp: int) -> text
    var plain = true
    for k in 0..b.len
        if b.byte(k) >= 128
            plain = false
            break
        end
    end
    if plain
        return b
    end
    if cp == 65001
        return b
    end
    var cs: []char = []
    for k in 0..b.len
        let v = int(b.byte(k))
        if v >= 128 and cp == 1250
            cs.add(char(CP1250[v - 128]))
        else if v >= 128 and cp == 1251
            cs.add(char(CP1251[v - 128]))
        else if v >= 128 and v < 160
            cs.add(char(cp1252(v)))
        else
            cs.add(char(v))
        end
    end
    return text.from_chars(cs)
end

func cp1252(v: int) -> int
    let t: []int = [8364, 129, 8218, 402, 8222, 8230, 8224, 8225, 710, 8240, 352, 8249, 338, 141, 381, 143, 144, 8216, 8217, 8220, 8221, 8226, 8211, 8212, 732, 8482, 353, 8250, 339, 157, 382, 376]
    return t[v - 128]
end

// The code page of a collation (4 bytes of flags plus the sort id): 65001 for a UTF-8 collation,
// 1251 for the Cyrillic languages, 1250 for the Central European ones, 1252 for the Western
// European ones and 0 for any other code page this driver cannot convert.
func code_page(col: text) -> int
    let info = int(col.byte(0)) + int(col.byte(1)) * 256 + int(col.byte(2)) * 65536 + int(col.byte(3)) * 16777216
    if (info >> 26) bitand 1 == 1
        return 65001
    end
    let lcid = info bitand 65535
    // Russian, Ukrainian, Belarusian, Bulgarian, Kazakh, Tatar, Kyrgyz, Mongolian, Macedonian,
    // Turkmen, Uzbek, Azeri (Cyrillic), Tajik
    for l in [1049, 1058, 1059, 1026, 1087, 1092, 1088, 1104, 1071, 1090, 2115, 2092, 1064]
        if lcid == l
            return 1251
        end
    end
    // Polish, Hungarian, Czech, Slovak, Romanian, Croatian, Slovenian, Albanian, Bosnian, Serbian (Latin)
    for l in [1045, 1038, 1029, 1051, 1048, 1050, 1060, 1052, 5146, 2074]
        if lcid == l
            return 1250
        end
    end
    // Greek, Turkish, Hebrew, Arabic, Baltic, Vietnamese, Thai and the East Asian languages
    for l in [1032, 1055, 1037, 1025, 1065, 1061, 1062, 1063, 1066, 1041, 1042, 2052, 1028, 1054, 1033, 1031]
        if l != 1033 and l != 1031 and lcid == l
            return 0
        end
    end
    return 1252
end

// Reads a PLP value (partially length-prefixed): the bytes, or "" with `null` true.
func read_plp(ref c: Cur) -> text?
    let total = rds64(ref c)
    if total == -1
        return nil
    end
    var parts: []text = []
    while true
        let n = int(rd32(ref c))
        if n == 0 or c.bad
            break
        end
        parts.add(take(ref c, n))
    end
    return text.join(parts, "")
end

func type_name(ty: int) -> text
    if ty == 241
        return "xml"
    end
    if ty == 98
        return "sql_variant"
    end
    if ty == 35
        return "text"
    end
    if ty == 99
        return "ntext"
    end
    if ty == 34
        return "image"
    end
    if ty == 240
        return "udt"
    end
    return "type 0x" + crypto.hex(byte1(long(ty)))
end

// Reads TYPE_INFO for a column.
func type_info(ref c: Cur, name: text) -> Col or error
    let ty = rd8(ref c)
    var col = Col { name: name, ty: ty, size: 0, prec: 0, scale: 0, cp: 0, tag: "text", bad: false }
    if ty == 48 or ty == 50 or ty == 52 or ty == 56 or ty == 127
        col.tag = "int"
        if ty == 50
            col.tag = "bool"
        end
        return col
    end
    if ty == 59 or ty == 62
        col.tag = "float"
        return col
    end
    if ty == 58 or ty == 61 or ty == 60 or ty == 122
        col.tag = "time"
        if ty == 60 or ty == 122
            col.tag = "numeric"
        end
        return col
    end
    if ty == 38 or ty == 104 or ty == 109 or ty == 110 or ty == 111
        col.size = rd8(ref c)
        col.tag = "int"
        if ty == 104
            col.tag = "bool"
        else if ty == 109
            col.tag = "float"
        else if ty == 110
            col.tag = "numeric"
        else if ty == 111
            col.tag = "time"
        end
        return col
    end
    if ty == 106 or ty == 108
        col.size = rd8(ref c)
        col.prec = rd8(ref c)
        col.scale = rd8(ref c)
        col.tag = "numeric"
        return col
    end
    if ty == 36
        col.size = rd8(ref c)
        col.tag = "uuid"
        return col
    end
    if ty == 40
        col.tag = "time"
        return col
    end
    if ty == 41 or ty == 42 or ty == 43
        col.scale = rd8(ref c)
        col.tag = "time"
        return col
    end
    if ty == 175 or ty == 167 or ty == 239 or ty == 231
        col.size = rd16(ref c)
        col.cp = code_page(take(ref c, 4))
        let sort = rd8(ref c)
        col.tag = "text"
        return col
    end
    if ty == 173 or ty == 165
        col.size = rd16(ref c)
        col.tag = "bytes"
        return col
    end
    // types this driver does not read: skip what the TYPE_INFO still holds so the column name can
    // be reported
    if ty == 241
        // xml: an optional schema collection, then the value is a PLP of UTF-16
        let schema = rd8(ref c)
        if schema == 1
            let a = b_varchar(ref c)
            let b = b_varchar(ref c)
            let d = us_varchar(ref c)
        end
        col.size = 65535
        col.tag = "text"
        return col
    end
    col.bad = true
    if ty == 98
        let n = rd32(ref c)
        return col
    end
    if ty == 35 or ty == 99
        let n = rd32(ref c)
        let coll = take(ref c, 5)
        return col
    end
    if ty == 34
        let n = rd32(ref c)
        return col
    end
    return error(errors.Unsupported, "a column has a type this driver does not support: {type_name(ty)}")
end

// Reads one value of `col` as text; nil for NULL.
func read_value(ref c: Cur, col: Col) -> text? or error
    let ty = col.ty
    if ty == 48
        return "{int_of(ref c, 1, false)}"
    end
    if ty == 50
        return "{int_of(ref c, 1, false)}"
    end
    if ty == 52
        return "{int_of(ref c, 2, true)}"
    end
    if ty == 56
        return "{int_of(ref c, 4, true)}"
    end
    if ty == 127
        return "{int_of(ref c, 8, true)}"
    end
    if ty == 59
        return "{ieee(take(ref c, 4))}"
    end
    if ty == 62
        return "{ieee(take(ref c, 8))}"
    end
    if ty == 122
        return money_text(int_of(ref c, 4, true))
    end
    if ty == 60
        let hi = int_of(ref c, 4, true)
        let lo = int_of(ref c, 4, false)
        return money_text(hi * 4294967296 + lo)
    end
    if ty == 61
        let days = int_of(ref c, 4, true)
        let ticks = int_of(ref c, 4, false)
        return datetime_text(days, ticks)
    end
    if ty == 58
        let days = int_of(ref c, 2, false)
        let minutes = int_of(ref c, 2, false)
        return iso_date(days + 693595) + " " + iso_time(minutes * 60, 0)
    end
    // nullable fixed types: a length byte first
    if ty == 38 or ty == 104 or ty == 109 or ty == 110 or ty == 111
        let n = rd8(ref c)
        if n == 0
            return nil
        end
        if ty == 38
            return "{int_of(ref c, n, true)}"
        end
        if ty == 104
            return "{int_of(ref c, 1, false)}"
        end
        if ty == 109
            return "{ieee(take(ref c, n))}"
        end
        if ty == 110
            if n == 4
                return money_text(int_of(ref c, 4, true))
            end
            let hi = int_of(ref c, 4, true)
            let lo = int_of(ref c, 4, false)
            return money_text(hi * 4294967296 + lo)
        end
        if n == 4
            let days = int_of(ref c, 2, false)
            let minutes = int_of(ref c, 2, false)
            return iso_date(days + 693595) + " " + iso_time(minutes * 60, 0)
        end
        let days = int_of(ref c, 4, true)
        let ticks = int_of(ref c, 4, false)
        return datetime_text(days, ticks)
    end
    if ty == 106 or ty == 108
        let n = rd8(ref c)
        if n == 0
            return nil
        end
        let sign = rd8(ref c)
        var s = ""
        if sign == 0
            s = "-"
        end
        return with_scale(s, magnitude_digits(take(ref c, n - 1)), col.scale)
    end
    if ty == 36
        let n = rd8(ref c)
        if n == 0
            return nil
        end
        return guid_text(take(ref c, n))
    end
    if ty == 40
        let n = rd8(ref c)
        if n == 0
            return nil
        end
        return iso_date(int_of(ref c, 3, false))
    end
    if ty == 41
        let n = rd8(ref c)
        if n == 0
            return nil
        end
        return iso_time(int_of(ref c, n, false), col.scale)
    end
    if ty == 42 or ty == 43
        let n = rd8(ref c)
        if n == 0
            return nil
        end
        let tb = time_bytes(col.scale)
        let units = int_of(ref c, tb, false)
        let days = int_of(ref c, 3, false)
        var out = iso_date(days) + " " + iso_time(units, col.scale)
        if ty == 43
            let off = int_of(ref c, 2, true)
            var sign = "+"
            var a = off
            if off < 0
                sign = "-"
                a = 0 - off
            end
            out = out + " " + sign + pad(a / 60, 2) + ":" + pad(a % 60, 2)
        end
        return out
    end
    // character and binary types
    var raw: text? = nil
    if col.size == 65535
        raw = read_plp(ref c)
    else
        let n = rd16(ref c)
        if n != 65535
            raw = take(ref c, n)
        end
    end
    if raw == nil
        return nil
    end
    let b = raw ?? ""
    if col.ty == 231 or col.ty == 239 or col.ty == 241
        return from_utf16(b)
    end
    if col.ty == 167 or col.ty == 175
        if col.cp == 0
            for k in 0..b.len
                if b.byte(k) >= 128
                    return error(errors.Unsupported, "a {col.name} value is single-byte text in a code page this driver does not convert (only Western European 1252 and UTF-8 collations): use nvarchar for this column")
                end
            end
        end
        return single_byte(b, col.cp)
    end
    return b
end

func money_text(v: long) -> text
    var sign = ""
    var a = v
    if v < 0
        sign = "-"
        a = 0 - v
    end
    var frac = pad(a % 10000, 4)
    if frac.slice(2, 4) == "00"
        frac = frac.slice(0, 2)
    end
    return "{sign}{a / 10000}.{frac}"
end

func datetime_text(days: long, ticks: long) -> text
    // days since 1900-01-01, ticks of 1/300 second
    let ms = (ticks * 10 + 1) / 3
    let secs = ms / 1000
    return iso_date(days + 693595) + " " + iso_time(secs, 0) + "." + pad(ms % 1000, 3)
end

// ---------------------------------------------------------------------------
// Errors
// ---------------------------------------------------------------------------

func kind_of(number: long) -> ErrorKind
    if number == 2627 or number == 2601
        return errors.AlreadyExists
    end
    if number == 18456 or number == 4060 or number == 18452
        return errors.Unauthenticated
    end
    if number == 229 or number == 230 or number == 262 or number == 297 or number == 300
        return errors.PermissionDenied
    end
    if number == 1205
        return errors.Unavailable
    end
    if number == -2
        return errors.Timeout
    end
    if number == 102 or number == 105 or number == 156 or number == 170 or number == 207 or number == 208 or number == 245 or number == 515 or number == 547 or number == 8114 or number == 8152 or number == 2714 or number == 201 or number == 137 or number == 1087 or number == 241 or number == 242 or number == 8115 or number == 8134
        return errors.InvalidInput
    end
    return errors.Other
end

// ---------------------------------------------------------------------------
// Results
// ---------------------------------------------------------------------------

// What reading a response produced.
type Outcome = record
    rows: db.Rows
    failure: error?
    login: bool
    count_seen: bool
    attn: bool
end

// Reads the token stream of a response.
func read_tokens(s: Session, payload: text) -> Outcome or error
    var c = Cur { s: payload, p: 0, bad: false }
    var rs = db.rows([], [])
    var cols: []Col = []
    var out = Outcome { rows: rs, failure: nil, login: false, count_seen: false, attn: false }
    var have_set = false
    var count = 0
    var too_many = false
    while c.p < payload.len
        if c.bad
            break
        end
        let token = rd8(ref c)
        if token == 129
            // COLMETADATA
            let n = rd16(ref c)
            if n == 65535
                continue
            end
            var names: []text = []
            var tags: []text = []
            var next: []Col = []
            var bad: error? = nil
            for k in 0..n
                let _ut = rd32(ref c)
                let _fl = rd16(ref c)
                // TYPE_INFO comes before the name, so read it into a placeholder first
                let start = c.p
                match type_info(ref c, "")
                    ok(col) ->
                        // legacy LOB types carry a table name before the column name
                        if col.bad and (col.ty == 35 or col.ty == 99 or col.ty == 34)
                            let parts = rd8(ref c)
                            for q in 0..parts
                                let t = us_varchar(ref c)
                            end
                        end
                        let name = b_varchar(ref c)
                        var named = col
                        named.name = name
                        if col.bad
                            if bad == nil
                                bad = error(errors.Unsupported, "column {name}: the type {type_name(col.ty)} is not supported by this driver")
                            end
                        end
                        next.add(named)
                        names.add(name)
                        tags.add(named.tag)
                    err(e) ->
                        // find the name to put in the message: skip the rest is impossible, so
                        // report the type byte only
                        let ty = int(payload.byte(start))
                        if bad == nil
                            bad = error(errors.Unsupported, "a column has a type that this driver does not support: {type_name(ty)}")
                        end
                end
                if bad != nil
                    return bad
                end
            end
            if not have_set
                rs = db.rows(names, tags)
                cols = next
                have_set = true
            else
                cols = next
            end
            continue
        end
        if token == 209 or token == 210
            // ROW and NBCROW
            var nulls: []bool = []
            if token == 210
                let nb = (cols.len + 7) / 8
                let bits = take(ref c, nb)
                for k in 0..cols.len
                    nulls.add((int(bits.byte(k / 8)) >> (k % 8)) bitand 1 == 1)
                end
            end
            var cells: []text = []
            var isnull: []bool = []
            for k in 0..cols.len
                if token == 210 and nulls[k]
                    cells.add("")
                    isnull.add(true)
                    continue
                end
                let v = try read_value(ref c, cols[k])
                if v == nil
                    cells.add("")
                    isnull.add(true)
                else
                    cells.add(v ?? "")
                    isnull.add(false)
                end
            end
            if c.bad
                break
            end
            if count >= s.max_rows
                too_many = true
            else
                count += 1
                for k in 0..cells.len
                    rs.add(cells[k], isnull[k])
                end
            end
            continue
        end
        if token == 253 or token == 254 or token == 255
            // DONE, DONEPROC, DONEINPROC
            let status = rd16(ref c)
            let _cmd = rd16(ref c)
            let n = rds64(ref c)
            if status bitand 32 != 0
                out.attn = true
            end
            if status bitand 16 != 0 and token != 255
                rs.affected = n
                out.count_seen = true
            else if status bitand 16 != 0 and rs.affected == 0 and not have_set
                rs.affected = n
            end
            continue
        end
        if token == 170 or token == 171
            // ERROR and INFO
            let len = rd16(ref c)
            let end_at = c.p + len
            let number = rds32(ref c)
            let state = rd8(ref c)
            let class = rd8(ref c)
            let msg = us_varchar(ref c)
            c.p = end_at
            if token == 170 and out.failure == nil
                out.failure = error(kind_of(number), db.with_code(msg, "{number}, severity {class}, state {state}"))
            end
            continue
        end
        if token == 173
            // LOGINACK
            let len = rd16(ref c)
            c.p += len
            out.login = true
            continue
        end
        if token == 227
            // ENVCHANGE
            let len = rd16(ref c)
            let end_at = c.p + len
            let kind = rd8(ref c)
            if kind == 4
                let new_size = b_varchar(ref c)
                match text.parse_int(new_size)
                    ok(n) -> s.packet = n
                    err(e) -> s.packet = s.packet
                end
            else if kind == 8
                let n = rd8(ref c)
                s.tran = take(ref c, n)
            else if kind == 9 or kind == 10
                s.tran = crypto.from_bytes([0, 0, 0, 0, 0, 0, 0, 0])
            end
            c.p = end_at
            continue
        end
        if token == 121
            c.p += 4
            continue
        end
        if token == 169 or token == 174
            // ORDER and FEATUREEXTACK
            if token == 169
                let len = rd16(ref c)
                c.p += len
            else
                while c.p < payload.len and payload.byte(c.p) != 255
                    c.p += 1
                    let l = int(rd32(ref c))
                    c.p += l
                end
                c.p += 1
            end
            continue
        end
        if token == 228
            let len = int(rd32(ref c))
            c.p += len
            continue
        end
        s.open = false
        return error(errors.Io, "the database server sent a token this driver does not know (0x{crypto.hex(byte1(long(token)))})")
    end
    if c.bad
        s.open = false
        return error(errors.Io, "the database server's answer is cut off or malformed")
    end
    if too_many and out.failure == nil
        out.failure = error(errors.Overflow, "the statement returned more than {s.max_rows} rows (the limit of this connection)")
    end
    out.rows = rs
    return out
end

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

func all_headers(s: Session) -> text
    // total length 22, header length 18, type 2 (transaction descriptor), descriptor, 1 request
    return le32(22) + le32(18) + le16(2) + s.tran + le32(1)
end

// An nvarchar(max) value: PLP.
func plp(data: text) -> text
    if data.len == 0
        return le64(0) + le32(0)
    end
    return le64(long(data.len)) + le32(long(data.len)) + data + le32(0)
end

// TYPE_INFO and data for one parameter value, and the SQL declaration of its type.
func param_wire(a: db.Arg) -> []text
    match a
        Int(n) -> return [byte1(38) + byte1(8), byte1(8) + le64(n), "bigint"]
        Float(x) -> return [byte1(109) + byte1(8), byte1(8) + float_bytes(x), "float"]
        Bool(b) ->
            var v = 0
            if b
                v = 1
            end
            return [byte1(104) + byte1(1), byte1(1) + byte1(long(v)), "bit"]
        Text(t) -> return [nvarchar_max(), plp(utf16(t)), "nvarchar(max)"]
        Bytes(d) -> return [byte1(165) + le16(65535), plp(d), "varbinary(max)"]
        Vector(v) -> return [nvarchar_max(), plp(utf16(vector_text(v))), "nvarchar(max)"]
        Null -> return [byte1(231) + le16(8000) + collation(), le16(65535), "nvarchar(4000)"]
    end
    return ["", "", ""]
end

func collation() -> text
    return crypto.from_bytes([9, 4, 208, 0, 52])
end

func nvarchar_max() -> text
    return byte1(231) + le16(65535) + collation()
end

func vector_text(v: []float) -> text
    var parts: []text = []
    for x in v
        parts.add("{x}")
    end
    return "[" + text.join(parts, ",") + "]"
end

// The 8 bytes of an IEEE 754 double.
func float_bytes(x: float) -> text
    if x == 0.0
        return crypto.from_bytes([0, 0, 0, 0, 0, 0, 0, 0])
    end
    var v = x
    var sign: long = 0
    if v < 0.0
        sign = 1
        v = 0.0 - v
    end
    var e = 0
    while v >= 2.0
        v = v / 2.0
        e += 1
    end
    while v < 1.0
        v = v * 2.0
        e -= 1
    end
    let m = long((v - 1.0) * 4503599627370496.0)
    let bits = (sign << 63) bitor (long(e + 1023) << 52) bitor m
    return le64(bits)
end

func rpc(s: Session, sql: text, args: []db.Arg) -> text
    var decl: []text = []
    var params = ""
    var k = 1
    for a in args
        let w = param_wire(a)
        decl.add("@p{k} " + w[2])
        params = params + byte1(long(("@p{k}").len)) + utf16("@p{k}") + byte1(0) + w[0] + w[1]
        k += 1
    end
    let head = all_headers(s) + le16(65535) + le16(10) + le16(0)
    let stmt = byte1(0) + byte1(0) + nvarchar_max() + plp(utf16(sql))
    let declared = byte1(0) + byte1(0) + nvarchar_max() + plp(utf16(text.join(decl, ", ")))
    return head + stmt + declared + params
end

// Sends the ATTENTION packet that asks the server to stop the statement it is running.
func send_attention(s: Session)
    let r = s.write(crypto.from_bytes([6, 1, 0, 8, 0, 0, 1, 0]))
end

// Runs one statement and reads its result. With a `timeout`, a statement still running when it
// expires is cancelled with an ATTENTION packet, its acknowledgement is read, and the call
// returns an error of kind Timeout; the connection stays usable.
func run(s: Session, sql: text, args: []db.Arg) -> db.Rows or error
    if args.len == 0
        try send_message(s, 1, all_headers(s) + utf16(sql))
    else
        try send_message(s, 3, rpc(s, sql, args))
    end
    var token: long = 0
    if s.timeout > 0
        s.gen += 1
        token = s.gen
        s.waiting = true
        s.attn_sent = false
        task.add_timer(task.now() + s.timeout, func()
            if s.waiting and s.gen == token
                s.attn_sent = true
                spawn send_attention(s)
            end
        end)
    end
    var payload = ""
    match read_message(s)
        ok(p) -> payload = p
        err(e) ->
            s.waiting = false
            return e
    end
    s.waiting = false
    let out = try read_tokens(s, payload)
    if s.attn_sent
        s.attn_sent = false
        if not out.attn
            // the statement finished before the server saw the ATTENTION: its acknowledgement is next
            let ack = try read_message(s)
        end
        return error(errors.Timeout, "the statement timed out after {s.timeout} ms and was cancelled")
    end
    if out.failure != nil
        return out.failure
    end
    return out.rows
end

// ---------------------------------------------------------------------------
// Opening
// ---------------------------------------------------------------------------

func plain_read(raw: net.Conn) -> func() -> text or error
    return func() return await raw.read(16384) end
end

func plain_write(raw: net.Conn) -> func(text) -> error
    return func(data) return await raw.write(data) end
end

func secure_read(conn: tls.Conn) -> func() -> text or error
    return func() return await conn.read(16384) end
end

func secure_write(conn: tls.Conn) -> func(text) -> error
    return func(data) return await conn.write(data) end
end

func pipe_read(p: fs.Pipe) -> func() -> text or error
    return func() return await p.read(16384) end
end

func pipe_write(p: fs.Pipe) -> func(text) -> error
    return func(data) return await p.write(data) end
end

// The host names that mean "this machine".
func is_local(host: text) -> bool
    let h = text.lower(host)
    return h == "." or h == "localhost" or h == "(local)" or h == "127.0.0.1" or h == "::1"
end

// The named pipe of an instance: `\\.\pipe\MSSQL$NAME\sql\query` (`\\.\pipe\sql\query` for the
// default instance) on `host` (`.` for this machine).
func pipe_path(host: text, instance: text) -> text
    var machine = host
    if is_local(host)
        machine = "."
    end
    if instance == "" or text.lower(instance) == "mssqlserver"
        return "\\\\" + machine + "\\pipe\\sql\\query"
    end
    return "\\\\" + machine + "\\pipe\\MSSQL$" + instance + "\\sql\\query"
end

// The PRELOGIN message: version, encryption (2 is "not supported": no TLS in the TDS exchange,
// 3 is "required"), instance, thread, MARS off. Each option is a token, an offset and a length.
func prelogin(encryption: int) -> text
    let version = crypto.from_bytes([16, 0, 0, 0, 0, 0])
    let thread = le32(1)
    var at = 5 * 5 + 1
    var head = crypto.from_bytes([0]) + be16(long(at)) + be16(6)
    at += 6
    head = head + crypto.from_bytes([1]) + be16(long(at)) + be16(1)
    at += 1
    head = head + crypto.from_bytes([2]) + be16(long(at)) + be16(1)
    at += 1
    head = head + crypto.from_bytes([3]) + be16(long(at)) + be16(4)
    at += 4
    head = head + crypto.from_bytes([4]) + be16(long(at)) + be16(1)
    return head + crypto.from_bytes([255]) + version + byte1(long(encryption)) + byte1(0) + thread + byte1(0)
end

// The LOGIN7 message for an SQL login (the password is obfuscated, not encrypted).
func login7(host: text, user: text, password: text, database: text, packet: int) -> text
    // host, user, password, application, server, extension, library, language, database
    let fields: []text = [utf16(host), utf16(user), obfuscate(utf16(password)), utf16("brasa"), utf16(host), "", utf16("brasa"), "", utf16(database)]
    var table = ""
    var data = ""
    var at = 94
    for f in fields
        table = table + le16(long(at)) + le16(long(f.len / 2))
        data = data + f
        at += f.len
    end
    var head = le32(long(at)) + le32(1946157060) + le32(long(packet)) + le32(7) + le32(1234) + le32(0)
    head = head + crypto.from_bytes([224, 3, 0, 0]) + le32(0) + le32(1033)
    // client id (6 bytes), then SSPI, attached file and new password: empty, then SSPI long
    let tail = crypto.from_bytes([0, 0, 0, 0, 0, 0]) + le16(long(at)) + le16(0) + le16(long(at)) + le16(0) + le16(long(at)) + le16(0) + le32(0)
    return head + table + tail + data
end

// Each byte of the UTF-16 password: swap the nibbles, then xor with 0xA5.
func obfuscate(b: text) -> text
    var out: []long = []
    for k in 0..b.len
        let v = int(b.byte(k))
        let swapped = ((v bitand 15) << 4) bitor (v >> 4)
        out.add(long(swapped bitxor 165))
    end
    return crypto.from_bytes(out)
end

func close_udp(u: net.UdpSocket)
    await u.close()
end

// The TCP port of a named instance, asked of the SQL Server Browser (UDP 1434) of `host`.
func browser_port(host: text, instance: text) -> long or error
    let u = try await net.udp(0)
    task.add_timer(task.now() + 2000, func() spawn close_udp(u) end)
    try await u.send_to(host, 1434, crypto.from_bytes([4]) + instance)
    var data = ""
    match await u.recv()
        ok(p) -> data = p.data
        err(e) -> return error(errors.Timeout, "the SQL Server Browser on {host} did not answer for the instance {instance}")
    end
    await u.close()
    // the reply is 0x05, a length, then `ServerName;X;InstanceName;Y;...;tcp;1433;;`
    var info = ""
    if data.len > 3
        info = data.__raw_slice(3, data.len)
    end
    let parts = text.split(info, ";")
    for k in 0..parts.len
        if parts[k] == "tcp" and k + 1 < parts.len
            match text.parse_long(parts[k + 1])
                ok(n) -> return n
                err(e) -> return error(errors.Io, "the SQL Server Browser sent a bad port for the instance {instance}")
            end
        end
    end
    return error(errors.Unavailable, "the instance {instance} on {host} does not listen on TCP (use transport=pipe on that machine, or enable TCP/IP)")
end

// Opens a connection. The URL's password never appears in an error message.
//
//   sqlserver://user:password@host:1433/database
//   sqlserver://user:password@host\INSTANCE/database    (the port comes from the SQL Server Browser;
//                                                        on this machine the instance's named pipe)
//   ?transport=pipe[&pipe=\\.\pipe\...]  ?transport=tcp  ?encrypt=strict|off  ?cafile=...
pub func open(url: text) -> db.Conn or error
    let u = try db.parse_url(url)
    if u.scheme != "sqlserver"
        return error(errors.InvalidInput, "not a SQL Server URL: {db.redact(url)}")
    end
    if u.user == ""
        return error(errors.InvalidInput, "the SQL Server URL has no user: {db.redact(url)}")
    end
    // `host\INSTANCE`
    var host = u.host
    var instance = ""
    let bs = text.index_of(u.host, "\\")
    if bs >= 0
        host = u.host.slice(0, bs)
        instance = u.host.slice(bs + 1, u.host.len)
        if host == "" or instance == ""
            return error(errors.InvalidInput, "bad host or instance in the SQL Server URL: {db.redact(url)}")
        end
    end
    var transport = "tcp"
    if u.params.has("transport")
        transport = u.params["transport"]
    else if u.params.has("pipe") or (instance != "" and u.port == 0 and is_local(host))
        transport = "pipe"
    end
    if transport != "tcp" and transport != "pipe"
        return error(errors.InvalidInput, "unsupported transport \"{transport}\" (use tcp or pipe)")
    end
    var mode = "strict"
    if transport == "pipe"
        mode = "off"
    end
    if u.params.has("encrypt")
        mode = u.params["encrypt"]
    end
    if mode == "on" or mode == "true" or mode == "mandatory"
        return error(errors.Unsupported, "encrypt={mode} (TLS inside the TDS pre-login) is not supported: use encrypt=strict (SQL Server 2022 or later) or encrypt=off")
    end
    if mode != "strict" and mode != "off"
        return error(errors.InvalidInput, "unsupported encrypt \"{mode}\" (use strict or off)")
    end
    if transport == "pipe" and mode == "strict"
        return error(errors.InvalidInput, "a named pipe cannot carry TLS: use encrypt=off (a pipe is local to the machine) or transport=tcp")
    end
    var max_rows = MAX_ROWS
    if u.params.has("max_rows")
        match text.parse_int(u.params["max_rows"])
            ok(n) -> max_rows = n
            err(e) -> return error(errors.InvalidInput, "bad max_rows in the SQL Server URL")
        end
    end
    var timeout: long = 0
    if u.params.has("timeout")
        match text.parse_long(u.params["timeout"])
            ok(n) -> timeout = n
            err(e) -> return error(errors.InvalidInput, "bad timeout in the SQL Server URL")
        end
    end
    var root = ""
    if u.params.has("cafile")
        root = u.params["cafile"]
    end
    let zero = crypto.from_bytes([0, 0, 0, 0, 0, 0, 0, 0])
    var s: Session? = nil
    if transport == "pipe"
        var path = pipe_path(host, instance)
        if u.params.has("pipe")
            path = u.params["pipe"]
        end
        let p = match await fs.pipe(path)
            ok(x) -> x
            err(e) -> return error(errors.Unavailable, "cannot open the named pipe: {e.message}")
        end
        s = Session { shut: func() spawn close_pipe(p) end, write: pipe_write(p), read: pipe_read(p), buf: "", pos: 0, open: true, packet: 4096, tran: zero, max_rows: max_rows, server_error: false, timeout: timeout, gen: 0, waiting: false, attn_sent: false }
    else
        var port = u.port
        if port == 0 and instance != ""
            port = int(try browser_port(host, instance))
        end
        if port == 0
            port = 1433
        end
        if mode == "strict"
            let opts = tls.Options { alpn: ["tds/8.0"], require_alpn: true, ca_file: root }
            let sec = try await tls.connect_with(host, long(port), opts)
            s = Session { shut: func() spawn close_secure(sec) end, write: secure_write(sec), read: secure_read(sec), buf: "", pos: 0, open: true, packet: 4096, tran: zero, max_rows: max_rows, server_error: false, timeout: timeout, gen: 0, waiting: false, attn_sent: false }
        else
            let raw = match await net.connect(host, long(port))
                ok(c) -> c
                err(e) -> return error(errors.Unavailable, "cannot connect to {host}:{port}: {e.message}")
            end
            s = Session { shut: func() spawn close_plain(raw) end, write: plain_write(raw), read: plain_read(raw), buf: "", pos: 0, open: true, packet: 4096, tran: zero, max_rows: max_rows, server_error: false, timeout: timeout, gen: 0, waiting: false, attn_sent: false }
        end
    end
    let session = s ?? never_session()
    try start(session, host, u.user, u.password, u.database, mode)
    return connection(session)
end

func never_session() -> Session
    return Session { shut: func() end, write: func(d) return end, read: func() return "" end, buf: "", pos: 0, open: false, packet: 4096, tran: "", max_rows: 0, server_error: false, timeout: 0, gen: 0, waiting: false, attn_sent: false }
end

func close_plain(raw: net.Conn)
    await raw.close()
end

func close_secure(sec: tls.Conn)
    await sec.close()
end

func close_pipe(p: fs.Pipe)
    await p.close()
end

func start(s: Session, host: text, user: text, password: text, database: text, mode: text) -> error
    var enc = 2
    if mode == "strict"
        enc = 3
    end
    try send_message(s, 18, prelogin(enc))
    let reply = try read_message(s)
    // the server's encryption choice: with `off`, a server that requires encryption cannot be used
    if mode == "off" and reply.len > 5
        var at = 0
        while at < reply.len and reply.byte(at) != 255
            let token = int(reply.byte(at))
            let off = int(reply.byte(at + 1)) * 256 + int(reply.byte(at + 2))
            if token == 1 and off < reply.len
                let choice = int(reply.byte(off))
                if choice == 1 or choice == 3
                    s.open = false
                    s.shut()
                    return error(errors.Unsupported, "the server requires encryption: use encrypt=strict")
                end
            end
            at += 5
        end
    end
    try send_message(s, 16, login7(host, user, password, database, s.packet))
    let payload = try read_message(s)
    let out = try read_tokens(s, payload)
    if out.failure != nil
        s.open = false
        s.shut()
        return out.failure
    end
    if not out.login
        s.open = false
        s.shut()
        return error(errors.Unauthenticated, "the server did not accept the login")
    end
    return
end

func connection(s: Session) -> db.Conn
    return db.connection(
        func(sql, args) return run(s, sql, args) end,
        func() return simple(s, "BEGIN TRANSACTION") end,
        func() return simple(s, "COMMIT TRANSACTION") end,
        func() return simple(s, "IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION") end,
        func() terminate(s) end
    )
end

func simple(s: Session, sql: text) -> error
    let r = try run(s, sql, [])
    return
end

func terminate(s: Session)
    if s.open
        s.open = false
        s.shut()
    end
end
