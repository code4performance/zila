// =====================================================================
// Zila Lang standard library: helpers shared by `fs` and `net`
//
// Raw memory that frees itself, and Windows error messages.
// =====================================================================

package sys

use c
use errors

#[link("kernel32")]
extern "system" func FormatMessageA(flags: u32, source: usize, message: u32, language: u32, buffer: *u8, size: u32, args: usize) -> u32
#[link("kernel32")]
extern "system" func GetEnvironmentVariableA(name: *u8, buffer: *u8, size: u32) -> u32
#[link("kernel32")]
extern "system" func GetStdHandle(which: i32) -> usize
extern "system" func ReadFile(handle: usize, buffer: *u8, count: u32, done: *long, overlapped: usize) -> i32
#[link("bcrypt")]
extern "system" func BCryptGenRandom(algorithm: usize, buffer: *u8, count: u32, flags: u32) -> i32
#[link("kernel32")]
extern "system" func MultiByteToWideChar(codepage: u32, flags: u32, source: *u8, source_len: i32, dest: *u8, dest_len: i32) -> i32

// Owns a block of raw memory; frees it when the last reference goes away.
#[shared]
pub type Buf = record
    pub ptr: *u8
end

pub func (ref b: Buf) drop()
    c.free(b.ptr)
end

// Scratch integers whose addresses are handed to the operating system.
pub type Scratch = record
    pub a: long
    pub b: long
end

// A zeroed block of `bytes` bytes.
pub func buffer(bytes: long) -> Buf
    return Buf{ ptr: c.alloc(usize(bytes)) }
end

// `s` as a NUL-terminated UTF-16 string.
pub func wide(s: text) -> Buf
    var n: long = 0
    unsafe
        n = MultiByteToWideChar(65001, 0, c.cstr(s), -1, 0, 0)
    end
    let b = buffer(n * 2 + 2)
    unsafe
        MultiByteToWideChar(65001, 0, c.cstr(s), -1, b.ptr, int(n))
    end
    return b
end

func trim_end(s: text) -> text
    var n = s.len
    while n > 0 and s.byte(n - 1) <= 32
        n -= 1
    end
    return s.slice(0, n)
end

// "what: reason given by Windows" for an error code.
pub func describe(code: long, what: text) -> text
    let b = buffer(512)
    unsafe
        FormatMessageA(0x1200, 0, u32(code), 0, b.ptr, 512, 0)
    end
    return "{what}: {trim_end(c.from_cstr(b.ptr))}"
end

// The kind of an error code of Windows (`GetLastError`, a Winsock error or an operation status).
// Codes with no mapping are `Io`.
func kind_of(code: long) -> ErrorKind
    if code == 2 or code == 3 or code == 1168 or code == 11001 or code == 11004
        return errors.NotFound
    end
    if code == 5 or code == 1314
        return errors.PermissionDenied
    end
    if code == 80 or code == 183
        return errors.AlreadyExists
    end
    if code == 38
        return errors.UnexpectedEof
    end
    if code == 995 or code == 1223 or code == 125
        return errors.Cancelled
    end
    if code == 10060 or code == 258 or code == 1460 or code == 121
        return errors.Timeout
    end
    if code == 10061 or code == 1225
        return errors.ConnectionRefused
    end
    if code == 10051 or code == 10065 or code == 1231 or code == 1232
        return errors.Unavailable
    end
    if code == 10053 or code == 10054 or code == 64 or code == 1236
        return errors.ConnectionReset
    end
    if code == 10048 or code == 1227
        return errors.AddrInUse
    end
    if code == 87 or code == 10022 or code == 10049 or code == 10040 or code == 1784
        return errors.InvalidInput
    end
    return errors.Io
end

// The error for an operating-system code: its kind, and the message `describe` gives. (`error?`
// is the type of an error that is a value; a plain `-> error` would mean "fails or not".)
pub func error_for(code: long, what: text) -> error?
    return error(kind_of(code), describe(code, what))
end

// Fills `n` bytes at `p` with random bytes from the operating system (BCryptGenRandom with the
// system-preferred generator). False when the system could not.
pub func random_fill(p: *u8, n: long) -> bool
    var status: i32 = -1
    unsafe
        status = BCryptGenRandom(0, p, u32(n), 2)
    end
    return status == 0
end

// The value of the environment variable `name`, or `nil` when it is not set.
pub func env(name: text) -> text?
    var size: long = 0
    unsafe
        size = long(GetEnvironmentVariableA(c.cstr(name), 0, u32(0)))
    end
    if size == 0
        return nil
    end
    let b = buffer(size + 1)
    var got: long = 0
    unsafe
        got = long(GetEnvironmentVariableA(c.cstr(name), b.ptr, u32(size)))
    end
    var out = ""
    unsafe
        out = c.from_bytes(b.ptr, got)
    end
    return out
end

// Reads up to `max` bytes from standard input, waiting until some arrive; empty text at the end of
// the input. It blocks the whole program while it waits (the other tasks do not run), which suits a
// program that does nothing else until its next line of input.
pub func stdin_read(max: long) -> text
    let b = buffer(max + 1)
    let got = Scratch{}
    var ok: long = 0
    unsafe
        ok = long(ReadFile(GetStdHandle(-10), b.ptr, u32(max), &got.a, 0))
    end
    if ok == 0 or got.a <= 0
        return ""
    end
    var out = ""
    unsafe
        out = c.from_bytes(b.ptr, got.a)
    end
    return out
end
