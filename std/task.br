// =====================================================================
// Brasa standard library: tasks, channels and the scheduler
//
// Written in Brasa. A task is a Windows fiber (a user-mode stack that is
// switched without entering the kernel scheduler); the run queue, the
// timers, the blocking rules and the channels below are plain Brasa code.
//
//   let ch = channel(int)
//   spawn worker(ch)
//   print(ch.receive())
//
// Rules:
//   - Tasks are cooperative: a task runs until it waits (`receive`, `await`),
//     calls `task.yield()`, or finishes.
//   - `send` never blocks (channels are unbounded queues).
//   - `receive` waits for a value; on a closed, empty channel it returns 0.
//   - When nothing is ready the scheduler sleeps until the next timer. If
//     there is no timer either, the program stops with a deadlock error.
//   - When `main` returns the program ends, even if tasks are still queued.
//
// The compiler lowers `spawn f(x)` to `task.start(func() f(x) end)` and
// `ch.send(v)` / `ch.receive()` / `ch.close()` to the functions below.
// `std/future.br` builds `async`/`await` on `park`, `wake` and `add_timer`.
// =====================================================================

package task

#[link("kernel32")]
extern "system" func ConvertThreadToFiber(param: usize) -> usize
extern "system" func CreateFiber(stack: usize, start: extern "system" func(usize), param: usize) -> usize
extern "system" func SwitchToFiber(fiber: usize)
extern "system" func DeleteFiber(fiber: usize)
extern "system" func ExitProcess(code: u32)
extern "system" func GetTickCount64() -> u64
extern "system" func Sleep(ms: u32)
extern "system" func GetLastError() -> u32
extern "system" func CreateIoCompletionPort(file: usize, port: usize, key: usize, threads: u32) -> usize
extern "system" func PostQueuedCompletionStatus(port: usize, bytes: u32, key: usize, ov: usize) -> i32
extern "system" func GetQueuedCompletionStatusEx(port: usize, entries: *u8, count: u32, removed: *usize, ms: u32, alertable: i32) -> i32
#[link("ntdll")]
extern "system" func RtlNtStatusToDosError(status: u32) -> u32

type Task = record
    fiber: usize
    action: func()
    done: bool
    waiting: bool
end

// One asynchronous operating-system operation. The first fields are a Windows
// OVERLAPPED; `id` follows it, so a completion can be traced back to its Op.
// Ops are recycled, never freed, so the system can never write into freed memory.
#[c_layout]
#[shared]
type Op = record
    internal: usize
    internal_high: usize
    offset: u32
    offset_high: u32
    event: usize
    id: int
    task: int
    status: int
    bytes: int
    done: bool
end

// One OVERLAPPED_ENTRY, as GetQueuedCompletionStatusEx fills it in.
#[c_layout]
type IoEntry = record
    key: usize
    ov: usize
    internal: usize
    bytes: u32
    pad: u32
end

// Scratch memory for GetQueuedCompletionStatusEx.
type IoOut = record
    removed: usize
end

// Words in transit are plain integers: ownership of a value moves into the
// queue on `send` and out of it on `receive`.
type Chan = record
    items: []int
    head: int
    waiting: []int
    whead: int
    closed: bool
end

var tasks: []Task
var ready: []int
var ready_head = 0
// ids of tasks that finished (their fibers are deleted later) and ids free for reuse
var finished: []int
var free_ids: []int
var current = 0
var started = false
var switches = 0

// Timers, ascending by deadline (milliseconds of the system tick count).
var timer_at: []int
var timer_run: []func()

// Operations the operating system is still working on (see std/fs.br, std/net.br).
var pending_io = 0
var iocp: usize = 0
var ops: []Op
var op_free: []int

func init()
    if started
        return
    end
    started = true
    var main_fiber: usize = 0
    unsafe
        main_fiber = ConvertThreadToFiber(0)
    end
    // Task 0 is the main program.
    tasks.add(Task{ fiber: main_fiber })
end

func fatal(message: text)
    print("fatal: {message}")
    unsafe
        ExitProcess(2)
    end
end

func now() -> int
    var t: usize = 0
    unsafe
        t = GetTickCount64()
    end
    return int(t)
end

// Deletes the fibers of finished tasks and makes their ids reusable.
// A finished task is never the running one: it switched away for good.
func reap()
    for i in 0..finished.len
        let id = finished[i]
        unsafe
            DeleteFiber(tasks[id].fiber)
        end
        tasks[id].fiber = 0
        free_ids.add(id)
    end
    finished.clear()
end

// Runs `action` once the clock reaches `at`.
func add_timer(at: int, action: func())
    timer_at.add(at)
    timer_run.add(action)
    var j = timer_at.len - 1
    while j > 0 and timer_at[j - 1] > timer_at[j]
        let a = timer_at[j - 1]
        timer_at[j - 1] = timer_at[j]
        timer_at[j] = a
        let f = timer_run[j - 1]
        timer_run[j - 1] = timer_run[j]
        timer_run[j] = f
        j -= 1
    end
end

// Runs the actions of every timer whose time has come, earliest first.
func fire_timers()
    if timer_at.len == 0
        return
    end
    let t = now()
    var fired = 0
    while fired < timer_at.len and timer_at[fired] <= t
        fired += 1
    end
    if fired == 0
        return
    end
    var batch: []func() = []
    for i in 0..fired
        batch.add(timer_run[i])
    end
    var k = 0
    while k + fired < timer_at.len
        timer_at[k] = timer_at[k + fired]
        timer_run[k] = timer_run[k + fired]
        k += 1
    end
    for i in 0..fired
        timer_at.take()
        timer_run.take()
    end
    for i in 0..batch.len
        batch[i]()
    end
end

// Creates the I/O completion port the first time it is needed.
func io_init()
    if iocp != 0
        return
    end
    unsafe
        iocp = CreateIoCompletionPort(0xFFFFFFFFFFFFFFFF, 0, 0, 1)
    end
end

// Lets completions of operations on `handle` arrive at the port.
func io_attach(handle: usize)
    io_init()
    unsafe
        CreateIoCompletionPort(handle, iocp, 0, 0)
    end
end

func last_error() -> int
    var e = 0
    unsafe
        e = int(GetLastError())
    end
    return e
end

// A zeroed operation, ready to hand to the operating system.
func op_new() -> Op
    if op_free.len > 0
        let reused = ops[op_free.take()]
        reused.internal = 0
        reused.internal_high = 0
        reused.offset = 0
        reused.offset_high = 0
        reused.event = 0
        reused.task = 0
        reused.status = 0
        reused.bytes = 0
        reused.done = false
        return reused
    end
    let op = Op{}
    op.id = ops.len
    ops.add(op)
    return op
end

func op_release(op: Op)
    op_free.add(op.id)
end

// The system accepted the operation: its completion will arrive at the port.
func op_submit(op: Op)
    op.task = current
    pending_io += 1
end

func op_wait(op: Op)
    while not op.done
        park()
    end
end

// Completion routine of a name lookup (see `net.lookup`). The system calls it, on this thread,
// while `poll_io` waits (the wait is alertable): it finishes the operation like a completion
// from the port does. It allocates nothing and never switches tasks. The wait does not return
// by itself after a routine has run, so the routine also posts an empty packet to the port,
// which makes `poll_io` return and lets the scheduler see the task it woke.
func dns_done(error: u32, bytes: u32, overlapped: usize)
    let idp: *int = overlapped + 32
    var id = 0
    unsafe
        id = idp[0]
    end
    let op = ops[id]
    op.bytes = int(bytes)
    op.status = int(error)
    op.done = true
    pending_io -= 1
    wake(op.task)
    unsafe
        PostQueuedCompletionStatus(iocp, 0, 0, 0)
    end
end

// Collects completed operations, waiting up to `ms` milliseconds for the first. The wait is
// alertable, so completion routines queued by the system (name lookups) run inside it.
func poll_io(ms: int)
    if iocp == 0
        return
    end
    let entry = IoEntry{}
    let out = IoOut{}
    var wait = ms
    while pending_io > 0
        entry.ov = 0
        out.removed = 0
        var ok = 0
        unsafe
            ok = GetQueuedCompletionStatusEx(iocp, &entry, 1, &out.removed, u32(wait), 1)
        end
        if ok == 0
            // 192 (WAIT_IO_COMPLETION): a completion routine ran; anything else: nothing arrived
            if last_error() != 192
                return
            end
            wait = 0
            continue
        end
        if out.removed == 0 or entry.ov == 0
            return
        end
        let idp: *int = entry.ov + 32
        var id = 0
        unsafe
            id = idp[0]
        end
        let op = ops[id]
        // the operation's own status (an NTSTATUS in its OVERLAPPED) as a Windows error code
        var status = 0
        if op.internal != 0
            unsafe
                status = int(RtlNtStatusToDosError(u32(op.internal)))
            end
        end
        op.bytes = int(entry.bytes)
        op.status = status
        op.done = true
        pending_io -= 1
        wake(op.task)
        wait = 0
    end
end

// Nothing is ready: wait for the earliest timer or for an I/O completion.
func wait_events()
    var ms = 0xFFFFFFFF
    if timer_at.len > 0
        ms = timer_at[0] - now()
        if ms < 0
            ms = 0
        end
    end
    if pending_io > 0
        poll_io(ms)
    else if timer_at.len > 0 and ms > 0
        unsafe
            Sleep(u32(ms))
        end
    end
end

// Runs the next ready task. The caller has already queued itself (yield),
// parked itself (receive, await), or has finished.
func switch_away()
    let me = current
    while true
        switches += 1
        if timer_at.len > 0 and (ready_head >= ready.len or switches % 64 == 0)
            fire_timers()
        end
        if pending_io > 0 and switches % 64 == 0
            poll_io(0)
        end
        if ready_head < ready.len
            break
        end
        if timer_at.len == 0 and pending_io == 0
            fatal("all tasks are asleep - deadlock!")
        end
        wait_events()
    end
    let next = ready[ready_head]
    ready_head += 1
    if ready_head == ready.len
        ready.clear()
        ready_head = 0
    end
    if next == me
        return
    end
    current = next
    unsafe
        SwitchToFiber(tasks[next].fiber)
    end
end

// Waits until another task (or a timer) calls `wake` for this task.
func park()
    tasks[current].waiting = true
    switch_away()
end

// Makes a parked task ready. Waking a task that is not parked does nothing,
// so a stale registration can never run a task twice.
func wake(id: int)
    if id < tasks.len and tasks[id].waiting
        tasks[id].waiting = false
        ready.add(id)
    end
end

// Entry point of every spawned fiber. Must never return.
func fiber_main(id: usize)
    let me = int(id)
    // No local may own heap values here: this function never returns,
    // so nothing it holds would ever be released.
    tasks[me].action()
    tasks[me].action = nil
    tasks[me].done = true
    finished.add(me)
    switch_away()
end

func start(action: func())
    init()
    reap()
    var id = 0
    if free_ids.len > 0
        id = free_ids.take()
        tasks[id].action = action
        tasks[id].done = false
        tasks[id].waiting = false
    else
        id = tasks.len
        tasks.add(Task{ action: action })
    end
    var fiber: usize = 0
    unsafe
        fiber = CreateFiber(0, fiber_main, usize(id))
    end
    tasks[id].fiber = fiber
    ready.add(id)
end

// Lets other tasks run; the caller continues later.
func yield()
    init()
    ready.add(current)
    switch_away()
end

func chan_new() -> Chan
    init()
    return Chan{}
end

func wake_one(ref ch: Chan)
    if ch.whead < ch.waiting.len
        wake(ch.waiting[ch.whead])
        ch.whead += 1
        if ch.whead == ch.waiting.len
            ch.waiting.clear()
            ch.whead = 0
        end
    end
end

func chan_send(ref ch: Chan, word: int)
    if ch.closed
        fatal("send on a closed channel")
    end
    ch.items.add(word)
    wake_one(ref ch)
end

func chan_recv(ref ch: Chan) -> int
    init()
    while true
        if ch.head < ch.items.len
            let v = ch.items[ch.head]
            ch.head += 1
            if ch.head == ch.items.len
                ch.items.clear()
                ch.head = 0
            end
            return v
        end
        if ch.closed
            return 0
        end
        ch.waiting.add(current)
        park()
    end
    return 0
end

func chan_close(ref ch: Chan)
    ch.closed = true
    while ch.whead < ch.waiting.len
        wake_one(ref ch)
    end
end
