// =====================================================================
// Zila Lang standard library: text
//
//     use text
//     let words = text.split("a,b,c", ",")
//
// A text is immutable UTF-8: `len` counts bytes, a `char` is one Unicode code point, `for c in s`
// walks the characters and `s.slice(a, b)` cuts by byte positions (aborting inside a character).
// Searching, splitting, trimming and replacing compare whole byte sequences, so they are correct
// for UTF-8. `upper` and `lower` change the case of ASCII, Latin, Greek, Cyrillic and Armenian letters;
// `reverse` and the padding functions work on characters.
// =====================================================================

package text

use float
use errors

// ---- searching ----

// The byte position of the first `part` at or after `from`, or -1.
#[no_alloc]
pub func index_from(s: text, part: text, from: int) -> int
    let n = s.len
    let m = part.len
    var i = from
    if i < 0
        i = 0
    end
    while i + m <= n
        var j = 0
        while j < m and s.byte(i + j) == part.byte(j)
            j += 1
        end
        if j == m
            return i
        end
        i += 1
    end
    return -1
end

// The byte position of the first `part` in `s`, or -1.
#[no_alloc]
pub func index_of(s: text, part: text) -> int
    return index_from(s, part, 0)
end

#[no_alloc]
pub func contains(s: text, part: text) -> bool
    return index_from(s, part, 0) >= 0
end

pub func starts_with(s: text, prefix: text) -> bool
    return s.len >= prefix.len and s.slice(0, prefix.len) == prefix
end

pub func ends_with(s: text, suffix: text) -> bool
    return s.len >= suffix.len and s.slice(s.len - suffix.len, s.len) == suffix
end

// -1, 0 or 1: how `a` orders against `b`, comparing byte by byte (shorter first on a tie).
#[no_alloc]
pub func compare(a: text, b: text) -> int
    var i = 0
    while i < a.len and i < b.len
        if a.byte(i) < b.byte(i)
            return -1
        end
        if a.byte(i) > b.byte(i)
            return 1
        end
        i += 1
    end
    if a.len < b.len
        return -1
    end
    if a.len > b.len
        return 1
    end
    return 0
end

// ---- building ----

// All the parts one after another. Joins them in pairs, so the cost stays
// proportional to (total bytes) * log(parts) however many parts there are.
func concat_all(parts: []text) -> text
    if parts.len == 0
        return ""
    end
    var cur = parts
    while cur.len > 1
        let next: []text = []
        var i = 0
        while i + 1 < cur.len
            next.add(cur[i] + cur[i + 1])
            i += 2
        end
        if i < cur.len
            next.add(cur[i])
        end
        cur = next
    end
    return cur[0]
end

// The pieces between the occurrences of `sep`, empty pieces included.
pub func split(s: text, sep: text) -> []text
    if sep.len == 0
        abort("split needs a separator")
    end
    let out: []text = []
    var start = 0
    var at = index_from(s, sep, 0)
    while at >= 0
        out.add(s.slice(start, at))
        start = at + sep.len
        at = index_from(s, sep, start)
    end
    out.add(s.slice(start, s.len))
    return out
end

// The parts with `sep` between them.
pub func join(parts: []text, sep: text) -> text
    let all: []text = []
    for i in 0..parts.len
        if i > 0
            all.add(sep)
        end
        all.add(parts[i])
    end
    return concat_all(all)
end

// The lines of `s`: split at a newline, a trailing carriage return removed, no empty last line after a final newline.
pub func lines(s: text) -> []text
    let out: []text = []
    if s.len == 0
        return out
    end
    let pieces = split(s, "\n")
    var count = pieces.len
    if pieces[count - 1].len == 0
        count -= 1
    end
    for i in 0..count
        let p = pieces[i]
        if p.len > 0 and p.byte(p.len - 1) == 13
            out.add(p.slice(0, p.len - 1))
        else
            out.add(p)
        end
    end
    return out
end

// `s` n times.
pub func repeat(s: text, n: int) -> text
    let parts: []text = []
    for i in 0..n
        parts.add(s)
    end
    return concat_all(parts)
end

// Every non-overlapping `from` in `s` replaced by `to`, scanning left to right.
pub func replace(s: text, from: text, to: text) -> text
    if from.len == 0
        return s
    end
    let parts: []text = []
    var start = 0
    var at = index_from(s, from, 0)
    while at >= 0
        parts.add(s.slice(start, at))
        parts.add(to)
        start = at + from.len
        at = index_from(s, from, start)
    end
    parts.add(s.slice(start, s.len))
    return concat_all(parts)
end

// ---- trimming and padding ----

#[no_alloc]
pub func is_space(b: int) -> bool
    return b == 32 or b == 9 or b == 10 or b == 13
end

pub func trim_start(s: text) -> text
    var i = 0
    while i < s.len and is_space(int(s.byte(i)))
        i += 1
    end
    return s.slice(i, s.len)
end

pub func trim_end(s: text) -> text
    var n = s.len
    while n > 0 and is_space(int(s.byte(n - 1)))
        n -= 1
    end
    return s.slice(0, n)
end

// `s` without spaces, tabs, carriage returns and newlines at either end.
pub func trim(s: text) -> text
    return trim_end(trim_start(s))
end

func check_fill(fill: text)
    if fill.char_count() != 1
        abort("the padding fill must be exactly one character")
    end
end

// `fill` (one character) added in front until `s` is `width` characters long.
pub func pad_left(s: text, width: int, fill: text) -> text
    check_fill(fill)
    let n = s.char_count()
    if n >= width
        return s
    end
    return repeat(fill, width - n) + s
end

// `fill` (one character) added at the end until `s` is `width` characters long.
pub func pad_right(s: text, width: int, fill: text) -> text
    check_fill(fill)
    let n = s.char_count()
    if n >= width
        return s
    end
    return s + repeat(fill, width - n)
end

// ---- case and order ----

// Bytes from `lo` to `hi` shifted by `delta`; everything else stays as it is.
func shift_ascii(s: text, lo: int, hi: int, delta: int) -> text
    let parts: []text = []
    var run = 0
    for i in 0..s.len
        let b = int(s.byte(i))
        if b >= lo and b <= hi
            parts.add(s.slice(run, i))
            parts.add(char(b + delta).to_text())
            run = i + 1
        end
    end
    parts.add(s.slice(run, s.len))
    return concat_all(parts)
end

func is_ascii_text(s: text) -> bool
    for i in 0..s.len
        if int(s.byte(i)) >= 128
            return false
        end
    end
    return true
end

func upper_cp(cp: int) -> int
    // ASCII
    if cp >= 0x61 and cp <= 0x7A
        return cp - 32
    end
    // Fullwidth Latin
    if cp >= 0xFF41 and cp <= 0xFF5A
        return cp - 32
    end
    // Latin-1 Supplement
    if (cp >= 0xE0 and cp <= 0xF6) or (cp >= 0xF8 and cp <= 0xFE)
        return cp - 32
    end
    if cp == 0xFF
        return 0x0178
    end
    if cp == 0xB5
        return 0x039C
    end

    // Latin Extended-A
    if cp >= 0x0100 and cp <= 0x012F
        if (cp bitand 1) == 1
            return cp - 1
        end
        return cp
    end
    if cp == 0x0131
        return 0x0049
    end
    if cp >= 0x0132 and cp <= 0x0137
        if (cp bitand 1) == 1
            return cp - 1
        end
        return cp
    end
    if cp >= 0x0139 and cp <= 0x0148
        if (cp bitand 1) == 0
            return cp - 1
        end
        return cp
    end
    if cp >= 0x014A and cp <= 0x0177
        if (cp bitand 1) == 1
            return cp - 1
        end
        return cp
    end
    if cp >= 0x0179 and cp <= 0x017E
        if (cp bitand 1) == 0
            return cp - 1
        end
        return cp
    end
    if cp == 0x017F
        return 0x0053
    end

    // Greek
    if (cp >= 0x0370 and cp <= 0x0373) or cp == 0x0376 or cp == 0x0377
        if (cp bitand 1) == 1
            return cp - 1
        end
        return cp
    end
    if cp >= 0x037B and cp <= 0x037D
        return cp + 130
    end
    if cp == 0x03F3
        return 0x037F
    end
    if cp == 0x03AC
        return 0x0386
    end
    if cp >= 0x03AD and cp <= 0x03AF
        return cp - 37
    end
    if cp >= 0x03B1 and cp <= 0x03C1
        return cp - 32
    end
    if cp == 0x03C2
        return 0x03A3
    end
    if cp >= 0x03C3 and cp <= 0x03CB
        return cp - 32
    end
    if cp == 0x03CC
        return 0x038C
    end
    if cp >= 0x03CD and cp <= 0x03CE
        return cp - 63
    end
    if cp == 0x03D0
        return 0x0392
    end
    if cp == 0x03D1
        return 0x0398
    end
    if cp == 0x03D5
        return 0x03A6
    end
    if cp == 0x03D6
        return 0x03A0
    end
    if cp == 0x03D7
        return 0x03CF
    end
    if cp >= 0x03D8 and cp <= 0x03EF
        if (cp bitand 1) == 1
            return cp - 1
        end
        return cp
    end
    if cp == 0x03F0
        return 0x039A
    end
    if cp == 0x03F1
        return 0x03A1
    end
    if cp == 0x03F2
        return 0x03F9
    end
    if cp == 0x03F5
        return 0x0395
    end
    if cp == 0x03F8 or cp == 0x03FB
        return cp - 1
    end

    // Cyrillic
    if cp >= 0x0430 and cp <= 0x044F
        return cp - 32
    end
    if cp >= 0x0450 and cp <= 0x045F
        return cp - 80
    end
    if (cp >= 0x0460 and cp <= 0x0481) or (cp >= 0x048A and cp <= 0x04BF)
        if (cp bitand 1) == 1
            return cp - 1
        end
        return cp
    end
    if cp == 0x04CF
        return 0x04C0
    end
    if cp >= 0x04C1 and cp <= 0x04CE
        if (cp bitand 1) == 0
            return cp - 1
        end
        return cp
    end
    if cp >= 0x04D0 and cp <= 0x052F
        if (cp bitand 1) == 1
            return cp - 1
        end
        return cp
    end

    // Armenian
    if cp >= 0x0561 and cp <= 0x0586
        return cp - 48
    end

    // Latin Extended Additional
    if cp >= 0x1E00 and cp <= 0x1E95
        if (cp bitand 1) == 1
            return cp - 1
        end
        return cp
    end
    if cp == 0x1E9B
        return 0x1E60
    end
    if cp >= 0x1EA0 and cp <= 0x1EFF
        if (cp bitand 1) == 1
            return cp - 1
        end
        return cp
    end

    return cp
end

func lower_cp(cp: int) -> int
    // ASCII
    if cp >= 0x41 and cp <= 0x5A
        return cp + 32
    end
    // Fullwidth Latin
    if cp >= 0xFF21 and cp <= 0xFF3A
        return cp + 32
    end
    // Latin-1 Supplement
    if (cp >= 0xC0 and cp <= 0xD6) or (cp >= 0xD8 and cp <= 0xDE)
        return cp + 32
    end

    // Latin Extended-A
    if cp >= 0x0100 and cp <= 0x012F
        if (cp bitand 1) == 0
            return cp + 1
        end
        return cp
    end
    if cp == 0x0130
        return 0x0069
    end
    if cp >= 0x0132 and cp <= 0x0137
        if (cp bitand 1) == 0
            return cp + 1
        end
        return cp
    end
    if cp >= 0x0139 and cp <= 0x0148
        if (cp bitand 1) == 1
            return cp + 1
        end
        return cp
    end
    if cp >= 0x014A and cp <= 0x0177
        if (cp bitand 1) == 0
            return cp + 1
        end
        return cp
    end
    if cp == 0x0178
        return 0x00FF
    end
    if cp >= 0x0179 and cp <= 0x017E
        if (cp bitand 1) == 1
            return cp + 1
        end
        return cp
    end

    // Greek
    if (cp >= 0x0370 and cp <= 0x0373) or cp == 0x0376 or cp == 0x0377
        if (cp bitand 1) == 0
            return cp + 1
        end
        return cp
    end
    if cp == 0x037F
        return 0x03F3
    end
    if cp == 0x0386
        return 0x03AC
    end
    if cp >= 0x0388 and cp <= 0x038A
        return cp + 37
    end
    if cp == 0x038C
        return 0x03CC
    end
    if cp >= 0x038E and cp <= 0x038F
        return cp + 63
    end
    if (cp >= 0x0391 and cp <= 0x03A1) or (cp >= 0x03A3 and cp <= 0x03AB)
        return cp + 32
    end
    if cp == 0x03CF
        return 0x03D7
    end
    if cp >= 0x03D8 and cp <= 0x03EF
        if (cp bitand 1) == 0
            return cp + 1
        end
        return cp
    end
    if cp == 0x03F4
        return 0x03B8
    end
    if cp == 0x03F7 or cp == 0x03FA
        return cp + 1
    end
    if cp == 0x03F9
        return 0x03F2
    end
    if cp >= 0x03FD and cp <= 0x03FF
        return cp - 130
    end

    // Cyrillic
    if cp >= 0x0400 and cp <= 0x040F
        return cp + 80
    end
    if cp >= 0x0410 and cp <= 0x042F
        return cp + 32
    end
    if (cp >= 0x0460 and cp <= 0x0481) or (cp >= 0x048A and cp <= 0x04BF)
        if (cp bitand 1) == 0
            return cp + 1
        end
        return cp
    end
    if cp == 0x04C0
        return 0x04CF
    end
    if cp >= 0x04C1 and cp <= 0x04CE
        if (cp bitand 1) == 1
            return cp + 1
        end
        return cp
    end
    if cp >= 0x04D0 and cp <= 0x052F
        if (cp bitand 1) == 0
            return cp + 1
        end
        return cp
    end

    // Armenian
    if cp >= 0x0531 and cp <= 0x0556
        return cp + 48
    end

    // Latin Extended Additional
    if cp >= 0x1E00 and cp <= 0x1E95
        if (cp bitand 1) == 0
            return cp + 1
        end
        return cp
    end
    if cp == 0x1E9E
        return 0x00DF
    end
    if cp >= 0x1EA0 and cp <= 0x1EFF
        if (cp bitand 1) == 0
            return cp + 1
        end
        return cp
    end

    return cp
end

// Letters in capitals; characters with no single capital unchanged.
pub func upper(s: text) -> text
    if is_ascii_text(s)
        return shift_ascii(s, 97, 122, 0 - 32)
    end
    let parts: []text = []
    for c in s
        let cp = c.code
        let u = upper_cp(cp)
        if u == cp
            parts.add(c.to_text())
        else
            parts.add(char(u).to_text())
        end
    end
    return concat_all(parts)
end

// Letters in lower case; characters with no single lower case unchanged.
pub func lower(s: text) -> text
    if is_ascii_text(s)
        return shift_ascii(s, 65, 90, 32)
    end
    let parts: []text = []
    for c in s
        let cp = c.code
        let l = lower_cp(cp)
        if l == cp
            parts.add(c.to_text())
        else
            parts.add(char(l).to_text())
        end
    end
    return concat_all(parts)
end

// The characters of `s` in order.
pub func chars(s: text) -> []char
    let out: []char = []
    for c in s
        out.add(c)
    end
    return out
end

// The characters joined into a text: `from_chars(chars(s)) == s`.
pub func from_chars(cs: []char) -> text
    let parts: []text = []
    for c in cs
        parts.add(c.to_text())
    end
    return concat_all(parts)
end

// The characters in the opposite order: `reverse("ação")` is `oãça`.
pub func reverse(s: text) -> text
    let cs = chars(s)
    let parts: []text = []
    var i = cs.len - 1
    while i >= 0
        parts.add(cs[i].to_text())
        i -= 1
    end
    return concat_all(parts)
end

// The text of the UTF-8 bytes `b`, or an error `not valid UTF-8 at byte N` naming where the
// first bad sequence starts (a bad lead byte, a missing or wrong continuation byte, an overlong
// encoding, a surrogate or a value above U+10FFFF).
pub func from_bytes(b: []byte) -> text or error
    let parts: []text = []
    let n = b.len
    var i = 0
    while i < n
        let lead = int(b[i])
        var more = 0
        var cp = lead
        var least = 0
        if lead >= 194 and lead <= 223
            more = 1
            cp = lead - 192
            least = 128
        else if lead >= 224 and lead <= 239
            more = 2
            cp = lead - 224
            least = 2048
        else if lead >= 240 and lead <= 244
            more = 3
            cp = lead - 240
            least = 65536
        else if lead >= 128
            return error(errors.InvalidInput, "not valid UTF-8 at byte {i}")
        end
        if i + more >= n
            return error(errors.InvalidInput, "not valid UTF-8 at byte {i}")
        end
        for k in 1..more + 1
            let d = int(b[i + k])
            if d < 128 or d > 191
                return error(errors.InvalidInput, "not valid UTF-8 at byte {i}")
            end
            cp = cp * 64 + (d - 128)
        end
        if cp < least or cp > 1114111 or (cp >= 55296 and cp <= 57343)
            return error(errors.InvalidInput, "not valid UTF-8 at byte {i}")
        end
        parts.add(char(cp).to_text())
        i += more + 1
    end
    return concat_all(parts)
end

// ---- parsing ----

// The whole number written in `s`: optional sign, then decimal digits. It must fit an `int`
// (32 bits); `parse_long` takes up to 64 bits.
pub func parse_int(s: text) -> int or error
    let n = try parse_long(s)
    if n < -2147483648 or n > 2147483647
        return error(errors.InvalidInput, "not a whole number that fits an int: \"" + s + "\"")
    end
    return int(n)
end

// Like `parse_int` for a number up to 64 bits.
pub func parse_long(s: text) -> long or error
    let bad = "not a whole number: \"" + s + "\""
    var i = 0
    var neg = false
    if s.len > 0 and (s.byte(0) == 45 or s.byte(0) == 43)
        neg = s.byte(0) == 45
        i = 1
    end
    if i >= s.len
        return error(errors.InvalidInput, bad)
    end
    let least: long = 0 - 9223372036854775807 - 1
    var acc: long = 0
    while i < s.len
        let d = int(s.byte(i)) - 48
        if d < 0 or d > 9
            return error(errors.InvalidInput, bad)
        end
        // acc * 10 - d must not go below the smallest int (acc is kept negative)
        if acc < (least + d) / 10
            return error(errors.InvalidInput, bad)
        end
        acc = acc * 10 - d
        i += 1
    end
    if neg
        return acc
    end
    if acc == least
        return error(errors.InvalidInput, bad)
    end
    return 0 - acc
end

// ---- parsing numbers with a fraction ----

// A copy of a big number (see the float library for the representation).
func copy_big(a: []long) -> []long
    let out: []long = []
    for x in a
        out.add(x)
    end
    return out
end

// a = a + d, for 0 <= d < 1000000000
func add_small(ref a: []long, d: int)
    var carry: long = d
    var i = 0
    while carry > 0
        if i >= a.len
            a.add(0)
        end
        let t = a[i] + carry
        a[i] = t % 1000000000
        carry = t / 1000000000
        i += 1
    end
end

func big_pow10(n: int) -> []long
    let a = float.big_from(1)
    for i in 0..n
        float.b_mul(ref a, 10)
    end
    return a
end

// The float written in `s`: an optional sign, digits with an optional fraction and an optional
// exponent (`1.5`, `-2e3`, `.5`, `5.`), or `inf`, `-inf`, `NaN`. The result is the float nearest
// to the written value (ties go to the even one), so printing a float and parsing it back
// gives the same float.
pub func parse_float(s: text) -> float or error
    let bad = "not a number: \"" + s + "\""
    let least: long = 0 - 9223372036854775807 - 1
    var i = 0
    var neg = false
    if s.len > 0 and (s.byte(0) == 45 or s.byte(0) == 43)
        neg = s.byte(0) == 45
        i = 1
    end
    let word = s.slice(i, s.len)
    if word == "inf"
        if neg
            return __from_bits(0 - 4503599627370496)
        end
        return __from_bits(9218868437227405312)
    end
    if word == "NaN"
        return __from_bits(9221120237041090560)
    end

    // digits, with the position of the decimal point
    let digits: []int = []
    var seen_dot = false
    var any = false
    var frac = 0
    var j = i
    var more = true
    while j < s.len and more
        let c = int(s.byte(j))
        if c == 46
            if seen_dot
                return error(errors.InvalidInput, bad)
            end
            seen_dot = true
            j += 1
        else if c >= 48 and c <= 57
            any = true
            if digits.len > 0 or c != 48
                digits.add(c - 48)
            end
            if seen_dot
                frac += 1
            end
            j += 1
        else
            more = false
        end
    end
    if not any
        return error(errors.InvalidInput, bad)
    end
    var e10 = 0
    if j < s.len and (s.byte(j) == 101 or s.byte(j) == 69)
        j += 1
        var eneg = false
        if j < s.len and (s.byte(j) == 45 or s.byte(j) == 43)
            eneg = s.byte(j) == 45
            j += 1
        end
        if j >= s.len
            return error(errors.InvalidInput, bad)
        end
        while j < s.len
            let c = int(s.byte(j))
            if c < 48 or c > 57
                return error(errors.InvalidInput, bad)
            end
            if e10 < 100000
                e10 = e10 * 10 + (c - 48)
            end
            j += 1
        end
        if eneg
            e10 = 0 - e10
        end
    end
    if j != s.len
        return error(errors.InvalidInput, bad)
    end

    var signbit: long = 0
    if neg
        signbit = least
    end
    if digits.len == 0
        return __from_bits(signbit)
    end

    // value = digits * 10^exp10, between 10^(mag-1) and 10^mag
    let exp10 = e10 - frac
    let mag = digits.len + exp10
    if mag > 310
        return __from_bits(signbit bitor 9218868437227405312)
    end
    if mag < 0 - 325
        return __from_bits(signbit)
    end

    // value = num / den
    let num = float.big_from(0)
    for d in digits
        float.b_mul(ref num, 10)
        add_small(ref num, d)
    end
    var den = float.big_from(1)
    if exp10 >= 0
        var k10 = exp10
        while k10 > 0
            float.b_mul(ref num, 10)
            k10 -= 1
        end
    else
        den = big_pow10(0 - exp10)
    end

    // find k so that q = floor(value / 2^k) has 53 bits (fewer for the smallest numbers)
    var k = ((mag - 1) * 33219) / 10000 - 52
    if k < 0 - 1074
        k = 0 - 1074
    end
    var q: long = 0
    var rem = float.big_from(0)
    var d2 = float.big_from(1)
    var found = false
    while not found
        let n2 = copy_big(num)
        d2 = copy_big(den)
        if k < 0
            float.b_mul_pow2(ref n2, 0 - k)
        else
            float.b_mul_pow2(ref d2, k)
        end
        q = 0
        var bit = 54
        while bit >= 0
            let t = copy_big(d2)
            float.b_mul_pow2(ref t, bit)
            if float.b_cmp(n2, t) >= 0
                float.b_sub(ref n2, t)
                q += 1 << bit
            end
            bit -= 1
        end
        rem = n2
        if float.b_cmp(rem, d2) >= 0 or q >= 9007199254740992
            k += 1
        else if q < 4503599627370496 and k > 0 - 1074
            k -= 1
        else
            found = true
        end
    end

    // round to nearest, ties to even
    let c = float.b_cmp(float.b_add(rem, rem), d2)
    if c > 0 or (c == 0 and (q % 2) == 1)
        q += 1
        if q == 9007199254740992
            q = 4503599627370496
            k += 1
        end
    end
    if q >= 4503599627370496
        let expf = k + 1075
        if expf >= 2047
            return __from_bits(signbit bitor 9218868437227405312)
        end
        return __from_bits(signbit bitor (long(expf) << 52) bitor (q - 4503599627370496))
    end
    return __from_bits(signbit bitor q)
end
