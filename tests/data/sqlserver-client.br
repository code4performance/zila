package main

use db
use sqlserver

type Customer = record
    id: int
    name: text
end

func main() -> error
    let conn = try sqlserver.open("sqlserver://sa:Brasa_dev_Sql_1@127.0.0.1:@PORT@/shop?encrypt=off")
    let rows = try db.query(Customer, conn, "select id, name from customers where id <= 3 order by id")
    for r in rows
        print(r.id, r.name)
    end
    let n = try db.one(text, conn, "select N'ü' + cast(@p1 as nvarchar(10)) + cast(12.50 as nvarchar(10)) + cast(newid() as nvarchar(40)) + cast(sysutcdatetime() as nvarchar(40))", db.int(7))
    print(n.len > 20)
    match conn.exec("insert into customers(id, name) values (1, N'dup')")
        ok(k) -> print("unexpected success")
        err(e) -> print(e.kind.name + ": " + e.message)
    end
    return
end
